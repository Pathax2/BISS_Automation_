        jsClick(getLocator(pIdentifyBy, pObjectName), pObjectName);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : executeScript
    // Description   : Selenium-compatible JavaScript executor. Paste the script exactly as it was written for
    //                 JavascriptExecutor: 'arguments[0]', 'arguments[1]' ... and 'return' work unchanged.
    //                 Locator arguments are turned into DOM elements (like WebElement arguments in Selenium);
    //                 strings, numbers, booleans, lists and maps are passed as plain values.
    //
    //                 Selenium                                                              Playwright
    //                 js.executeScript("arguments[0].click();", element)                -> executeScript("arguments[0].click();", locator)
    //                 js.executeScript("arguments[0].scrollIntoView(true);", element)   -> executeScript("arguments[0].scrollIntoView(true);", locator)
    //                 js.executeScript("arguments[0].value=arguments[1];", element, v)  -> executeScript("arguments[0].value=arguments[1];", locator, v)
    //                 js.executeScript("return document.readyState;")                  -> executeScript("return document.readyState;")
    //
    // Parameters    : pScript (String)    - JavaScript function body
    //                 pArgs   (Object...) - Locator, ElementHandle, String, Number, Boolean, List or Map values
    // Returns       : Object - the value returned by the script (String, Number, Boolean, List, Map or null)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Object executeScript(String pScript, Object... pArgs)
    {
        if (pScript == null || pScript.trim().isEmpty())
        {
            throw new RuntimeException("executeScript: script cannot be blank.");
        }

        Page                iPage    = requirePage();
        List<Object>        iArgs    = new ArrayList<>();
        List<ElementHandle> iHandles = new ArrayList<>();

        try
        {
            if (pArgs != null)
            {
                for (Object iArg : pArgs)
                {
                    if (iArg instanceof Locator)
                    {
                        ElementHandle iHandle = ((Locator) iArg).elementHandle();
                        iHandles.add(iHandle);
                        iArgs.add(iHandle);
                    }
                    else
                    {
                        iArgs.add(iArg);
                    }
                }
            }

            return iPage.evaluate(JS_EXECUTE_SCRIPT_WRAPPER.replace("__SCRIPT__", pScript), iArgs);
        }
        finally
        {
            for (ElementHandle iHandle : iHandles)
            {
                try { iHandle.dispose(); } catch (Exception iIgnored) { }
            }
        }
    }


