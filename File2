    // ***************************************************************************************************************************************************************************************
    // Function Name : nextSameAgentPair
    // Description   : Picks two different, unused herds of the same agent (transferor + transferee), records them in
    //                 the used-herds file, logs them and makes them the current pair.
    // Parameters    : pAgent   (String) - agent login, e.g. "aga6077"
    //                 pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextSameAgentPair(String pAgent, String pPurpose)
    {
        if (pAgent == null || pAgent.isBlank())
        {
            throw new IllegalStateException(LOG_PREFIX + "No agent is logged in, so there is no agent to take herds from. "
                    + "The ENTS login step must run before the transfer is created.");
        }

        String     iAgent     = pAgent.trim();
        List<Herd> iPool      = agentPool(iAgent);
        Set<String> iUsed     = usedHerds();
        List<Herd> iAvailable = new ArrayList<>();

        for (Herd iHerd : iPool)
        {
            if (!iUsed.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }

        if (iAvailable.size() < 2)
        {
            throw new IllegalStateException(LOG_PREFIX + "Agent Login query for " + iAgent + " has " + iAvailable.size()
                    + " unused herd(s) left out of " + iPool.size() + ", and a transfer needs 2. "
                    + "Clear or trim " + usedFile() + ", raise ents.pool.size, or use another agent.");
        }

        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        Herd iTransferor = iAvailable.get(0);
        Herd iTransferee = iAvailable.get(1);

        markUsed("transferor", iTransferor.herdNumber, iAgent, pPurpose);
        markUsed("transferee", iTransferee.herdNumber, iAgent, pPurpose);

        iCurrentPair = new TransferPair(iAgent, iTransferor, iTransferee);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] | Agent=" + iAgent
                + " | Transferor=" + iTransferor + " | Transferee=" + iTransferee
                + " | " + (iAvailable.size() - 2) + " unused herd(s) left in the pool");

        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : nextNoEntitlementPair
    // Description   : Negative-case version of nextSameAgentPair (TC_02_ENTS Section 2). Both herds belong to the same
    //                 agent and are picked at random:
    //                   transferor - an unused herd of the agent with NO entitlements in the scheme year
    //                                (query "ENTS Agent herds without entitlements")
    //                   transferee - an unused herd from the agent's usual Agent Login pool
    //                 Both are recorded in the used-herds file and become the current pair, so {transferor.herd},
    //                 {transferee.herd} and {transferee.name} work as usual.
    // Parameters    : pAgent   (String) - agent login, e.g. "aga6077"
    //                 pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 23-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextNoEntitlementPair(String pAgent, String pPurpose)
    {
        if (pAgent == null || pAgent.isBlank())
        {
            throw new IllegalStateException(LOG_PREFIX + "No agent is logged in, so there is no agent to take herds from. "
                    + "The ENTS login step must run before the transfer search.");
        }

        String      iAgent = pAgent.trim();
        Set<String> iUsed  = usedHerds();

        List<Herd> iNoEnts    = noEntitlementPool(iAgent);
        List<Herd> iAvailable = new ArrayList<>();
        for (Herd iHerd : iNoEnts)
        {
            if (!iUsed.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }

        if (iAvailable.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "\"ENTS Agent herds without entitlements\" for " + iAgent
                    + " has no unused herd left out of " + iNoEnts.size() + ". "
                    + "Clear or trim " + usedFile() + ", raise ents.pool.size, or use another agent.");
        }

        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        Herd iTransferor = iAvailable.get(0);

        Set<String> iUsedPlus = new HashSet<>(iUsed);
        iUsedPlus.add(iTransferor.herdNumber);
        Herd iTransferee = pickUnused(iAgent, iUsedPlus, "transferee");

        markUsed("transferor-no-ents", iTransferor.herdNumber, iAgent, pPurpose);
        markUsed("transferee",         iTransferee.herdNumber, iAgent, pPurpose);

        iCurrentPair = new TransferPair(iAgent, iTransferor, iTransferee);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] (no entitlements) | Agent=" + iAgent
                + " | Transferor=" + iTransferor + " | Transferee=" + iTransferee
                + " | " + (iAvailable.size() - 1) + " unused no-entitlement herd(s) left");

        return iCurrentPair;
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : nextCrossAgentPair
    // Description   : Cross-agent version of nextSameAgentPair (TC_04_ENTS). The two herds come from two agents:
    //                   transferor - an unused herd from the Agent Login pool of pTransferorAgent (the logged-in agent)
    //                   transferee - an unused herd from the Agent Login pool of pTransfereeAgent
    //                 Both pools are fetched once per run and cached. Both herds are recorded in the used-herds file
    //                 (each with its own agent) and become the current pair. {transferee.agent} returns pTransfereeAgent,
    //                 so the login-swap step always logs in as the agent the transferee herd was taken from.
    //                 When both logins are the same, this is a same-agent pick (nextSameAgentPair).
    // Parameters    : pTransferorAgent (String) - logged-in agent, e.g. "aga6060"
    //                 pTransfereeAgent (String) - agent of the transferee, e.g. "aga6325"
    //                 pPurpose         (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 29-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextCrossAgentPair(String pTransferorAgent, String pTransfereeAgent, String pPurpose)
    {
        if (pTransferorAgent == null || pTransferorAgent.isBlank())
        {
            throw new IllegalStateException(LOG_PREFIX + "No agent is logged in, so there is no agent to take the transferor herd from. "
                    + "The ENTS login step must run before the transfer is created.");
        }
        if (pTransfereeAgent == null || pTransfereeAgent.isBlank())
        {
            throw new IllegalArgumentException(LOG_PREFIX + "The transfereeAgent row is empty - give the transferee agent login.");
        }

        String iOrAgent = pTransferorAgent.trim();
        String iEeAgent = resolveAgent(pTransfereeAgent);   // {auto.agent} -> the agent with the most herds
        if (iOrAgent.equalsIgnoreCase(iEeAgent))
        {
            return nextSameAgentPair(iOrAgent, pPurpose);
        }

        Set<String> iUsed       = usedHerds();
        Herd        iTransferor = pickUnused(iOrAgent, iUsed, "transferor");

        Set<String> iUsedPlus = new HashSet<>(iUsed);
        iUsedPlus.add(iTransferor.herdNumber);
        Herd iTransferee = pickUnused(iEeAgent, iUsedPlus, "transferee");

        markUsed("transferor", iTransferor.herdNumber, iOrAgent, pPurpose);
        markUsed("transferee", iTransferee.herdNumber, iEeAgent, pPurpose);

        iCurrentPair = new TransferPair(iOrAgent, iTransferor, iTransferee, iEeAgent);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] (cross-agent) | Transferor agent=" + iOrAgent
                + " | Transferor=" + iTransferor + " | Transferee agent=" + iEeAgent + " | Transferee=" + iTransferee);

        return iCurrentPair;
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : nextAgentToIndividualPair
    // Description   : Agent-to-individual version of nextSameAgentPair (TC_05_ENTS / TC_06_ENTS):
    //                   transferor - an unused herd from the Agent Login pool of pAgent (the logged-in agent)
    //                   transferee - an unused herd from the Individual Login query, i.e. a herd whose holder logs in
    //                                with their own online login (no agent needed to accept)
    //                 Both are recorded in the used-herds file (the transferee with the individual's login) and become
    //                 the current pair. {transferee.login} returns the individual's login for the login-swap step.
    // Parameters    : pAgent   (String) - logged-in agent, e.g. "agr9197"
    //                 pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextAgentToIndividualPair(String pAgent, String pPurpose)
    {
        if (pAgent == null || pAgent.isBlank())
        {
            throw new IllegalStateException(LOG_PREFIX + "No agent is logged in, so there is no agent to take the transferor herd from. "
                    + "The ENTS login step must run before the transfer is created.");
        }

        String      iAgent      = pAgent.trim();
        Set<String> iUsed       = usedHerds();
        Herd        iTransferor = pickUnused(iAgent, iUsed, "transferor");

        Set<String> iUsedPlus = new HashSet<>(iUsed);
        iUsedPlus.add(iTransferor.herdNumber);

        Herd   iTransferee = pickUnusedIndividual(iUsedPlus, "transferee");
        String iLogin      = INDIVIDUAL_LOGINS.get(iTransferee.herdNumber);

        markUsed("transferor",            iTransferor.herdNumber, iAgent, pPurpose);
        markUsed("transferee-individual", iTransferee.herdNumber, iLogin, pPurpose);

        iCurrentPair = new TransferPair(iAgent, iTransferor, iTransferee, iLogin);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] (agent to individual) | Agent=" + iAgent
                + " | Transferor=" + iTransferor + " | Transferee=" + iTransferee + " | Individual login=" + iLogin);

        return iCurrentPair;
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : nextIndividualTransfereeForFixedTransferor
    // Description   : Keeps a transferor herd typed in the feature file (TC_12_ENTS: the ETF partner's own herd C2057024)
    //                 and picks only the transferee: an unused herd from the Individual Login query, whose own login
    //                 then accepts ({transferee.login}). The transferor is NOT written to the used-herds file, because
    //                 it is meant to be reused. Same idea as nextTransfereeForFixedTransferor, with an individual
    //                 transferee instead of an agent's client herd.
    // Parameters    : pTransferorHerd (String) - pinned transferor herd | pPurpose (String) - e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 02-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextIndividualTransfereeForFixedTransferor(String pTransferorHerd, String pPurpose)
    {
        if (pTransferorHerd == null || pTransferorHerd.isBlank())
        {
            throw new IllegalArgumentException(LOG_PREFIX + "The transferorHerd cell is empty - give a herd number or {transferor.herd}.");
        }

        Set<String> iUsedPlus = new HashSet<>(usedHerds());
        iUsedPlus.add(pTransferorHerd.trim());

        Herd   iTransferor = new Herd(pTransferorHerd.trim(), "", "");
