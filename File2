                + iCurrentPair.transferor + " (" + iCurrentPair.agent + ") | Transferee=" + iTransferee + " (" + iLogin + ")");
        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : replaceTransferee
    // Description   : The Transferee Search dialog said "No transferee matches were found" for the current transferee
    //                 (02-10-2026, TC_08_ENTS: C1400337 "Joanna Phelan" in aga6077's pool). The dialog needs the exact
    //                 portal name, and when the transferee is managed by ANOTHER agent (or is an individual) the portal
    //                 name cannot be read first, so the DB name is typed and can differ.
    //                 This keeps the transferor and replaces only the transferee:
    //                   1. the old transferee is marked BAD in the vault with pReason (never handed out again)
    //                   2. a new unused transferee is picked from the SAME source - the Individual Login pool when the
    //                      transferee accepts with their own login, otherwise the Agent Login pool of the same agent
    //                   3. the pair keeps its transferor and its accepting agent
    //                 The "bad herds in a row" refill is NOT triggered: a name mismatch says nothing about a stale pool.
    // Parameters    : pReason  (String) - why the old transferee is dropped, written to the vault and the used-herds file
    //                 pPurpose (String) - transfer type, written for the new transferee
    // Returns       : TransferPair - the pair with the new transferee
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 02-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair replaceTransferee(String pReason, String pPurpose)
    {
        if (iCurrentPair == null || iCurrentPair.transferee == null)
        {
            throw new IllegalStateException(LOG_PREFIX + "replaceTransferee needs a current pair with a transferee.");
        }

        String  iOldHerd    = iCurrentPair.transferee.herdNumber;
        String  iEeAgent    = iCurrentPair.transfereeAgent;
        boolean iIndividual = INDIVIDUAL_LOGINS.containsKey(iOldHerd) && isIndividualLogin(iEeAgent);

        // 1. Drop the old transferee (iLastPurpose is kept: a lease must still be recognised as a lease)
        String iKeepPurpose = iLastPurpose;
        markUsed("not-found", iOldHerd, iEeAgent, pReason);
        iLastPurpose = iKeepPurpose;
        if (TestDataVault.isEnabled())
        {
            try { TestDataVault.markBad(iOldHerd, pReason); }
            catch (Exception e) { CommonFunctions.log.warning(LOG_PREFIX + "Vault update failed for " + iOldHerd + ": " + e.getMessage()); }
        }
        CommonFunctions.log.warning(LOG_PREFIX + "Transferee " + iOldHerd + " dropped: " + pReason);

        // 2. Pick a new one from the same source
        Set<String> iUsedPlus = new HashSet<>(usedHerds());
        iUsedPlus.add(iCurrentPair.transferor.herdNumber);
        iUsedPlus.add(iOldHerd);

        Herd   iNewTransferee;
        String iAccepter;
        if (iIndividual)
        {
            iNewTransferee = pickUnusedIndividual(iUsedPlus, "transferee");
            iAccepter      = INDIVIDUAL_LOGINS.get(iNewTransferee.herdNumber);
            markUsed("transferee-individual", iNewTransferee.herdNumber, iAccepter, pPurpose);
        }
        else
        {
            iNewTransferee = pickUnused(iEeAgent, iUsedPlus, "transferee");
            iAccepter      = iEeAgent;
            markUsed("transferee", iNewTransferee.herdNumber, iAccepter, pPurpose);
        }

        // 3. Same transferor, same creating login, new transferee
        iCurrentPair = new TransferPair(iCurrentPair.agent, iCurrentPair.transferor, iNewTransferee, iAccepter);

        CommonFunctions.log.info(LOG_PREFIX + "Transferee replaced for [" + pPurpose + "] | Transferor=" + iCurrentPair.transferor
                + " | old transferee=" + iOldHerd + " | new transferee=" + iNewTransferee + " | accepted by " + iAccepter);
        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : nextTransfereeForFixedTransferor
    // Description   : Keeps a transferor herd typed in the feature file (TC_11_ENTS: the ETF partner's own herd) and picks
    //                 only the transferee, an unused herd from the Agent Login pool of pTransfereeAgent. The transferor
    //                 is NOT written to the used-herds file, because it is meant to be reused.
    // Parameters    : pTransferorHerd  (String) - pinned transferor herd, e.g. "C2057024"
    //                 pTransfereeAgent (String) - agent who manages the transferee, e.g. "aga6581"
    //                 pPurpose         (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextTransfereeForFixedTransferor(String pTransferorHerd, String pTransfereeAgent, String pPurpose)
    {
        if (pTransfereeAgent == null || pTransfereeAgent.isBlank())
        {
            throw new IllegalArgumentException(LOG_PREFIX + "The transfereeAgent row is empty - give the login of the agent who manages the transferee.");
        }

        String      iAgent    = resolveAgent(pTransfereeAgent);   // {auto.agent} -> the agent with the most herds
        Set<String> iUsedPlus = new HashSet<>(usedHerds());
        iUsedPlus.add(pTransferorHerd.trim());

        Herd iTransferor = new Herd(pTransferorHerd.trim(), "", "");
        Herd iTransferee = pickUnused(iAgent, iUsedPlus, "transferee");
        markUsed("transferee", iTransferee.herdNumber, iAgent, pPurpose);

        iCurrentPair = new TransferPair(iLoggedInUser, iTransferor, iTransferee, iAgent);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] (pinned transferor) | Transferor=" + pTransferorHerd.trim()
                + " (" + iLoggedInUser + ") | Transferee agent=" + iAgent + " | Transferee=" + iTransferee);
        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : isIndividualLogin
    // Description   : True when the login was handed out by the Individual Login query in this run
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized boolean isIndividualLogin(String pLogin)
    {
        return pLogin != null && INDIVIDUAL_LOGINS.containsValue(pLogin.trim());
    }

    // The current pair must be a first half (individual transferor, no transferee yet)
    private static void requireHalfPair(String pCaller)
    {
        if (iCurrentPair == null || iCurrentPair.transferee != null)
        {
            throw new IllegalStateException(LOG_PREFIX + pCaller + " needs an individual transferor picked first. "
                    + "The login step must use {transferor.login} so nextIndividualTransferor runs before the transfer is created.");
        }
    }

    // One random herd of the Individual Login pool that is not in pExclude
    private static Herd pickUnusedIndividual(Set<String> pExclude, String pRole)
    {
        List<Herd> iPool      = individualPool();
        List<Herd> iAvailable = new ArrayList<>();
        for (Herd iHerd : iPool)
        {
            if (!pExclude.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }
        if (iAvailable.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "Individual Login query has no unused herd left out of " + iPool.size()
                    + ", and one is needed as the " + pRole + ". Clear or trim " + usedFile()
                    + ", or raise ents.individual.pool.size.");
        }
        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        return iAvailable.get(0);
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : pickUnused
    // Description   : One random herd of an agent that is not in pExclude. Throws with a clear message when the pool
    //                 has no unused herd left.
    // Parameters    : pAgent (String) - agent login | pExclude (Set) - herds already used | pRole (String) - for the message
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Herd pickUnused(String pAgent, Set<String> pExclude, String pRole)
    {
        List<Herd> iPool      = agentPool(pAgent);
        List<Herd> iAvailable = new ArrayList<>();
        for (Herd iHerd : iPool)
        {
            if (!pExclude.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }

        if (iAvailable.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "Agent Login query for " + pAgent + " has no unused herd left out of "
                    + iPool.size() + ", and one is needed as the " + pRole + ". "
                    + "Clear or trim " + usedFile() + ", raise ents.pool.size, or use another agent.");
        }

        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        return iAvailable.get(0);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : usePortalName
    // Description   : Replaces the name of a herd of the current pair with the name shown in the portal.
    //                 The transferee search only matches the exact portal name, and the DB name can differ from it
    //                 (e.g. "Martin Starr" in the DB, "Martin Starr Jnr" in the portal). After this call,
    //                 {transferor.name} / {transferee.name} return the portal name.
    // Parameters    : pHerd (String) - herd number of the current pair | pPortalName (String) - name from the Name column
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void usePortalName(String pHerd, String pPortalName)
    {
        if (iCurrentPair == null || pHerd == null || pPortalName == null || pPortalName.isBlank()) return;

        String iName = pPortalName.trim().replaceAll("\\s+", " ");
        Herd   iOr   = iCurrentPair.transferor;
        Herd   iEe   = iCurrentPair.transferee;

        if (iOr.herdNumber.equalsIgnoreCase(pHerd.trim()) && !iName.equals(iOr.name))
        {
            CommonFunctions.log.info(LOG_PREFIX + "Transferor " + iOr.herdNumber + " name: DB='" + iOr.name + "' portal='" + iName + "' - using the portal name");
            iOr = new Herd(iOr.herdNumber, iName, iOr.address);
        }
        else if (iEe != null && iEe.herdNumber.equalsIgnoreCase(pHerd.trim()) && !iName.equals(iEe.name))
        {
            CommonFunctions.log.info(LOG_PREFIX + "Transferee " + iEe.herdNumber + " name: DB='" + iEe.name + "' portal='" + iName + "' - using the portal name");
            iEe = new Herd(iEe.herdNumber, iName, iEe.address);
        }
        else
        {
            return;
        }
        iCurrentPair = new TransferPair(iCurrentPair.agent, iOr, iEe, iCurrentPair.transfereeAgent);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : agentPool
    // Description   : Rows of the Agent Login query for one agent, fetched once per run and cached
    // Parameters    : pAgent (String) - agent login
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static List<Herd> agentPool(String pAgent)
    {
        String     iKey    = pAgent.toLowerCase(Locale.ROOT);
        List<Herd> iCached = AGENT_POOLS.get(iKey);
        if (iCached != null) return iCached;

        List<Herd> iFromVault = vaultPool(TestDataVault.POOL_ENTS_AGENT, pAgent, "Agent Login");
        if (iFromVault == null) iFromVault = vaultPool(TestDataVault.POOL_ENTS_ETF, pAgent, "ETF partner");
        if (iFromVault != null)
        {
            AGENT_POOLS.put(iKey, iFromVault);
            return iFromVault;
        }

        int    iLimit = ConfigManager.getInt("ents.pool.size", 200);
        String iYear  = ConfigManager.getOrDefault("ents.scheme.year", "").trim();
        String iType  = ConfigManager.getOrDefault("ents.cust.type", "").trim();
        String iTwo   = ConfigManager.getBool("ents.name.two.words", true) ? "Y" : "";
        long   iStart = System.currentTimeMillis();

        CommonFunctions.log.info(LOG_PREFIX + "Running Agent Login query for " + pAgent + " (up to " + iLimit + " rows"
                + (iYear.isEmpty() ? ", all scheme years" : ", scheme year " + iYear)
                + (iType.isEmpty() ? ", all customer types" : ", cust_type " + iType)
                + (iTwo.isEmpty() ? "" : ", two-word names only") + ")...");
        DBRouter.runDB("ENTS", "ENTS Agent Login herds", pAgent, String.valueOf(iLimit), iYear, iType, iTwo);

        List<Herd> iPool = new ArrayList<>();
        for (Map<String, Object> iRow : DBRouter.getRows())
        {
            String iHerd = text(iRow, "HERD_NUMBER");
            if (!iHerd.isEmpty())
            {
                iPool.add(new Herd(iHerd, text(iRow, "HERD_NAME"), text(iRow, "ADDRESSLINE1")));
            }
        }

        CommonFunctions.log.info(LOG_PREFIX + "Agent Login query for " + pAgent + " returned " + iPool.size()
                + " herd(s) in " + (System.currentTimeMillis() - iStart) / 1000 + " s");

        String iVaultPool = TestDataVault.POOL_ENTS_AGENT;
        if (iPool.isEmpty())
        {
            // ETF partners (agr15512, agr15678) are not in herd_agt - their herds come via tden_herd_etf_link
            CommonFunctions.log.info(LOG_PREFIX + pAgent + " is not in herd_agt - running the ETF partner query...");
            DBRouter.runDB("ENTS", "ENTS ETF partner herds", pAgent, String.valueOf(iLimit), iYear, iTwo);
            for (Map<String, Object> iRow : DBRouter.getRows())
            {
                String iHerd = text(iRow, "HERD_NUMBER");
                if (!iHerd.isEmpty()) iPool.add(new Herd(iHerd, text(iRow, "HERD_NAME"), text(iRow, "ADDRESSLINE1")));
            }
            iVaultPool = TestDataVault.POOL_ENTS_ETF;
            CommonFunctions.log.info(LOG_PREFIX + "ETF partner query for " + pAgent + " returned " + iPool.size() + " herd(s)");
        }

        if (iPool.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "Neither the Agent Login query nor the ETF partner query returned herds for "
                    + pAgent + ". Check the login, or run the queries in SQL Developer on CENTEST_ENTS_DATA.");
        }

        AGENT_POOLS.put(iKey, iPool);
        storeInVault(iVaultPool, pAgent, iPool, pAgent);
        return iPool;
    }

