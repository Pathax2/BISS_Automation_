    private static String readUserAgentVersion(Page pPage)
    {
        try
        {
            String iAgent = String.valueOf(pPage.evaluate("() => navigator.userAgent"));
            java.util.regex.Matcher iMatch = java.util.regex.Pattern.compile("(?:Chrome|Edg|Firefox|Version)/([0-9.]+)").matcher(iAgent);
            return iMatch.find() ? iMatch.group(1) : "-";
        }
        catch (Exception iException)
        {
            return "-";
        }
    }

    private static void deleteProfileQuietly()
    {
        Path iProfile = iProfileHolder.get();
        if (iProfile == null) { return; }

        try (java.util.stream.Stream<Path> iWalk = Files.walk(iProfile))
        {
            iWalk.sorted(Comparator.reverseOrder()).forEach(iPath -> iPath.toFile().delete());
        }
        catch (Exception iIgnored)
        {
            // Chrome can hold a file for a moment after closing on Windows - the OS temp cleaner removes the rest
        }
    }

    private static String traceMode()
    {
        return ConfigManager.getOrDefault("trace.mode", "retain-on-failure").trim().toLowerCase(Locale.ROOT);
    }

    private static void startTracingIfEnabled(BrowserContext pContext)
    {
        if ("off".equals(traceMode()))
        {
            iTracingHolder.set(Boolean.FALSE);
            return;
        }

        try
        {
            // Screenshots inside a trace record a screencast of the whole run, which costs real time on every action.
            // Snapshots (the DOM before/after each action) are what makes a trace useful and are far cheaper.
            boolean iTraceShots = ConfigManager.getBool("trace.screenshots", false);

            pContext.tracing().start(new Tracing.StartOptions()
                    .setScreenshots(iTraceShots)
                    .setSnapshots(ConfigManager.getBool("trace.snapshots", true))
                    .setSources(false));
            iTracingHolder.set(Boolean.TRUE);

            // One chunk per test case: with browser.reuse the context lives for the whole run, but each test case
            // still gets its own trace zip
            pContext.tracing().startChunk();
            iChunkOpenHolder.set(Boolean.TRUE);
        }
        catch (Exception iException)
        {
            iTracingHolder.set(Boolean.FALSE);
            log.warning("[PlaywrightFactory] Tracing could not start : " + iException.getMessage());
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : stop
    // Description   : Stops tracing (saving the zip when required), then closes page, context, browser and Playwright.
    //                 Never throws - a teardown problem must not hide the real test result.
    // Parameters    : pTestFailed (boolean) - true keeps the trace when trace.mode=retain-on-failure
    //                 pTraceName  (String)  - logical name used in the trace file name (usually the test case ID)
    // Returns       : String - absolute path of the saved trace zip, or empty string when no trace was kept
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static String stop(boolean pTestFailed, String pTraceName)
    {
        String  iTracePath = saveTraceChunk(pTestFailed, pTraceName);
        boolean iKeepOpen  = !iShuttingDown
                && ConfigManager.getBool("browser.reuse", true)
                && canReuse(iStartedTypeHolder.get());

        if (iKeepOpen)
        {
            // The next test case calls start() again and gets this browser back with a clean session
            log.info("[PlaywrightFactory] Browser kept open for the next test case (browser.reuse=true).");
            return iTracePath;
        }

        try
        {
            BrowserContext iContext = iContextHolder.get();
            if (iContext != null && Boolean.TRUE.equals(iTracingHolder.get()))
            {
                iContext.tracing().stop();
            }
        }
        catch (Exception iException)
        {
            log.warning("[PlaywrightFactory] Trace stop failed : " + iException.getMessage());
        }

        closeQuietly();
        return iTracePath;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : shutdown
    // Description   : Closes the browser for good at the end of the run (TestRunner calls it after the last test case,
    //                 and a JVM shutdown hook calls it when a run is stopped in IntelliJ).
    //                 With browser.reuse=false this has nothing left to do - stop() already closed everything.
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void shutdown()
    {
        if (iPageHolder.get() == null && iContextHolder.get() == null && iPlaywrightHolder.get() == null)
        {
            return;
        }

        iShuttingDown = true;
        try
        {
            BrowserContext iContext = iContextHolder.get();
            if (iContext != null && Boolean.TRUE.equals(iTracingHolder.get()))
            {
                iContext.tracing().stop();
            }
        }
        catch (Exception iIgnored) { }

        closeQuietly();
        iShuttingDown = false;
        log.info("[PlaywrightFactory] Browser closed at the end of the run.");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : saveTraceChunk
    // Description   : Ends this test case's trace chunk, saving it as a zip when the test case failed
    //                 (trace.mode=retain-on-failure) or always (trace.mode=on).
    // Parameters    : pTestFailed (boolean), pTraceName (String) - usually the TestCase_ID
    // Returns       : String - saved zip path, or empty
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    private static String saveTraceChunk(boolean pTestFailed, String pTraceName)
    {
        BrowserContext iContext = iContextHolder.get();

        if (iContext == null || !Boolean.TRUE.equals(iTracingHolder.get()) || !Boolean.TRUE.equals(iChunkOpenHolder.get()))
        {
            return "";
        }

        try
        {
            String  iMode = traceMode();
            boolean iKeep = "on".equals(iMode) || ("retain-on-failure".equals(iMode) && pTestFailed);

            if (iKeep)
            {
                File iDir = new File(ConfigManager.getOrDefault("report.traces.path", "Test_Report/traces"));
                if (!iDir.exists()) { iDir.mkdirs(); }

                String iSafeName = (pTraceName == null || pTraceName.isBlank() ? "trace" : pTraceName)
                        .trim().replaceAll("[^A-Za-z0-9_-]+", "_");
                Path iPath = Paths.get(iDir.getAbsolutePath(),
                        iSafeName + "_" + LocalDateTime.now().format(iFileTimestamp) + ".zip");

                iContext.tracing().stopChunk(new Tracing.StopChunkOptions().setPath(iPath));
                iChunkOpenHolder.set(Boolean.FALSE);

                log.info("[PlaywrightFactory] Trace saved : " + iPath
                        + "  (drag the zip onto https://trace.playwright.dev to replay it)");
                return iPath.toString();
            }

            iContext.tracing().stopChunk();
            iChunkOpenHolder.set(Boolean.FALSE);
        }
        catch (Exception iException)
        {
            iChunkOpenHolder.set(Boolean.FALSE);
            log.warning("[PlaywrightFactory] Trace stop failed : " + iException.getMessage());
        }

        return "";
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : canReuse
    // Description   : true when the browser from the previous test case is still alive and usable for this one.
    //                 A different browser type, a closed page or a browser that crashed all mean: start a new one.
    // Parameters    : pBrowserType (String) - browser the next test case asks for
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    private static boolean canReuse(String pBrowserType)
    {
        Page           iPage    = iPageHolder.get();
        BrowserContext iContext = iContextHolder.get();
        Browser        iBrowser = iBrowserHolder.get();
        String         iStarted = iStartedTypeHolder.get();

        if (iPage == null || iContext == null || iStarted == null)          { return false; }
        if (pBrowserType != null && !iStarted.equals(pBrowserType))         { return false; }
        if (iBrowser != null && !iBrowser.isConnected())                    { return false; }

        // Safety valve for long suites: browser.reuse.max.testcases=0 (default) means never restart on purpose
        int iMax = ConfigManager.getInt("browser.reuse.max.testcases", 0);
        if (iMax > 0 && iReuseCountHolder.get() >= iMax)
        {
            log.info("[PlaywrightFactory] Browser reused " + iReuseCountHolder.get()
                    + " times (browser.reuse.max.testcases=" + iMax + ") - starting a fresh one.");
            return false;
        }

        try
        {
            return !iPage.isClosed();
        }
        catch (Exception iException)
        {
            return false;
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : resetSession
    // Description   : Gives the next test case a clean session in the browser that is already open:
    //                   1. every extra tab is closed
    //                   2. a new tab replaces the old one (a new tab starts with empty sessionStorage)
    //                   3. cookies are cleared - this is what ends the SSO session, so the next test case logs in again
    //                   4. a new trace chunk starts and the download list is emptied
    //                 localStorage belongs to a web address, so it is cleared right after the first page is opened -
    //                 CommonFunctions.launchBrowser calls clearSiteStorageIfReused for that.
    // Returns       : Page - the clean page, or null when the browser could not be reset (the caller then starts a new browser)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Page resetSession()
    {
        long iStart = System.currentTimeMillis();

        try
        {
            BrowserContext iContext = iContextHolder.get();
            Page           iOldPage = iPageHolder.get();

            // A new tab, so nothing is left in sessionStorage or in the page itself
            iOpeningMainPage.set(Boolean.TRUE);
            Page iFreshPage;
            try     { iFreshPage = iContext.newPage(); }
            finally { iOpeningMainPage.set(Boolean.FALSE); }

            for (Page iOther : iContext.pages())
            {
                if (iOther != iFreshPage)
                {
                    try { iOther.close(); } catch (Exception iIgnored) { }
                }
            }

            iPageHolder.set(iFreshPage);

            // Ends the SSO session: the next test case goes through the real login again
            iContext.clearCookies();

            iDownloadsHolder.get().clear();
            iReusedHolder.set(Boolean.TRUE);
            iReuseCountHolder.set(iReuseCountHolder.get() + 1);

            if (Boolean.TRUE.equals(iTracingHolder.get()) && !Boolean.TRUE.equals(iChunkOpenHolder.get()))
            {
                iContext.tracing().startChunk();
                iChunkOpenHolder.set(Boolean.TRUE);
            }

            log.info("[PlaywrightFactory] Reusing the open browser (browser.reuse=true) | Session cleared in "
                    + (System.currentTimeMillis() - iStart) + " ms | " + iVersionHolder.get());

            return iFreshPage;
        }
        catch (Exception iException)
        {
            log.warning("[PlaywrightFactory] Could not reset the open browser : " + iException.getMessage());
            iReusedHolder.set(Boolean.FALSE);
            try { closeQuietly(); } catch (Exception iIgnored) { }
            return null;
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : clearSiteStorageIfReused
    // Description   : Wipes localStorage, sessionStorage, IndexedDB and service workers for the application address
    //                 BEFORE the page is opened, so a reused browser cannot carry a token from the previous test case
    //                 and silently log in as the previous agent.
    //                 Chrome and Edge: one DevTools call (Storage.clearDataForOrigin) - nothing is loaded yet.
    //                 Firefox and WebKit: the page is opened first, storage is cleared and the page reloaded.
    //                 Does nothing on a browser that was just started.
    // Parameters    : pPage (Page)   - the page about to open the application
    //                 pUrl  (String) - the application URL, used for its web address (scheme://host:port)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void clearSiteStorageIfReused(Page pPage, String pUrl)
    {
        if (!Boolean.TRUE.equals(iReusedHolder.get()) || pPage == null)
        {
            return;
        }

        iReusedHolder.set(Boolean.FALSE);

        String iOrigin = originOf(pUrl);
        if (iOrigin.isEmpty())
        {
            return;
        }

        // -- Chromium: clear before anything loads ------------------------------------------------------------------
        try
        {
            com.google.gson.JsonObject iParams = new com.google.gson.JsonObject();
            iParams.addProperty("origin", iOrigin);
            iParams.addProperty("storageTypes", "local_storage,indexeddb,websql,service_workers,cache_storage");

            iContextHolder.get().newCDPSession(pPage).send("Storage.clearDataForOrigin", iParams);
            log.info("[PlaywrightFactory] Site storage cleared for " + iOrigin + " (reused browser).");
            return;
        }
        catch (Exception iNotChromium)
        {
            log.fine("[PlaywrightFactory] DevTools storage clear not available : " + iNotChromium.getMessage());
        }

        // -- Firefox / WebKit: open the page, clear, reload ----------------------------------------------------------
        try
        {
            pPage.navigate(iOrigin);
            pPage.evaluate("() => { try { window.localStorage.clear(); window.sessionStorage.clear(); } catch (e) { } }");
        }
        catch (Exception iException)
        {
            log.warning("[PlaywrightFactory] Web storage could not be cleared on the reused browser : " + iException.getMessage());
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : originOf
    // Description   : scheme://host:port of a URL - what a browser calls the origin, and the unit storage belongs to.
    // Parameters    : pUrl (String)
    // Returns       : String - origin, or empty when the URL cannot be read
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    private static String originOf(String pUrl)
    {
        try
        {
            java.net.URL iParsed = new java.net.URL(pUrl.trim());
            return iParsed.getProtocol() + "://" + iParsed.getHost()
                    + (iParsed.getPort() == -1 ? "" : ":" + iParsed.getPort());
        }
        catch (Exception iException)
        {
            return "";
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : addShutdownHookOnce
    // Description   : Closes the browser if the run is stopped (the red square in IntelliJ, Ctrl+C), so browser.reuse
    //                 never leaves a Chrome behind.
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void addShutdownHookOnce()
    {
        if (!iShutdownHookAdded.compareAndSet(false, true))
        {
            return;
        }

        Runtime.getRuntime().addShutdownHook(new Thread(() ->
        {
            try   { closeQuietly(); }
            catch (Exception iIgnored) { }
        }, "biss-playwright-shutdown"));
    }

    private static void closeQuietly()
    {
        try { if (iContextHolder.get() != null)    { iContextHolder.get().close(); } }    catch (Exception iIgnored) { }
        try { if (iBrowserHolder.get() != null)    { iBrowserHolder.get().close(); } }    catch (Exception iIgnored) { }
        try { if (iPlaywrightHolder.get() != null) { iPlaywrightHolder.get().close(); } } catch (Exception iIgnored) { }
        deleteProfileQuietly();

        iPageHolder.remove();
        iContextHolder.remove();
        iBrowserHolder.remove();
        iPlaywrightHolder.remove();
        iTracingHolder.remove();
        iProfileHolder.remove();
        iVersionHolder.remove();
        iNextDialogAction.remove();
        iNextPromptText.remove();
        iOpeningMainPage.remove();
        iDownloadsHolder.remove();
        iStartedTypeHolder.remove();
        iChunkOpenHolder.remove();
        iReusedHolder.remove();
        iReuseCountHolder.remove();
    }

