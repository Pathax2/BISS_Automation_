-- 1. Every ETF link row of the herd (all years, all ETFs)
SELECT l.*, u.username
FROM   tden_herd_etf_link l
LEFT   JOIN vw_sso_roles_for_user_ents u ON u.businessid = l.hel_etf_no
WHERE  l.hel_herd_no = 'Q1700791'
ORDER  BY l.hel_scheme_year DESC, l.hel_id DESC;

-- 2. Applications already raised from this herd
SELECT *
FROM   tden_inet_application
WHERE  iap_from_herd = 'Q1700791';
