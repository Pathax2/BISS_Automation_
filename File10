    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theStaffUserRequestsAMapWithTheFollowingSettings
    // Description   : Composes and submits a map generation request from a settings table. This is the step that
    //                 replaces the legacy sequence of dropdown clicks, checkbox clicks and a Generate click.
    //
    //                 Supported keys (all optional - only supply what the scenario needs):
    //                   parcels  - "single" selects one parcel, "all" selects every parcel
    //                   mapType  - map layout, e.g. "Full Color Ortho A4", "Custom Layer A4"
    //                   imagery  - imagery layer, custom layouts only
    //                   raster   - raster layer, custom layouts only
    //                   vector   - "default" picks the first available vector layer
    //                   legend   - "yes" ticks the legend indicator
    //
    //                 Generation is only submitted when a mapType is supplied. That is deliberate: the validation
    //                 scenarios build a PARTIAL request (e.g. parcels only, then dismiss the map type selector)
    //                 to prove the field is mandatory, and must not click Generate.
    // Parameters    : pSettings (DataTable) - key/value settings map
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026 | Updated: 05-10-2026 (Playwright)
    // ---------------------------------------------------------------------------------------------------------------------------------
    @And("the staff user requests a map with the following settings")
    public void theStaffUserRequestsAMapWithTheFollowingSettings(DataTable pSettings)
    {
        log.info("[STEP] the staff user requests a map with the following settings");
        Map<String, String> iSettings = pSettings.asMap(String.class, String.class);

        String iParcels = trimOrNull(iSettings.get("parcels"));
        String iMapType = trimOrNull(iSettings.get("mapType"));
        String iImagery = trimOrNull(iSettings.get("imagery"));
        String iRaster  = trimOrNull(iSettings.get("raster"));
        String iVector  = trimOrNull(iSettings.get("vector"));
        String iLegend  = trimOrNull(iSettings.get("legend"));
        log.info("[MAPS] Settings: " + iSettings);

        if (iParcels != null)
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iParcelSelect"), null);
            iAction("CLICK", "XPATH", ObjReader.getLocator("all".equalsIgnoreCase(iParcels) ? "iParcelSelectAllOption" : "iParcelSelectFirstOption"), null);
            iAction("CLICK", "XPATH", ObjReader.getLocator("iParcelSelect"), null);
        }

        if (iMapType != null)
        {
            iAction("LIST", "XPATH", ObjReader.getLocator("iMapTypeSelect"), iMapType);
        }

        if (iImagery != null)
        {
            iAction("LIST", "XPATH", ObjReader.getLocator("iImagerySelect"), iImagery);
        }

        if (iRaster != null)
        {
            iAction("LIST", "XPATH", ObjReader.getLocator("iRasterSelect"), iRaster);
        }

        if (iVector != null)
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iVectorSelect"), null);
            iAction("CLICK", "XPATH", ObjReader.getLocator("iVectorSelectFirstOption"), null);
            // Selenium: switchTo().activeElement().sendKeys(Keys.TAB) - closes the multi-select panel
            UiHelpers.pressKey("Tab");
        }

        if ("yes".equalsIgnoreCase(iLegend))
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iLegendIndicator"), null);
        }

        // Only submit when the request is complete. Validation scenarios stop short by design.
        if (iMapType != null)
        {
            try
            {
                if (UiHelpers.isVisible(UiHelpers.byXpath(ObjReader.getLocator("iGenerateMapButton")), PROBE_SECONDS))
                {
                    iAction("CLICK", "XPATH", ObjReader.getLocator("iGenerateMapButton"), null);
                    pause(4000);
                }
                else
                {
                    log.info("[STEP] Generate Map button not available.");
                }
            }
            catch (Exception e)
            {
                log.warning("[STEP] Generate Map click skipped: " + e.getMessage());
            }
        }
    }

