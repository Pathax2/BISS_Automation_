    // ***************************************************************************************************************************************************************************************
    // Function Name : stockReport
    // Description   : One line per pool: available / reserved / used / bad, with a LOW STOCK flag below data.low.stock
    //                 and an EMPTY flag at zero. Printed by TC_00_DATA and available to any step.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized String stockReport()
    {
        load();
        int iLow = ConfigManager.getInt("data.low.stock", 5);
        Map<String, int[]> iCounts = new TreeMap<>();
        for (Row iRow : HERDS)
        {
            int[] iC = iCounts.computeIfAbsent(iRow.pool + "/" + iRow.key, k -> new int[4]);
            switch (iRow.status)
            {
                case AVAILABLE: iC[0]++; break;
                case RESERVED:  iC[1]++; break;
                case USED:      iC[2]++; break;
                default:        iC[3]++; break;
            }
        }

        StringBuilder iReport = new StringBuilder();
        iReport.append(System.lineSeparator())
               .append("================ TEST DATA VAULT - STOCK ================").append(System.lineSeparator())
               .append(String.format("  %-34s %9s %9s %6s %5s  %s", "pool/key", "available", "reserved", "used", "bad", ""))
               .append(System.lineSeparator());
        for (Map.Entry<String, int[]> iEntry : iCounts.entrySet())
        {
            int[] iC   = iEntry.getValue();
            String iFlag = iC[0] == 0 ? "EMPTY" : iC[0] < iLow ? "LOW STOCK" : "";
            iReport.append(String.format("  %-34s %9d %9d %6d %5d  %s", iEntry.getKey(), iC[0], iC[1], iC[2], iC[3], iFlag))
                   .append(System.lineSeparator());
        }
        int iExpired = 0;
        for (Person iPerson : PEOPLE.values()) if ("EXPIRED".equals(iPerson.status)) iExpired++;
        iReport.append("  logins: ").append(PEOPLE.size()).append(" known, ").append(iExpired).append(" expired")
               .append(" | filled ").append(META.getProperty("filled_at", "never"))
               .append(" | ").append(dir().toAbsolutePath()).append(System.lineSeparator())
               .append("=========================================================");
        return iReport.toString();
    }

    public static synchronized List<String> lowStockPools()
    {
        load();
        int iLow = ConfigManager.getInt("data.low.stock", 5);
        Map<String, Integer> iAvail = new TreeMap<>();
        for (Row iRow : HERDS)
        {
            String iKey = iRow.pool + "/" + iRow.key;
            iAvail.putIfAbsent(iKey, 0);
            if (AVAILABLE.equals(iRow.status)) iAvail.put(iKey, iAvail.get(iKey) + 1);
        }
        List<String> iLowPools = new ArrayList<>();
        for (Map.Entry<String, Integer> iEntry : iAvail.entrySet())
        {
            if (iEntry.getValue() < iLow) iLowPools.add(iEntry.getKey() + " (" + iEntry.getValue() + " available)");
        }
        return iLowPools;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : writeExcelView
    // Description   : Writes TestDataVault_view.xlsx (sheets Herds, People, Stock) for people to open and filter.
    //                 It is a copy for viewing only: the framework reads the CSV files, never this workbook, so it may
    //                 stay open in Excel during a run without locking anything.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void writeExcelView()
    {
        load();
        try (XSSFWorkbook iBook = new XSSFWorkbook())
        {
            XSSFSheet iHerds = iBook.createSheet("Herds");
            writeRow(iHerds, 0, HERDS_HEADER.split(","));
            int iR = 1;
            for (Row iRow : HERDS)
            {
                writeRow(iHerds, iR++, new String[]{ iRow.pool, iRow.key, iRow.herd, iRow.name, iRow.address, iRow.login,
                        iRow.status, iRow.testCase, iRow.purpose, iRow.reason, iRow.fetchedAt, iRow.updatedAt });
            }

            XSSFSheet iPeople = iBook.createSheet("People");
            writeRow(iPeople, 0, PEOPLE_HEADER.split(","));
            iR = 1;
            for (Person iPerson : PEOPLE.values())
            {
                writeRow(iPeople, iR++, new String[]{ iPerson.login, iPerson.type, iPerson.status, iPerson.lastChecked, iPerson.note });
            }

            XSSFSheet iStock = iBook.createSheet("Stock");
            iR = 0;
            for (String iLine : stockReport().split("\\R"))
            {
                if (!iLine.isBlank()) writeRow(iStock, iR++, new String[]{ iLine });
            }

            Files.createDirectories(dir());
            try (FileOutputStream iOut = new FileOutputStream(viewFile().toFile()))
            {
                iBook.write(iOut);
            }
            CommonFunctions.log.info(LOG + "Excel view written: " + viewFile().toAbsolutePath());
        }
        catch (Exception e)
        {
            // The view is a convenience; the CSV files are the store. Excel having the file open is the usual cause.
            CommonFunctions.log.warning(LOG + "Could not write the Excel view (" + e.getMessage() + ") - the CSV files are up to date.");
        }
    }

    private static void writeRow(XSSFSheet pSheet, int pRowIndex, String[] pValues)
    {
        XSSFRow iRow = pSheet.createRow(pRowIndex);
        for (int i = 0; i < pValues.length; i++) iRow.createCell(i).setCellValue(pValues[i]);
    }

    // =================================================================================================
    // FILE LOCK (two framework processes on one machine)
    // =================================================================================================

    private static void withFileLock(Runnable pAction)
    {
        try
        {
            Files.createDirectories(dir());
            try (RandomAccessFile iRaf = new RandomAccessFile(lockFile().toFile(), "rw");
                 FileChannel iChannel = iRaf.getChannel())
            {
                FileLock iLock = null;
                try
                {
                    iLock = iChannel.lock();
                    pAction.run();
                }
                finally
                {
                    if (iLock != null && iLock.isValid()) iLock.release();
                }
            }
        }
        catch (Exception e)
        {
            // No lock = still save; the lock only matters when two processes write at the same time
            CommonFunctions.log.warning(LOG + "File lock unavailable (" + e.getMessage() + ") - saving without it.");
            pAction.run();
        }
    }

