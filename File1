# Admin check result radio button. {RESULT} = APPROVED | REJECTED
# 30-10-2026: clicks the label - the mat-radio-button host is wider than its content, so a click on its centre did nothing
iAdminCheckResultRadio              = //mat-radio-button[@value='{RESULT}']//label[contains(@class,'mdc-label')]


    @And("the staff user completes the admin check with the following result")
    public void theStaffUserCompletesTheAdminCheckWithTheFollowingResult(DataTable pResult)
    {
        log.info("[STEP] the staff user completes the admin check with the following result");
        Map<String, String> iResult = pResult.asMap(String.class, String.class);
        String              iValue  = iResult.get("result").trim();

        // The Active Farmer screen opens behind the loading spinner - a click on it would be lost
        iAction("WAITINVISIBLE", "XPATH", ObjReader.getLocator("iBissSpinnerDialog"), "Spinner");

        iAction("CLICK", "XPATH", ObjReader.getLocator("iAdminCheckResultRadio").replace("{RESULT}", iValue), null);

        // 30-10-2026: the radio must really be selected (mat-mdc-radio-checked) before the notes and Save
        String iChecked = "//mat-radio-button[@value='" + iValue + "'][contains(@class,'mat-mdc-radio-checked')]";
        if (!UiHelpers.isVisible(UiHelpers.byXpath(iChecked), PROBE_SECONDS))
        {
            throw new AssertionError("Admin check result '" + iValue + "' was clicked but is not selected.");
        }
        log.info("[STAFF] Admin check result selected: " + iValue);

        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iAdminNotes"), iResult.get("notes"));
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iSaveChangesButton"), null);
    }

