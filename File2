        return iCurrentPair;
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : nextIndividualTransferor
    // Description   : First half of an individual-as-transferor pair (TC_08 / TC_09 / TC_10_ENTS). Picks an unused herd
    //                 from the Individual Login query and makes it the current pair WITHOUT a transferee:
    //                   agent = the individual's own login (so {transferor.login} and {agent} return it)
    //                   transferor = that herd, transferee = null
    //                 The create step completes the pair with completePairWithAgentTransferee or
    //                 completePairWithIndividualTransferee. Recorded in the used-herds file straight away.
    // Parameters    : pPurpose (String) - written to the used-herds file, e.g. "individual transferor"
    // Returns       : TransferPair (transferee null)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextIndividualTransferor(String pPurpose)
    {
        Herd   iTransferor = pickUnusedIndividual(usedHerds(), "transferor");
        String iLogin      = INDIVIDUAL_LOGINS.get(iTransferor.herdNumber);

        markUsed("transferor-individual", iTransferor.herdNumber, iLogin, pPurpose);

        iCurrentPair = new TransferPair(iLogin, iTransferor, null, iLogin);

        CommonFunctions.log.info(LOG_PREFIX + "Picked individual transferor for [" + pPurpose + "] | Herd=" + iTransferor
                + " | Login=" + iLogin + " (transferee picked by the create step)");
        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : completePairWithAgentTransferee
    // Description   : Second half of an individual-as-transferor pair (TC_08_ENTS / TC_10_ENTS): the transferee is an
    //                 unused herd from the Agent Login pool of pAgent, and {transferee.agent} / {transferee.login}
    //                 return pAgent for the login-swap step.
    // Parameters    : pAgent (String) - agent (or ETF partner) login that manages the transferee, e.g. "aga6325"
    //                 pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair completePairWithAgentTransferee(String pAgent, String pPurpose)
    {
        requireHalfPair("completePairWithAgentTransferee");
        if (pAgent == null || pAgent.isBlank())
        {
            throw new IllegalArgumentException(LOG_PREFIX + "The transfereeAgent row is empty - give the login of the agent who manages the transferee.");
        }

        String      iAgent    = resolveAgent(pAgent);   // {auto.agent} -> the agent with the most herds
        Set<String> iUsedPlus = new HashSet<>(usedHerds());
        iUsedPlus.add(iCurrentPair.transferor.herdNumber);

        Herd iTransferee = pickUnused(iAgent, iUsedPlus, "transferee");
        markUsed("transferee", iTransferee.herdNumber, iAgent, pPurpose);

        iCurrentPair = new TransferPair(iCurrentPair.agent, iCurrentPair.transferor, iTransferee, iAgent);

        CommonFunctions.log.info(LOG_PREFIX + "Pair completed for [" + pPurpose + "] (individual to agent) | Transferor="
                + iCurrentPair.transferor + " (" + iCurrentPair.agent + ") | Transferee agent=" + iAgent + " | Transferee=" + iTransferee);
        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : completePairWithIndividualTransferee
    // Description   : Second half of an individual-as-transferor pair (TC_09_ENTS): the transferee is another unused herd
    //                 from the Individual Login query, and {transferee.login} returns that individual's login.
    // Parameters    : pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair completePairWithIndividualTransferee(String pPurpose)
    {
        requireHalfPair("completePairWithIndividualTransferee");

        Set<String> iUsedPlus = new HashSet<>(usedHerds());
        iUsedPlus.add(iCurrentPair.transferor.herdNumber);

        Herd   iTransferee = pickUnusedIndividual(iUsedPlus, "transferee");
        String iLogin      = INDIVIDUAL_LOGINS.get(iTransferee.herdNumber);
        markUsed("transferee-individual", iTransferee.herdNumber, iLogin, pPurpose);

        iCurrentPair = new TransferPair(iCurrentPair.agent, iCurrentPair.transferor, iTransferee, iLogin);

