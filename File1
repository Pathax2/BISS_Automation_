SELECT app_herd_no FROM (
  SELECT ta.app_herd_no
  FROM   tdbs_application ta
  WHERE  ta.app_year     = 2026
  AND    ta.app_mde_code = 4                                   -- submitted
  AND    ta.app_dct_code != 7                                  -- original submission, not an amendment (legacy rule)
  AND    REGEXP_LIKE(ta.app_herd_no, '^[A-Z]')                 -- real herds, A-herds kept, TRNs out
  AND    NOT EXISTS (SELECT 1 FROM tdbs_admin_check tac
                     WHERE tac.adc_app_id = ta.app_id)         -- admin check not started
  AND    NOT EXISTS (SELECT 1 FROM vwbs_application d
                     WHERE d.app_herd_no = ta.app_herd_no
                     AND   d.app_year    = ta.app_year
                     AND   d.app_mde_code IN (3, 6, 8))        -- no Draft / Helpdesk / Draft Dept left open
  AND    (SELECT COUNT(*) FROM tdbs_application_land x
          WHERE x.apl_app_id = ta.app_id
          AND   x.apl_year   = ta.app_year
          AND   x.apl_deleted_ind = 'N') >= 2                  -- at least 2 parcels
  ORDER BY DBMS_RANDOM.VALUE
) WHERE ROWNUM <= 20;
