    // =================================================================================================
    // TOKENS
    // =================================================================================================

    // ***************************************************************************************************************************************************************************************
    // Function Name : hasToken / tableHasToken
    // Description   : True when a value (or any value of a DataTable map) is a runtime token such as {transferor.herd}
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static boolean hasToken(String pValue)
    {
        if (pValue == null) return false;
        String iValue = pValue.trim();
        return iValue.startsWith("{") && iValue.endsWith("}");
    }

    public static boolean tableHasToken(Map<String, String> pTable)
    {
        if (pTable == null) return false;
        for (String iValue : pTable.values())
        {
            if (hasToken(iValue)) return true;
        }
        return false;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : resolve
    // Description   : Replaces a runtime token with the value of the current pair. Plain values come back unchanged.
    //                 Throws with a clear message when a token is used before any pair was picked, or is misspelt.
    // Parameters    : pValue (String) - DataTable cell, e.g. "{transferee.herd}" or "C1010148"
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized String resolve(String pValue)
    {
        if (pValue == null) return null;
        if (!hasToken(pValue)) return pValue.trim();

        String iToken = pValue.trim().toLowerCase(Locale.ROOT);

        if (iCurrentPair == null)
        {
            throw new IllegalStateException(LOG_PREFIX + "Token " + pValue.trim() + " used before a transfer pair was picked. "
                    + "The step that creates the transfer must run first in this section.");
        }

        switch (iToken)
        {
            case "{transferor.herd}":    return iCurrentPair.transferor.herdNumber;
            case "{transferor.name}":    return iCurrentPair.transferor.name;
            case "{transferor.address}": return iCurrentPair.transferor.address;
            case "{transferee.herd}":    return iCurrentPair.transferee.herdNumber;
            case "{transferee.name}":    return iCurrentPair.transferee.name;
            case "{transferee.address}": return iCurrentPair.transferee.address;
            case "{agent}":              return iCurrentPair.agent;
            default:
                throw new IllegalArgumentException(LOG_PREFIX + "Unknown token " + pValue.trim()
                        + ". Use {transferor.herd}, {transferor.name}, {transferee.herd}, {transferee.name}, "
                        + "{transferor.address}, {transferee.address} or {agent}.");
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : resolveTable
    // Description   : Returns a copy of a DataTable map with every token replaced (keys and order kept)
    // Parameters    : pTable (Map) - the DataTable as a key/value map
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Map<String, String> resolveTable(Map<String, String> pTable)
    {
        Map<String, String> iResolved = new LinkedHashMap<>();
        for (Map.Entry<String, String> iEntry : pTable.entrySet())
        {
            iResolved.put(iEntry.getKey(), resolve(iEntry.getValue()));
        }
        return iResolved;
    }

