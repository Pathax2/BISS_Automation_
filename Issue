    private UiHelpers() {}

    // ***************************************************************************************************************************************************************************************
    // Function Name : page
    // Description   : Returns the Playwright Page of the current thread (replacement for getDriver()).
    //                 Fails with a clear message when no browser has been started on this thread.
    // Returns       : Page - the active page
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Page page()
    {
        Page iPage = CommonFunctions.getPage();
        if (iPage == null) { throw new RuntimeException("No active Playwright page on this thread."); }
        return iPage;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : byKey
    // Description   : Builds a Locator from an Object Repository key. Optional String.format arguments fill %s placeholders.
    //                 Keys with {index}/{value}/${INDEX} placeholders: call ObjReader.getLocator(key).replace(...) and use byXpath().
    //                 The Locator may match several elements - use .first() or findAll() as needed.
    // Parameters    : pKey  (String)   - ObjectRepository.properties key
    //                 pArgs (Object[]) - optional values for %s placeholders
    // Returns       : Locator
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Locator byKey(String pKey, Object... pArgs)
    {
        String iRaw = ObjReader.getLocator(pKey);
        String iValue = (pArgs == null || pArgs.length == 0) ? iRaw : String.format(iRaw, pArgs);
        return page().locator(CommonFunctions.toSelector(ObjReader.getLocatorType(pKey), iValue));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : byXpath
    // Description   : Builds a Locator from a raw XPath (dynamic XPaths built in step definitions).
    //                 The Locator may match several elements - use .first() or findAll() as needed.
    // Parameters    : pXpath (String) - XPath expression, e.g. //button[normalize-space()='Next']
    // Returns       : Locator
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Locator byXpath(String pXpath)
    {
        return page().locator(CommonFunctions.toSelector("XPATH", pXpath));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : isVisible
    // Description   : true when the FIRST element for the Object Repository key becomes visible within the timeout.
    //                 Never throws on timeout - replacement for the private isVisible(By, int) copies in the Selenium steps.
    // Parameters    : pKey            (String) - ObjectRepository.properties key
    //                 pTimeoutSeconds (int)    - how long to wait
    // Returns       : boolean - true = visible, false = not visible in time
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static boolean isVisible(String pKey, int pTimeoutSeconds)
    {
        return isVisible(byKey(pKey), pTimeoutSeconds);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : isVisible
    // Description   : true when the FIRST element of the Locator becomes visible within the timeout. Never throws on timeout.
    //                 .first() - Selenium checked the first match only; without it a locator matching several elements
    //                 (e.g. the Eco AP rows with a toggle) fails with a strict mode violation instead of returning true.
    // Parameters    : pLocator        (Locator) - element(s) to check
    //                 pTimeoutSeconds (int)     - how long to wait
    // Returns       : boolean - true = visible, false = not visible in time
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026 | Updated: 17-09-2026 (first match)
    // ***************************************************************************************************************************************************************************************
    public static boolean isVisible(Locator pLocator, int pTimeoutSeconds)
    {
        try
        {
            pLocator.first().waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE).setTimeout(pTimeoutSeconds * 1000d));
            return true;
        }
        catch (TimeoutError iTimeout)
        {
            return false;
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : waitHidden
    // Description   : Waits until the FIRST element of the Locator is hidden or removed (spinners, overlays, closing dialogs).
    //                 Throws a TimeoutError when it is still visible after the timeout.
    // Parameters    : pLocator        (Locator) - element(s) to wait for
    //                 pTimeoutSeconds (int)     - how long to wait
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026 | Updated: 17-09-2026 (first match)
    // ***************************************************************************************************************************************************************************************
    public static void waitHidden(Locator pLocator, int pTimeoutSeconds)
    {
        pLocator.first().waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.HIDDEN).setTimeout(pTimeoutSeconds * 1000d));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : findAll
    // Description   : Snapshot of all current matches for an Object Repository key - same as driver.findElements().
    //                 No waiting; the list may be empty.
    // Parameters    : pKey (String) - ObjectRepository.properties key
    // Returns       : List<Locator> - one Locator per matching element
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static List<Locator> findAll(String pKey)
    {
        return byKey(pKey).all();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : findAll
    // Description   : Snapshot of all current matches for a Locator - same as driver.findElements(). No waiting; may be empty.
    // Parameters    : pLocator (Locator) - element(s) to list
    // Returns       : List<Locator> - one Locator per matching element
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static List<Locator> findAll(Locator pLocator)
    {
        return pLocator.all();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : jsClick
    // Description   : JavaScript click on the FIRST element of the Locator - replacement for
    //                 ((JavascriptExecutor) driver).executeScript("arguments[0].click();", element).
    //                 Works when an overlay covers the element. Same as iAction("JSCLICK", ...) without a step-log row.
    // Parameters    : pLocator (Locator) - element to click
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026 | Updated: 17-09-2026 (first match)
    // ***************************************************************************************************************************************************************************************
    public static void jsClick(Locator pLocator)
    {
        CommonFunctions.jsClick(pLocator.first());
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : setValueByJs
    // Description   : Sets a value on an input that Angular keeps disabled/readonly (mat-datepicker) and fires the
    //                 events Angular listens to. Replacement for the removeAttribute + executeScript blocks in TC_13_ENTS.
    //                 Works on the FIRST element of the Locator.
    // Parameters    : pLocator (Locator) - the input
    //                 pValue   (String)  - value to set, e.g. 01/06/2024
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026 | Updated: 17-09-2026 (first match)
    // ***************************************************************************************************************************************************************************************
    public static void setValueByJs(Locator pLocator, String pValue)
    {
        pLocator.first().evaluate(
                "(element, value) => {"
                        + " element.removeAttribute('disabled'); element.removeAttribute('readonly');"
                        + " element.focus(); element.value = value;"
                        + " element.dispatchEvent(new Event('input', { bubbles: true }));"
                        + " element.dispatchEvent(new Event('change', { bubbles: true }));"
                        + " element.dispatchEvent(new Event('blur', { bubbles: true })); }",
                pValue);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : getAttribute
    // Description   : Reads an attribute of the FIRST element - replacement for WebElement.getAttribute(name).
    //                 Waits for the element to exist (explicit wait); returns null when the attribute is absent.
    // Parameters    : pLocator (Locator) - element to read
    //                 pName    (String)  - attribute name, e.g. aria-checked, disabled, class
    // Returns       : String - attribute value or null
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026 | Updated: 17-09-2026 (first match)
    // ***************************************************************************************************************************************************************************************
    public static String getAttribute(Locator pLocator, String pName)
    {
        return pLocator.first().getAttribute(pName);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : inputValue
    // Description   : Reads the current value of the FIRST input / textarea / select - replacement for
    //                 WebElement.getAttribute("value").
    // Parameters    : pLocator (Locator) - input element
    // Returns       : String - current value
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026 | Updated: 17-09-2026 (first match)
    // ***************************************************************************************************************************************************************************************
    public static String inputValue(Locator pLocator)
    {
        return pLocator.first().inputValue();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : uploadFile
    // Description   : Gives a file to an <input type="file"> - works on hidden inputs, so the Selenium JavaScript that
    //                 un-hid the input is not needed and no OS file picker opens.
    //                 Relative paths are resolved from the project root; a missing file fails with the full path.
    // Parameters    : pKey      (String) - ObjectRepository.properties key of the file input
    //                 pFilePath (String) - absolute or project-relative path
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void uploadFile(String pKey, String pFilePath)
    {
        byKey(pKey).first().setInputFiles(CommonFunctions.resolveFilePath(pFilePath));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : navigateTo
    // Description   : Opens a URL in the current tab - replacement for getDriver().navigate().to(url) / getDriver().get(url).
    // Parameters    : pUrl (String) - full URL
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void navigateTo(String pUrl)
    {
        page().navigate(pUrl);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : navigateBack
    // Description   : Browser Back - replacement for getDriver().navigate().back().
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void navigateBack()
    {
        page().goBack();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : clearCookies
    // Description   : Deletes all cookies of the browser context - replacement for getDriver().manage().deleteAllCookies().
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void clearCookies()
