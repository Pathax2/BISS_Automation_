# Haylage checkbox - found by its text, not the generated id (mat-mdc-checkbox-N changes when options are added or hidden)
iHaylageCheckbox                    = //biss-application-active-farmer//mat-checkbox[.//span[contains(@class,'mdc-label')][contains(normalize-space(.),'Making Hay/Silage/Haylage')]]//input[@type='checkbox']

# Any Active Farmer option by its text. {OPTION} = text shown, e.g. Making Hay/Silage/Haylage, Topping, Keeping sheep/cattle/goats
iActiveFarmerOption                 = //biss-application-active-farmer//mat-checkbox[.//span[contains(@class,'mdc-label')][contains(normalize-space(.),'{OPTION}')]]//input[@type='checkbox']

# The same option once it is ticked (Angular adds mat-mdc-checkbox-checked to the mat-checkbox)
iActiveFarmerOptionChecked          = //biss-application-active-farmer//mat-checkbox[contains(@class,'mat-mdc-checkbox-checked')][.//span[contains(@class,'mdc-label')][contains(normalize-space(.),'{OPTION}')]]


    @When("the agent selects {string} in the Active Farmer step")
    public void theAgentSelectsInTheActiveFarmerStep(String pOption)
    {
        log.info("[STEP] When the agent selects '" + pOption + "' in the Active Farmer step");

        // CHECK ticks the box only when it is not ticked yet - a CLICK would untick an option already chosen
        iAction("CHECKBOX", "XPATH", ObjReader.getLocator("iActiveFarmerOption").replace("{OPTION}", pOption), "CHECK");

        // The option must really be ticked before Next
        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iActiveFarmerOptionChecked").replace("{OPTION}", pOption), null);
    }

$x("//biss-application-active-farmer//mat-checkbox[.//span[contains(@class,'mdc-label')][contains(normalize-space(.),'Making Hay/Silage/Haylage')]]//input[@type='checkbox']")

$x("//biss-application-active-farmer//mat-checkbox[contains(@class,'mat-mdc-checkbox-checked')][.//span[contains(@class,'mdc-label')][contains(normalize-space(.),'Making Hay/Silage/Haylage')]]")






