    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theStaffUserReplacesTheBissRolesOfUserWithTheFollowing
    // Description   : One step for the legacy 15-step role reset: find the user, open Authorisations, choose the BISS
    //                 application, open Roles, move every assigned role back to Available, then for each table row
    //                 filter the available list and tick the role, move the ticked roles across, and save.
    //                 Rows with the same filter are selected together before one move (as legacy did).
    // Parameters    : pUsername (String)    - the user whose BISS roles change, e.g. agr0191
    //                 pRoles    (DataTable) - columns filter | role, e.g. PROCESSING | BISS Processing 3
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    @When("the staff user replaces the BISS roles of user {string} with the following")
    public void theStaffUserReplacesTheBissRolesOfUserWithTheFollowing(String pUsername, DataTable pRoles)
    {
        log.info("[STEP] the staff user replaces the BISS roles of user " + pUsername + " with the following");
        List<Map<String, String>> iRows = pRoles.asMaps(String.class, String.class);

        // Find the user
        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iSsoSearchUsername"), pUsername);
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iButtonByText").replace("{LABEL}", "Search"), null);
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iSsoUserRow"), null);

        // Authorisations for the BISS application, Roles tab
        iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoUserTab").replace("{TAB}", "authorisations"), null);
        iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoApplicationSelect"), null);
        iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoApplicationOption").replace("{TEXT}", "BISS"), null);
        iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoAuthorisationTab").replace("{TAB}", "Roles"), null);

        // Clear: select every assigned role (right-hand list) and move it back. No roles assigned = nothing to clear.
        if (UiHelpers.isVisible(UiHelpers.byXpath(ObjReader.getLocator("iSsoSelectAllRoles").replace("{SIDE}", "right")), PROBE_SECONDS))
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoSelectAllRoles").replace("{SIDE}", "right"), null);
            iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoMoveButton").replace("{ICON}", "arrow_back"), null);
            pause(1500);
        }
        else
        {
            log.info("[SSO] " + pUsername + " has no BISS roles assigned - nothing to clear.");
        }

        // Assign: filter, tick, move - one move per filter group, in table order
        String iCurrentFilter = null;
        for (Map<String, String> iRow : iRows)
        {
            String iFilter = iRow.getOrDefault("filter", "").trim();
            String iRole   = iRow.getOrDefault("role", "").trim();
            if (iRole.isEmpty()) continue;

            if (iCurrentFilter != null && !iCurrentFilter.equals(iFilter))
            {
                iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoMoveButton").replace("{ICON}", "arrow_forward"), null);
                pause(1500);
            }
            if (!iFilter.equals(iCurrentFilter))
            {
                iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iSsoRoleFilter"), iFilter);
                iCurrentFilter = iFilter;
            }
            iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoRoleOption").replace("{TEXT}", iRole), null);
            log.info("[SSO] Role ticked: " + iRole);
        }
        if (iCurrentFilter != null)
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iSsoMoveButton").replace("{ICON}", "arrow_forward"), null);
            pause(1500);
        }

        iAction("CLICK", "XPATH", ObjReader.getLocator("iButtonByText").replace("{LABEL}", "Save Authorisations"), null);
        log.info("[SSO] BISS roles of " + pUsername + " replaced with " + iRows.size() + " role(s).");
    }

