    // Selected (true) or not selected (false), from the class on the scheme's mat-card. Fails when the card shows
    // neither class - the panel did not render a state for it.
    private boolean iReadSchemeSelected(String pScheme)
    {
        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iSchemeCardTitle").replace("{SCHEME}", pScheme), null);
        if (UiHelpers.byXpath(ObjReader.getLocator("iSchemeCardSelected").replace("{SCHEME}", pScheme)).count() > 0)
        {
            return true;
        }
        if (UiHelpers.byXpath(ObjReader.getLocator("iSchemeCardNotSelected").replace("{SCHEME}", pScheme)).count() > 0)
        {
            return false;
        }
        throw new AssertionError("Scheme card '" + pScheme + "' shows neither scheme-selected nor scheme-not-selected.");
    }

    // pExpectFlipped true: every scheme must differ from the noted state; false: every scheme must equal it
    private void iCompareSchemeStates(List<String> pSchemes, boolean pExpectFlipped)
    {
        StringBuilder iWrong = new StringBuilder();
        for (String iScheme : pSchemes)
        {
            Boolean iNoted = iNotedSchemeStates.get(iScheme);
            if (iNoted == null)
            {
                throw new IllegalStateException("The selection of '" + iScheme + "' was not noted earlier in this scenario. "
                        + "Add it to \"the staff user notes the selection state of the following schemes\" before the change.");
            }
            boolean iNow = iReadSchemeSelected(iScheme);
            log.info("[SCHEME] " + iScheme + " : noted " + (iNoted ? "selected" : "not selected")
                    + ", now " + (iNow ? "selected" : "not selected"));
            if ((iNow != iNoted) != pExpectFlipped)
            {
                iWrong.append(iWrong.length() == 0 ? "" : ", ").append(iScheme);
            }
        }
        if (iWrong.length() > 0)
        {
            throw new AssertionError((pExpectFlipped ? "Selection did not change for: " : "Selection is not back to the noted state for: ") + iWrong);
        }
    }

