// ===================================================================================================================================
// File          : TC_17_ENTS.java
// Package       : stepdefinitions.ENTS
// Description   : Step definitions for TC_17_ENTS - Transfer End-to-End with Staff ENTSCore Verification.
//
//                 Steps in this file (1):
//                   1. the agent picks a same-agent transfer pair for {string}
//
//                 Every other TC_17_ENTS step is reused (bound automatically by Cucumber):
//                   login, BISS Home, My Clients               -> TC_03.java, TC_08_ENTS.java
//                   switch to the Transfers tab                -> TC_06.java
//                   search herd, side nav tab, OwnerID, staff  -> TC_15_ENTS.java
//                   create, upload, send, key, submitted       -> TC_01_ENTS.java
//                   transferee acceptance flow                 -> TC_07_ENTS.java
//
//                 Why this step (07-10-2026): TC_17 captures the OwnerID of the TRANSFEROR before the transfer is created,
//                 so the staff can search it in ENTSCore. With database herds the pair is normally picked inside the create
//                 step, which is too late for the OwnerID step. This step picks the pair first and pins it; the create
//                 step (TC_01_ENTS) then keeps it and only replaces the transferee if a check fails there.
//
// Author        : Aniket Pathare | aniket.pathare@government.ie
// Date Created  : 07-10-2026
// ===================================================================================================================================

package stepdefinitions.ENTS;

import io.cucumber.java.en.When;
import utilities.ConfigManager;
import utilities.EntsTestData;

import java.util.logging.Logger;

public class TC_17_ENTS
{
    private static final Logger log = Logger.getLogger(TC_17_ENTS.class.getName());


    // ***************************************************************************************************************************************************************************************
    // Step          : the agent picks a same-agent transfer pair for {string}
    // Description   : Picks a transferor and a transferee herd of the logged-in agent from the ENTS Agent Login query (Test
    //                 Data Vault first), checks both in the agent's Transfer Out list with the same checks as the create
    //                 step (not blacklisted, in the list, not expired; the portal name replaces the DB name), and pins the
    //                 pair so {transferor.herd}, {transferee.herd} and {transferee.name} can be used from here on.
    //                 A herd that fails a check is recorded as not found and another pair is picked, up to
    //                 ents.pair.retries (default 5).
    //                 Must run on the Transfers tab of My Clients, after the agent's login.
    // Parameters    : pTransferType (String) - transfer type of the section, e.g. "Change of Legal Entity"
    //                                          (written to the used-herds file and the vault, as in the create step)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 07-10-2026
    // ***************************************************************************************************************************************************************************************
    @When("the agent picks a same-agent transfer pair for {string}")
    public void theAgentPicksASameAgentTransferPair(String pTransferType)
    {
        String iPurpose  = pTransferType == null ? "" : pTransferType.trim();
        String iAgent    = EntsTestData.loggedInUser();
        int    iMaxTries = Math.max(1, ConfigManager.getInt("ents.pair.retries", 5));

        log.info("[STEP] When the agent picks a same-agent transfer pair for " + iPurpose + " (agent " + iAgent + ")");

        for (int iTry = 1; iTry <= iMaxTries; iTry++)
        {
            EntsTestData.TransferPair iPair = EntsTestData.nextSameAgentPair(iAgent, iPurpose);

            String iTransferee = iPair.transferee.herdNumber;
            String iTransferor = iPair.transferor.herdNumber;

            String iRejected = iTransferee;
            String iReason   = TC_01_ENTS.herdProblem(iTransferee, "transferee");
            if (iReason == null)
            {
                iRejected = iTransferor;
                iReason   = TC_01_ENTS.herdProblem(iTransferor, "transferor");
            }

            if (iReason == null)
            {
                EntsTestData.pinPair();
                log.info("[TC17] Pair picked and pinned: transferor " + EntsTestData.currentPair().transferor
                        + " -> transferee " + EntsTestData.currentPair().transferee + " (agent " + iAgent + ")");
                return;
            }

            if (iTry == iMaxTries)
            {
                throw new RuntimeException("[TC17] Herd " + iRejected + " is " + iReason + " (tried " + iMaxTries
                        + " pairs of " + iAgent + " - check the Agent Login query / ents.scheme.year)");
            }
            EntsTestData.markNotFound(iRejected, iReason);
            log.warning("[TC17] Try " + iTry + "/" + iMaxTries + ": " + iRejected + " " + iReason + " - picking another pair.");
        }
    }
}
