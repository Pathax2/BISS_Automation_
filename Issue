    // Container logs are shipped to CI - never print the raw password typed into a password field
    private static String maskForLog(String pActionType, String pValue)
    {
        if (pValue == null) { return ""; }
        if ("TEXTBOX".equalsIgnoreCase(pActionType) && iMaskNextValue.get()) { return "****"; }
        return pValue;
    }

    private static final ThreadLocal<Boolean> iMaskNextValue = ThreadLocal.withInitial(() -> Boolean.FALSE);

    // Playwright for Java messages start with "Error {" - show the real message and the last call-log line instead
    private static String firstLine(String pText)
    {
        if (pText == null) { return ""; }
        int    iBreak = pText.indexOf('\n');
        String iFirst = iBreak < 0 ? pText : pText.substring(0, iBreak);
        if (!iFirst.trim().startsWith("Error {")) { return iFirst; }

        java.util.regex.Matcher iMessage = Pattern.compile("message='([^\\n]*)").matcher(pText);
        String iResult = iMessage.find() ? iMessage.group(1).trim() : iFirst;

        String iLastCall = "";
        for (String iLine : pText.split("\\R"))
        {
            String iTrim = iLine.replaceAll("\\u001B\\[[0-9;]*m", "").trim();
            if (iTrim.startsWith("- ")) { iLastCall = iTrim.replaceFirst("^-\\s*-?\\s*", ""); }
        }
        return iLastCall.isEmpty() ? iResult : iResult + " | " + iLastCall;
    }

