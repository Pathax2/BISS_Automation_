    private static void performClick(Locator pLocator, String pObjectName)
    {
        waitVisible(pLocator);
        highlightElement(pLocator);
        clickWithFallback(pLocator, pObjectName);
    }

    // JavaScript click: needs the element in the page, not necessarily visible or uncovered
    private static void performJsClick(Locator pLocator, String pObjectName)
    {
        pLocator.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.ATTACHED).setTimeout(iActionTimeoutMs));
        highlightElement(pLocator);
        jsClick(pLocator, pObjectName);
    }

