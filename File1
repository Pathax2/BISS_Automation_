    public static synchronized Map<String, Integer> availableCounts()
    {
        load();
        Map<String, Integer> iCounts = new HashMap<>();
        for (Row iRow : HERDS)
        {
            if (AVAILABLE.equals(iRow.status)) iCounts.merge(iRow.pool + "/" + iRow.key, 1, Integer::sum);
