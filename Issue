    // Description   : Draws a temporary red outline around the element (non-blocking). Controlled by highlight.enabled.
    //                 Disabled by default in the docker profile - it adds no value in headless runs.
    // Parameters    : pLocator (Locator) - target element
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 10-03-2026 | Updated: 15-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    public static void highlightElement(Locator pLocator)
    {
        if (!iHighlightEnabled || pLocator == null) { return; }

        try
        {
            pLocator.evaluate(JS_HIGHLIGHT, null, new Locator.EvaluateOptions().setTimeout(2000));
        }
        catch (Exception iException)
        {
            log.fine("Unable to highlight element : " + iException.getMessage());
        }
    }

    public static void scrollIntoView(Locator pLocator)
