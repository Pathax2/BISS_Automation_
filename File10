    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theStaffUserShouldNotHaveAccessToTheTab
    // Description   : Asserts a tab is NOT present - the role restriction check. iAction's waits are built to find
    //                 elements, not to prove absence, so the tab is probed directly.
    //                 Kept from Selenium: the check uses iMapPrintingTab whatever pTabName says (only Map Printing is
    //                 asserted this way in the features). Change from Selenium: the probe waits PROBE_SECONDS, so a
    //                 tab that renders a moment late is still caught.
    // Parameters    : pTabName (String) - the tab that must not appear
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026 | Updated: 05-10-2026 (Playwright)
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the staff user should not have access to the {string} tab")
    public void theStaffUserShouldNotHaveAccessToTheTab(String pTabName)
    {
        log.info("[STEP] the staff user should not have access to the " + pTabName + " tab");
        // 15-10-2026: checks the NAMED tab or side menu entry (before, whatever the name, it looked for Map Printing)
        String iXpath = "Map Printing".equalsIgnoreCase(pTabName)
                ? ObjReader.getLocator("iMapPrintingTab")
                : ObjReader.getLocator("iTab").replace("{TAB}", pTabName) + " | " + ObjReader.getLocator("iNavbarLink").replace("{LINK}", pTabName);
        if (UiHelpers.isVisible(UiHelpers.byXpath(iXpath), PROBE_SECONDS))
        {
            throw new AssertionError("Tab '" + pTabName + "' is visible to this user but should be restricted.");
        }
        log.info("[STAFF] Tab '" + pTabName + "' is not shown to this user, as expected.");
    }

