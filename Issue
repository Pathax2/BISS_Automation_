    // ***************************************************************************************************************************************************************************************
    // Function Name : createZoomedProfile
    // Description   : Creates a temporary Chrome profile whose default page zoom is pZoomPercent.
    //                 Chrome stores zoom as a level where percent = 100 x 1.2^level (67% = -2.1965, 80% = -1.2239).
    //                 This is the same preference the Selenium framework set through ChromeOptions.
    // Parameters    : pZoomPercent (int) - e.g. 67, 70, 80
    // Returns       : Path - the profile folder (deleted again in stop())
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    static Path createZoomedProfile(int pZoomPercent)
    {
        try
        {
            double iLevel   = Math.log(pZoomPercent / 100.0) / Math.log(1.2);
            Path   iProfile = Files.createTempDirectory("biss-pw-profile-");
            Path   iDefault = Files.createDirectories(iProfile.resolve("Default"));
            String iPrefs   = String.format(Locale.ROOT,
                    "{\"partition\":{\"default_zoom_level\":{\"x\":%.6f}},"
                  + "\"profile\":{\"default_content_setting_values\":{\"notifications\":2}}}", iLevel);
            Files.write(iDefault.resolve("Preferences"), iPrefs.getBytes(StandardCharsets.UTF_8));
            return iProfile;
        }
        catch (Exception iException)
        {
            throw new RuntimeException("Could not create the temporary browser profile for page zoom : " + iException.getMessage(), iException);
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : saveDownload
    // Description   : Saves every file the application downloads (Export to Excel, PDF letters ...) under
    //                 report.downloads.path and remembers it for getDownloads().
    //                 Playwright keeps a download in a temporary folder and deletes it when the browser closes, and a
    //                 container has no Windows Downloads folder - so the file is copied out here, once, for both.
    //                 A name that already exists gets _1, _2 ... so nothing is overwritten.
    // Parameters    : pDownload (Download) - the download reported by the browser context
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 18-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void saveDownload(com.microsoft.playwright.Download pDownload)
    {
        try
        {
            File iDir = new File(ConfigManager.getOrDefault("report.downloads.path", "Test_Report/downloads"));
            if (!iDir.exists()) { iDir.mkdirs(); }

            String iName = pDownload.suggestedFilename();
            if (iName == null || iName.isBlank()) { iName = "download_" + LocalDateTime.now().format(iFileTimestamp); }

            Path iTarget = Paths.get(iDir.getAbsolutePath(), iName);
            int  iCopy   = 1;
            while (Files.exists(iTarget))
            {
                int    iDot  = iName.lastIndexOf('.');
                String iStem = iDot > 0 ? iName.substring(0, iDot) : iName;
                String iExt  = iDot > 0 ? iName.substring(iDot)    : "";
                iTarget = Paths.get(iDir.getAbsolutePath(), iStem + "_" + iCopy + iExt);
                iCopy++;
            }

            pDownload.saveAs(iTarget);
            iDownloadsHolder.get().add(iTarget);
            log.info("[BROWSER] Download saved : " + iTarget);
        }
        catch (Exception iException)
        {
            log.warning("[BROWSER] Download could not be saved : " + iException.getMessage());
        }
    }

