        UiHelpers.navigateTo(iUrl);
    }

    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : iStaffLoginUrl
    // Description   : Address of the staff login page, in this order:
    //                   1. staff.url (ConfigManager: -Dstaff.url=..., application-<env>.properties)
    //                   2. Config sheet of TestData.xlsx, row of the current environment, first non-empty column of
    //                      StaffURL / Staff URL / Staff_URL / StaffUrl
    //                   3. Hooks.iUrl - the Selenium behaviour (the run's Config URL is the staff portal)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 05-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    private static String iStaffLoginUrl()
    {
        String iUrl = ConfigManager.getOrDefault("staff.url", "").trim();
        if (!iUrl.isEmpty()) return iUrl;

        String iEnvironment = Hooks.iEnvironment == null ? "" : Hooks.iEnvironment.trim();
        try
        {
            ExcelUtilities iExcel = new ExcelUtilities(
                    ConfigManager.getOrDefault("test.data.file.path", "src/test/resources/Test_Data/TestData.xlsx"));
            int iRow = iExcel.findRow("Config", "Env", iEnvironment);
            if (iRow != -1)
            {
                for (String iColumn : STAFF_URL_COLUMNS)
                {
                    try
                    {
                        String iValue = iExcel.getCellValue("Config", iRow, iColumn);
                        if (iValue != null && !iValue.trim().isEmpty()) return iValue.trim();
                    }
                    catch (Exception iNoColumn)
                    {
                        // column not in the sheet - try the next name
                    }
                }
            }
        }
        catch (Exception iExcelError)
        {
            log.warning("[STAFF-LOGIN] Could not read the Config sheet: " + iExcelError.getMessage());
        }
        return Hooks.iUrl;
    }

