    // ***************************************************************************************************************************************************************************************
    // Function Name : individualPool
    // Description   : Rows of the Individual Login query, fetched once per run and cached. Same two-word name and
    //                 customer type settings as the Agent Login query (ents.name.two.words, ents.cust.type), because
    //                 the individual is typed into the same transferee search. Rows without a login are dropped.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 30-09-2026
    // ***************************************************************************************************************************************************************************************
    private static List<Herd> individualPool()
    {
        if (INDIVIDUAL_POOL != null) return INDIVIDUAL_POOL;

        List<Herd> iFromVault = vaultPool(TestDataVault.POOL_ENTS_INDIVIDUAL, "", "Individual Login");
        if (iFromVault != null)
        {
            for (TestDataVault.Row iRow : TestDataVault.available(TestDataVault.POOL_ENTS_INDIVIDUAL, ""))
            {
                INDIVIDUAL_LOGINS.putIfAbsent(iRow.herd, iRow.login);
            }
            INDIVIDUAL_POOL = iFromVault;
            return iFromVault;
        }

        int    iLimit = ConfigManager.getInt("ents.individual.pool.size", ConfigManager.getInt("ents.pool.size", 200));
        String iType  = ConfigManager.getOrDefault("ents.cust.type", "").trim();
        String iTwo   = ConfigManager.getBool("ents.name.two.words", true) ? "Y" : "";
        long   iStart = System.currentTimeMillis();

        CommonFunctions.log.info(LOG_PREFIX + "Running Individual Login query (up to " + iLimit + " rows"
                + (iType.isEmpty() ? ", all customer types" : ", cust_type " + iType)
                + (iTwo.isEmpty() ? "" : ", two-word names only") + ")...");
        DBRouter.runDB("ENTS", "ENTS Individual Login herds", String.valueOf(iLimit), iTwo, iType);

        List<Herd> iPool = new ArrayList<>();
        for (Map<String, Object> iRow : DBRouter.getRows())
        {
            String iHerd  = text(iRow, "HERD_NUMBER");
            String iLogin = text(iRow, "LOGIN_ID");
            if (!iHerd.isEmpty() && !iLogin.isEmpty() && !INDIVIDUAL_LOGINS.containsKey(iHerd))
            {
                iPool.add(new Herd(iHerd, text(iRow, "NAME"), text(iRow, "ADDRESS")));
                INDIVIDUAL_LOGINS.put(iHerd, iLogin);
            }
        }

        CommonFunctions.log.info(LOG_PREFIX + "Individual Login query returned " + iPool.size() + " herd(s) in "
                + (System.currentTimeMillis() - iStart) / 1000 + " s");

        if (iPool.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "Individual Login query returned no herds. "
                    + "Run it in SQL Developer on CENTEST_ENTS_DATA, or check ents.cust.type / ents.name.two.words.");
        }

        INDIVIDUAL_POOL = iPool;
        storeInVault(TestDataVault.POOL_ENTS_INDIVIDUAL, "", iPool, null);
        return iPool;
    }

    private static String text(Map<String, Object> pRow, String pColumn)
    {
        return Objects.toString(pRow.get(pColumn), "").trim();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markNotFound
    // Description   : Records that a picked herd could not be found on screen (for example not in the agent's
    //                 Transfer Out list). The herd is already in the used-herds file, so it is never picked again;
    //                 this extra line only explains why, for whoever reads the file.
    // Parameters    : pHerd   (String) - herd number
    //                 pReason (String) - short reason, e.g. "not in Transfer Out list"
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void markNotFound(String pHerd, String pReason)
    {
        String iAgent = iCurrentPair == null ? iLoggedInUser : iCurrentPair.agent;
        markUsed("not-found", pHerd, iAgent, pReason);
        CommonFunctions.log.warning(LOG_PREFIX + "Herd " + pHerd + " skipped: " + pReason);

        if (TestDataVault.isEnabled())
        {
            TestDataVault.markBad(pHerd, pReason);
            countBadAndRefill(iAgent);
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markCurrentPairUsed
    // Description   : The transfer of the current pair went through: both herds become USED in the vault. Called by
    //                 TC_01_ENTS "the transfer should be submitted successfully". Nothing happens without a pair.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void markCurrentPairUsed()
    {
        markCurrentPairUsed(true);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markCurrentPairUsed(boolean)
    // Description   : The section is finished. pConfirmed = the portal showed the submitted message.
    //                 Reuse mode (data.reuse.herds=true, 01-10-2026): a confirmed transfer only moved 0.01 entitlements,
    //                 so both herds go back to AVAILABLE in the vault and can be picked again, even later in this run.
    //                 Two exceptions stay USED until the next weekly refill, because reusing them would break a test:
    //                   - the transferee of a Lease: it now holds leased entitlements, and as a transferor it would hit
    //                     "Leased entitlements can only be transferred by Change of Registration ..."
    //                   - both herds of an unconfirmed transfer: it may still be pending, and a second transfer on the
    //                     same herd could be blocked or accept the wrong transfer
    // Parameters    : pConfirmed (boolean)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void markCurrentPairUsed(boolean pConfirmed)
    {
        if (iCurrentPair == null) return;
        boolean iReuse = TestDataVault.isReuseOn();
        boolean iLease = iLastPurpose.toLowerCase(Locale.ROOT).contains("lease");
        String  iOr    = iCurrentPair.transferor.herdNumber;
        String  iEe    = iCurrentPair.transferee == null ? null : iCurrentPair.transferee.herdNumber;

        if (TestDataVault.isEnabled())
        {
            if (!pConfirmed && iReuse)
            {
                TestDataVault.markUsedFinal(iOr, "transfer not confirmed - may still be pending");
                if (iEe != null) TestDataVault.markUsedFinal(iEe, "transfer not confirmed - may still be pending");
            }
            else
            {
                TestDataVault.markUsed(iOr);
                if (iEe != null)
                {
                    if (iReuse && iLease) TestDataVault.markUsedFinal(iEe, "lease transferee - holds leased entitlements now");
                    else                  TestDataVault.markUsed(iEe);
                }
            }
        }

        if (iReuse && pConfirmed)
        {
            COMPLETED_THIS_RUN.add(iOr);
            if (iEe != null && !iLease) COMPLETED_THIS_RUN.add(iEe);
            CommonFunctions.log.info(LOG_PREFIX + "Reuse mode: " + iOr + (iEe != null && !iLease ? " and " + iEe : "")
                    + " can be picked again" + (iLease && iEe != null ? " (" + iEe + " kept out: lease transferee)" : "") + ".");
        }
        BAD_IN_A_ROW.clear();
    }

    // =================================================================================================
    // TEST DATA VAULT BRIDGE
    // =================================================================================================

    // Herds marked BAD in a row per agent (reset by a success). Three in a row = the vault pool is stale -> refetch.
    private static final Map<String, Integer> BAD_IN_A_ROW = new HashMap<>();

    // ***************************************************************************************************************************************************************************************
    // Function Name : vaultPool
    // Description   : The AVAILABLE rows of a vault pool as Herd objects, or null when the vault is off or has nothing
    //                 for this pool (the caller then runs the live query).
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    private static List<Herd> vaultPool(String pPool, String pKey, String pLabel)
    {
        if (!TestDataVault.isEnabled() || !TestDataVault.hasPool(pPool, pKey)) return null;

        List<TestDataVault.Row> iRows = TestDataVault.available(pPool, pKey);
        if (iRows.isEmpty())
        {
            CommonFunctions.log.warning(LOG_PREFIX + "Vault pool " + pPool + "/" + pKey + " has no available row left - running the "
                    + pLabel + " query instead (run TC_00_DATA to refill the vault).");
            return null;
        }

        List<Herd> iPool = new ArrayList<>();
        for (TestDataVault.Row iRow : iRows) iPool.add(new Herd(iRow.herd, iRow.name, iRow.address));
        CommonFunctions.log.info(LOG_PREFIX + pLabel + " pool" + (pKey.isEmpty() ? "" : " for " + pKey) + " taken from the vault: "
                + iPool.size() + " available herd(s), no query run.");
        return iPool;
    }

    // Rows of a live query are stored in the vault too, so the next run finds them there
    private static void storeInVault(String pPool, String pKey, List<Herd> pHerds, String pLogin)
    {
        if (!TestDataVault.isEnabled()) return;
        try
        {
            List<TestDataVault.Row> iRows = new ArrayList<>();
            for (Herd iHerd : pHerds)
            {
                String iLogin = pLogin != null ? pLogin : INDIVIDUAL_LOGINS.getOrDefault(iHerd.herdNumber, "");
                iRows.add(new TestDataVault.Row(pPool, pKey, iHerd.herdNumber, iHerd.name, iHerd.address, iLogin));
            }
            TestDataVault.putPool(pPool, pKey, iRows);
        }
        catch (Exception e)
        {
            CommonFunctions.log.warning(LOG_PREFIX + "Could not store the " + pPool + " rows in the vault: " + e.getMessage());
        }
    }

    // Three BAD herds in a row for one agent: drop the cached pool so the next pick runs the live query and refills the vault
    private static void countBadAndRefill(String pAgent)
    {
        String iKey   = pAgent == null ? "" : pAgent.toLowerCase(Locale.ROOT);
        int    iCount = BAD_IN_A_ROW.merge(iKey, 1, Integer::sum);
        int    iLimit = ConfigManager.getInt("data.bad.in.a.row", 3);
        if (iCount >= iLimit)
        {
            CommonFunctions.log.warning(LOG_PREFIX + iCount + " bad herd(s) in a row for " + pAgent
                    + " - the vault pool looks stale, the next pick runs the live query and refills it.");
            AGENT_POOLS.remove(iKey);
            NO_ENTS_POOLS.remove(iKey);
            INDIVIDUAL_POOL = null;
            for (String iPoolName : new String[]{ TestDataVault.POOL_ENTS_AGENT, TestDataVault.POOL_ENTS_ETF })
            {
                for (TestDataVault.Row iRow : TestDataVault.available(iPoolName, pAgent))
                {
                    TestDataVault.markBad(iRow.herd, "pool refetched after " + iCount + " bad herds in a row");
                }
            }
            BAD_IN_A_ROW.put(iKey, 0);
        }
    }

    // =================================================================================================
    // USED-HERDS FILE
    // =================================================================================================

    private static Path usedFile()
    {
        return Paths.get(ConfigManager.getOrDefault("ents.used.herds.file", "runtime-data/ents_used_herds.csv"));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : usedHerds
    // Description   : Herds that must not be picked: those handed out in this run, plus (when ents.skip.used.herds=true)
    //                 every herd listed in the used-herds file from earlier runs.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Set<String> usedHerds()
    {
        Set<String> iUsed = new HashSet<>(USED_THIS_RUN);

        // Reuse mode: only herds still in flight are skipped (handed out, transfer not confirmed yet). The used-herds
        // file is still written as a log, but not read.
        if (TestDataVault.isReuseOn())
        {
            iUsed.removeAll(COMPLETED_THIS_RUN);
            return iUsed;
        }

        if (!ConfigManager.getBool("ents.skip.used.herds", true)) return iUsed;

        Path iFile = usedFile();
        if (!Files.exists(iFile)) return iUsed;

        try
        {
            for (String iLine : Files.readAllLines(iFile, StandardCharsets.UTF_8))
            {
                String[] iCells = iLine.split(",", -1);
                if (iCells.length >= 4 && !iCells[3].isBlank() && !"herd".equalsIgnoreCase(iCells[3].trim()))
                {
                    iUsed.add(iCells[3].trim());
                }
            }
        }
        catch (IOException e)
        {
            CommonFunctions.log.warning(LOG_PREFIX + "Could not read " + iFile + " (" + e.getMessage()
                    + ") - only herds used in this run are skipped.");
        }
        return iUsed;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markUsed
    // Description   : Adds one line to the used-herds file. A write failure is logged, never fatal.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void markUsed(String pRole, String pHerd, String pLogin, String pPurpose)
    {
        USED_THIS_RUN.add(pHerd);
        COMPLETED_THIS_RUN.remove(pHerd);   // handed out again - in flight until its transfer is confirmed
        if (pPurpose != null) iLastPurpose = pPurpose;

        // Vault: a herd handed out is RESERVED until markCurrentPairUsed (USED) or markNotFound (BAD)
        if (TestDataVault.isEnabled() && !"not-found".equals(pRole))
        {
            try { TestDataVault.reserveHerd(pHerd, System.getProperty("testcase", ""), pRole + " " + (pPurpose == null ? "" : pPurpose)); }
            catch (Exception e) { CommonFunctions.log.warning(LOG_PREFIX + "Vault reserve failed for " + pHerd + ": " + e.getMessage()); }
        }

        Path iFile = usedFile();
        try
        {
            if (iFile.getParent() != null) Files.createDirectories(iFile.getParent());
            if (!Files.exists(iFile))
            {
                Files.write(iFile, (CSV_HEADER + System.lineSeparator()).getBytes(StandardCharsets.UTF_8));
            }

            String iLine = String.join(",",
                    LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")),
                    csv(System.getProperty("testcase", "")),
                    csv(pRole),
                    csv(pHerd),
                    csv(pLogin),
                    csv(pPurpose)) + System.lineSeparator();

            Files.write(iFile, iLine.getBytes(StandardCharsets.UTF_8), StandardOpenOption.APPEND);
        }
        catch (IOException e)
        {
            CommonFunctions.log.warning(LOG_PREFIX + "Could not record " + pHerd + " in " + iFile + " (" + e.getMessage() + ")");
        }
    }

    // Commas would break the simple CSV format - replace them
    private static String csv(String pValue)
    {
        return pValue == null ? "" : pValue.replace(',', ' ').replace('\n', ' ').replace('\r', ' ').trim();
    }
