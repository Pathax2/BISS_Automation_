//Project Specific
// no spaces allowed in app name
def APP = "Playwright-Test"
def BUILD_REF = "${APP}-${BUILD_ID}"

//Environment Specific
def JENKINS_AGENT_IMAGE = "registry.redhat.io/ocp-tools-4/jenkins-agent-base-rhel9:v4.18.0"
def JENKINS_HOME = "/home/jenkins"

def PLAYWRIGHT_IMAGE = "registry.apps.services1.agriculture.gov.ie/openshift/playwright:java-v1.60.0-noble"
def MAVEN_ARGS = "-Dmaven.repo.local=${JENKINS_HOME}/.m2/repository -DproxySet=true -DproxyHost=vsdbahlprxy1 -DproxyPort=8080 -s ./pipeline/settings.xml"

def USER_ID //Global User ID, can be SCM, UI or Null

properties([
    buildDiscarder(logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '', daysToKeepStr: '', numToKeepStr: '5')),
    parameters([
        choice(choices: ['dev', 'sit', 'uat'], description: '', name: 'ENVIRONMENT')
    ]),

    disableConcurrentBuilds(),
])

podTemplate(
    cloud: 'openshift',
    label: BUILD_REF,
    serviceAccount: 'jenkins',
    containers: [

        containerTemplate(
                name: "playwright-java", workingDir: JENKINS_HOME,
                envVars: [
                    envVar(key: 'https_proxy', value: "http://vsdbahlprxy1:8080"),
                    secretEnvVar(key: 'username', secretName: 'mvn-repo-secret', secretKey: 'username'),
                    secretEnvVar(key: 'password', secretName: 'mvn-repo-secret', secretKey: 'password')
                ],
                image: PLAYWRIGHT_IMAGE, ttyEnabled: true, command: 'cat'),
        containerTemplate(
                name: "jnlp", workingDir: JENKINS_HOME,
                image: JENKINS_AGENT_IMAGE)

    ]) {

    timeout(1) {
        node(BUILD_REF) {

            if (["push", "tag_push", "merge_request"].any { el -> el.contains("${GITLAB_OBJECT_KIND}") } ) {
                echo "Ran due to commits on branch, aborting pipeline"
                currentBuild.result = 'SUCCESS'
                return
            }

            try {

                container("jnlp") {

                    stage('Clone source') {
                        checkout scm
                    }
                }

                container("playwright-java") {

                    env.ENV_NAME = params.ENVIRONMENT

                    env.MAVEN_ARGS = MAVEN_ARGS
                    def exitCode = sh(script: "bash run-tests.sh ${env.ENV_NAME}", returnStatus: true)

                    echo "Exit code from tests is: $exitCode"

                }
            } 
            catch (e) {

                echo "Pipeline Failed"
            } 
            finally {
                def currentResult = currentBuild.result ?: 'SUCCESS'

                if (currentResult == 'UNSTABLE') {
                    echo 'This will run only if the run was marked as unstable'
                }

                def previousResult = currentBuild.previousBuild?.result

                if (previousResult != null && previousResult != currentResult) {
                    echo 'This will run only if the state of the Pipeline has changed'
                    echo 'For example, if the Pipeline was previously failing but is now successful'
                }

                // echo 'Always run Cucumber Report'
                // cucumber fileIncludePattern: '**/merged-report.json',
                // sortingMethod: 'ALPHABETICAL'
              }
        }
    }
}


