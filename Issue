// ===================================================================================================================================
// File          : UiHelpers.java
// Package       : commonFunctions
// Description   : Shared Playwright helpers that replace the ~111 direct getDriver() usages found in step definitions
//                 (TC_03, TC_18, TC_13_ENTS, TC_03_ENTS, ...). One implementation instead of ten private copies.
//
//                 Selenium pattern                                        ->  UiHelpers call
//                 ---------------------------------------------------------------------------------------------------
//                 private isVisible(By, int) (10 copies)                  ->  UiHelpers.isVisible("iKey", 5)
//                 getDriver().findElements(By.xpath(x))                   ->  UiHelpers.findAll("iKey")
//                 row.findElement(By.xpath(".//td[...]"))                 ->  row.locator("xpath=.//td[...]")
//                 ((JavascriptExecutor) d).executeScript("arguments[0].click()", e) -> UiHelpers.jsClick(locator)  or  iAction("JSCLICK", ...)
//                 ((JavascriptExecutor) d).executeScript(anyScript, e, v)     -> CommonFunctions.executeScript(anyScript, locator, v)
//                 JS removeAttribute('disabled') + value + dispatchEvent  ->  UiHelpers.setValueByJs(locator, "01/01/2026")
//                 JS un-hide file input + sendKeys(path)                  ->  UiHelpers.uploadFile("iKey", "path")
//                 getDriver().navigate().to(url) / back()                 ->  UiHelpers.navigateTo(url) / navigateBack()
//                 getDriver().manage().deleteAllCookies()                 ->  UiHelpers.clearCookies()
//                 Keys.chord(Keys.CONTROL, "a"), Keys.TAB                 ->  locator.press("ControlOrMeta+A"), press("Tab")
//                 switchTo().window(handle)                               ->  UiHelpers.clickAndSwitchToNewTab("iKey")
//                 switchTo().frame(...)                                   ->  UiHelpers.frame("css=iframe#map").locator(...)
//                 switchTo().alert().accept()                             ->  UiHelpers.acceptNextDialog()   (before the click that opens it)
//                 switchTo().alert().dismiss() / getText()                ->  UiHelpers.dismissNextDialog() / lastDialogText()
//                 file in ~/Downloads                                     ->  UiHelpers.downloadByClicking("iKey")
//                 Thread.sleep(n)                                         ->  delete it; use waitVisible / waitHidden
//
//                 FIRST-MATCH RULE
//                   Selenium findElement() quietly used the first match. Playwright refuses to act on a locator that matches
//                   more than one element ("strict mode violation ... resolved to 4 elements"). Every helper below that
//                   works on ONE element therefore uses .first(), so a locator that matches several rows behaves exactly
//                   as it did in Selenium. findAll() is the only helper that works on all matches.
//
// Author        : Aniket Pathare | aniket.pathare@goverment.ie
// Date Created  : 15-09-2026
// Updated       : 17-09-2026 - isVisible / waitHidden / single-element helpers use the first match (Eco AP toggle rows
//                              failed with a strict mode violation); comment block for every method
// ===================================================================================================================================

