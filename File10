            {
                iMissing.append(iMissing.length() == 0 ? "" : ", ").append(iRowName.trim());
                continue;
            }
            log.info("[PAYMENTS] " + iRowName.trim() + " : BISS " + iRowAmount(iRowName, "bissAmount")
                    + " | CRISS " + iRowAmount(iRowName, "crissAmount") + " | CISYF " + iRowAmount(iRowName, "cisyfAmount"));
        }
