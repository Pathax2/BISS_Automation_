SELECT o.ohs_herd, o.ohs_own_id, o.ohs_hist_no, e.*
FROM   tden_owner_history o
JOIN   vwen_ent_sets e
       ON  e.ent_scheme_year = o.ohs_scheme_year
       AND e.ent_own_id      = o.ohs_own_id
       AND e.ent_hist_no     = o.ohs_hist_no
WHERE  o.ohs_herd        = 'Q1670329'
AND    e.ent_scheme_year = 2026
ORDER BY o.ohs_hist_no, e.ent_num_ents DESC;
