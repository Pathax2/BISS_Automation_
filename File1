-- 6. Key columns of the four views
SELECT table_name, column_name
FROM   all_tab_columns
WHERE  owner = 'BISS_DATA'
AND    table_name IN ('TDBS_APPLICATION_CROP_CALC', 'VWBS_APPLICATION_GAEC7_CALC',
                      'VWBS_APPLICATION_ECO_INFO', 'VWBS_CLAIMED_LAND_EH')
AND    (column_name LIKE '%APP%' OR column_name LIKE '%HERD%' OR column_name LIKE '%YEAR%'
        OR column_name LIKE '%GRASS%' OR column_name LIKE '%MDE%')
ORDER  BY table_name, column_id;

-- 7. Which years have rows, and how many with more than 50% for AP2
SELECT * FROM (
    SELECT * FROM vwbs_application_eco_info
    WHERE  ap2_grassland_perc > 50
)
WHERE ROWNUM <= 5;
