SELECT mde_abbrev, COUNT(DISTINCT app.app_herd_no) AS herds
FROM vwbs_application app, vwbs_application_flag_schemes sch
WHERE app.app_id = sch.app_id
AND   cisyf_ind IS NOT NULL
AND   app.app_applicant_type = 'I'
AND   app.app_year = 2026
GROUP BY mde_abbrev;

SELECT COUNT(DISTINCT app_herd_no) AS herds
FROM vwbs_application
WHERE mde_abbrev = 'RI'
AND   app_applicant_type = 'I'
AND   app_year = 2026;

SELECT DISTINCT curr.app_herd_no
FROM vwbs_application curr
WHERE mde_abbrev = 'RI'
AND   curr.app_applicant_type = 'I'
AND   curr.app_year = 2026
AND   REGEXP_LIKE(curr.app_herd_no, '^[A-Z]')
AND   EXISTS (
        SELECT 1
        FROM vwbs_application prev, vwbs_application_flag_schemes sch
        WHERE prev.app_id      = sch.app_id
        AND   prev.app_herd_no = curr.app_herd_no
        AND   prev.app_year    = 2025
        AND   cisyf_ind IS NOT NULL
      );
