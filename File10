    }

    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theSimTickOnTheBissApplicationSummaryShouldHaveChanged
    // Description   : After a SIM opt-in change the summary tick must be the opposite of what the last read saw.
    //                 Fails when the tick was never read in this scenario, or when it did not change.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the SIM tick on the BISS Application summary should have changed")
    public void theSimTickOnTheBissApplicationSummaryShouldHaveChanged()
    {
        log.info("[STEP] the SIM tick on the BISS Application summary should have changed");
        if (iLastSimTickShown == null)
        {
            throw new AssertionError("The SIM tick was not read before the change - add 'the SIM tick state should be readable on the BISS Application summary' first.");
        }
        boolean iNow = iReadSimTick();
        if (iNow == iLastSimTickShown)
        {
            throw new AssertionError("SIM tick on the BISS Application summary is still " + (iNow ? "present" : "not present")
                    + " after the SIM opt-in change - the summary did not follow the SIM screen.");
        }
        log.info("[STAFF] SIM tick changed: " + (iLastSimTickShown ? "present" : "not present") + " -> " + (iNow ? "present" : "not present"));
        iLastSimTickShown = iNow;
    }

