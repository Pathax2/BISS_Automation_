# ===================================================================================================================================
# File          : application-dev.properties
# Description   : DEV / local laptop overrides for the BISS Playwright framework.
#                 Only keys that differ from application.properties need to be listed here.
#
# Folder        : src/test/resources/config/application-dev.properties
# Activation    : -Denv=dev  (default profile - the Maven "dev" profile is active by default)
#
# Author        : Aniket Pathare | aniket.pathare@goverment.ie
# Date Created  : 10-03-2026
# Updated       : 15-09-2026 - Playwright keys for the department laptop (installed Chrome, no browser download)
# Updated       : 16-09-2026 - Page zoom 67% and JavaScript click fallback
# ===================================================================================================================================

# -----------------------------------------------------------------------------------------------------------------------------------
# Existing keys (unchanged from the Selenium project)
# -----------------------------------------------------------------------------------------------------------------------------------
app.url=
headless=false
explicit.wait.seconds=20
notify.email.enabled=false
db.url=jdbc:oracle:thin:@dev-db-server:1521:BISSDEV
db.username=biss_dev_user

# -----------------------------------------------------------------------------------------------------------------------------------
# Playwright - local laptop behind the department web gateway
# -----------------------------------------------------------------------------------------------------------------------------------
# Use the Google Chrome installed on the laptop (Playwright cannot download its own Chromium through the gateway)
browser.channel=chrome
playwright.skip.browser.download=true

# Full-screen visible window and red outline on each element - handy while watching a run
browser.maximize=true
highlight.enabled=true

# Page zoom, same as Ctrl+minus in Chrome (67 = the Selenium framework setting; try 70 or 80 if a page looks cramped)
browser.zoom.percent=67

# auto = normal click, JavaScript click when blocked | js = always JavaScript click | native = no JavaScript click
click.strategy=auto
click.attempt.timeout.ms=5000

# Slow motion in milliseconds between actions (0 = full speed, 300-500 is good for demos)
playwright.slowmo.ms=0

# SIT uses internal certificates
ignore.https.errors=true

# Keep a Playwright trace zip for failed test cases (open it at https://trace.playwright.dev)
trace.mode=retain-on-failure

# Playwright exception names for the retry analyser (the Selenium names no longer apply)
retry.on.exceptions=TimeoutError,PlaywrightException

# Oracle herd/agent bootstrap - true = same behaviour as the Selenium framework
db.bootstrap=true
