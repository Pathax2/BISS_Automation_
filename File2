    // ***************************************************************************************************************************************************************************************
    // Function Name : hasToken / tableHasToken
    // Description   : True when a value (or any value of a DataTable map) is a runtime token such as {transferor.herd}
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static boolean hasToken(String pValue)
    {
        if (pValue == null) return false;
        String iValue = pValue.trim();
        return iValue.startsWith("{") && iValue.endsWith("}");
    }

    public static boolean tableHasToken(Map<String, String> pTable)
    {
        if (pTable == null) return false;
        for (String iValue : pTable.values())
        {
            if (hasToken(iValue)) return true;
        }
        return false;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : resolve
    // Description   : Replaces a runtime token with the value of the current pair. Plain values come back unchanged.
    //                 Throws with a clear message when a token is used before any pair was picked, or is misspelt.
    // Parameters    : pValue (String) - DataTable cell, e.g. "{transferee.herd}" or "C1010148"
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized String resolve(String pValue)
    {
        if (pValue == null) return null;
        if (!hasToken(pValue)) return pValue.trim();
        if (isAutoAgentToken(pValue)) return resolveAgent(pValue);

        String iToken = pValue.trim().toLowerCase(Locale.ROOT);

        // ETF tokens do not need a transfer pair - they are set by the ETF authorisation step (TC_14_ENTS)
        if ("{etf.code}".equals(iToken) || "{etf.partner}".equals(iToken))
        {
            String iEtfValue = "{etf.code}".equals(iToken) ? iEtfCode : iEtfPartner;
            if (iEtfValue.isEmpty())
            {
                throw new IllegalStateException(LOG_PREFIX + "Token " + pValue.trim() + " used before an ETF was picked. "
                        + "The step \"the individual adds ETF authorisation with the following details\" must run first.");
            }
            return iEtfValue;
        }

        if (iCurrentPair == null)
        {
            throw new IllegalStateException(LOG_PREFIX + "Token " + pValue.trim() + " used before a transfer pair was picked. "
                    + "The step that creates the transfer must run first in this section.");
        }

        if (iCurrentPair.transferee == null && iToken.startsWith("{transferee."))
        {
            throw new IllegalStateException(LOG_PREFIX + "Token " + pValue.trim() + " used before the transferee was picked. "
                    + "The transferor is an individual; the step that creates the transfer must run first in this section.");
        }

        switch (iToken)
        {
            case "{transferor.login}":   return iCurrentPair.agent;
            case "{transferor.herd}":    return iCurrentPair.transferor.herdNumber;
            case "{transferor.name}":    return iCurrentPair.transferor.name;
            case "{transferor.address}": return iCurrentPair.transferor.address;
            case "{transferee.herd}":    return iCurrentPair.transferee.herdNumber;
            case "{transferee.name}":    return iCurrentPair.transferee.name;
            case "{transferee.address}": return iCurrentPair.transferee.address;
            case "{agent}":              return iCurrentPair.agent;
            case "{transferor.agent}":   return iCurrentPair.agent;
            case "{transferee.agent}":   return iCurrentPair.transfereeAgent;
            case "{transferee.login}":   return iCurrentPair.transfereeAgent;
            default:
                throw new IllegalArgumentException(LOG_PREFIX + "Unknown token " + pValue.trim()
                        + ". Use {transferor.herd}, {transferor.name}, {transferee.herd}, {transferee.name}, "
                        + "{transferor.address}, {transferee.address}, {agent}, {transferor.agent}, {transferor.login}, "
                        + "{transferee.agent}, {transferee.login}, {auto.agent}, {etf.code} or {etf.partner}.");
        }
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : etfLogins
    // Description   : Every ETF code with the login of its partner (ENTS query "ENTS ETF logins"), fetched once per run.
    //                 One code can have more than one login; the first in alphabetical order is kept.
    // Returns       : Map<String, String> - read-only, ETF code (upper case, e.g. ETF00009) -> login (e.g. agr15512)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 06-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized Map<String, String> etfLogins()
    {
        if (ETF_LOGINS == null)
        {
            Map<String, String> iLogins = new LinkedHashMap<>();
            for (Map<String, Object> iRow : DBRouter.query("ENTS", "ENTS ETF logins"))
            {
                String iCode  = Objects.toString(iRow.get("ETF_CODE"), "").trim().toUpperCase(Locale.ROOT);
                String iLogin = Objects.toString(iRow.get("LOGIN"), "").trim();
                if (!iCode.isEmpty() && !iLogin.isEmpty()) iLogins.putIfAbsent(iCode, iLogin);
            }
            ETF_LOGINS = Collections.unmodifiableMap(iLogins);
            CommonFunctions.log.info(LOG_PREFIX + "ETF logins loaded: " + ETF_LOGINS.size() + " ETF code(s) with a login.");
        }
        return ETF_LOGINS;
    }

