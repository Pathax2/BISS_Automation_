    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theMapGenerationRequestShouldBeAccepted
    // Description   : Confirms the request was accepted - the first row of the generated maps table reaches
    //                 "Ready to download". Polls the first row: staff.map.poll.attempts (default 500, as Selenium)
    //                 times, staff.map.poll.seconds (default 5) apart.
    //                 Change from Selenium: a first row that is not there yet is logged and polled again (Selenium
    //                 failed at once with NoSuchElementException).
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026 | Updated: 05-10-2026 (Playwright)
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the map generation request should be accepted")
    public void theMapGenerationRequestShouldBeAccepted()
    {
        log.info("[STEP] the map generation request should be accepted");

        int     iAttempts        = ConfigManager.getInt("staff.map.poll.attempts", 500);
        int     iSeconds         = ConfigManager.getInt("staff.map.poll.seconds", 5);
        Locator iFirstRow        = UiHelpers.byXpath(ObjReader.getLocator("iGeneratedMapFirstRow")).first();
        boolean iReadyToDownload = false;

        for (int i = 1; i <= iAttempts; i++)
        {
            String iStatus = UiHelpers.isVisible(iFirstRow, iSeconds) ? iFirstRow.innerText().trim() : "(no first row yet)";
            log.info("Attempt " + i + " | First row status : " + iStatus);

            if (iStatus.contains("Ready to download"))
            {
                log.info("Ready to download found on first row.");
                iReadyToDownload = true;
                iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iGeneratedMapFirstRow"), null);
                break;
            }

            log.info("Waiting for map generation...");
            pause(iSeconds * 1000L);
        }

        if (!iReadyToDownload)
        {
            throw new RuntimeException("'Ready to download' was not displayed on the first row within the expected time ("
                    + iAttempts + " checks, " + iSeconds + " s apart).");
        }
    }

