    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : pressKey
    // Description   : Presses a key on the page (whatever element has focus) - replacement for Actions.sendKeys(Keys.X).
    // Parameters    : pKey (String) - Playwright key name, e.g. Escape, Enter, Tab, ControlOrMeta+A
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void pressKey(String pKey)
