    // Notes/History link, then the History tab, then wait for the newest data row.
    private void iOpenHistoryTab()
    {
        iAction("CLICK",         "XPATH", ObjReader.getLocator("iNavbarLink").replace("{LINK}", "Notes/History"), null);
        iAction("CLICK",         "XPATH", ObjReader.getLocator("iTab").replace("{TAB}", "History"), null);
        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iHistoryFirstRow"), null);
    }

    // Today as the History table shows it (dd/MM/yyyy), in the browser's time zone so a Jenkins agent on UTC
    // does not disagree with the portal between midnight and 1 am.
    private static String iToday()
    {
        String iZone = ConfigManager.getOrDefault("browser.timezone", "Europe/Dublin");
        return java.time.LocalDate.now(java.time.ZoneId.of(iZone)).format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"));
    }

    // Text of the newest Comments cell, for the log only (never fails the step).
    private static String iNewestHistoryComment()
    {
        try
        {
            return UiHelpers.byXpath(ObjReader.getLocator("iHistoryFirstComment")).innerText().trim();
        }
        catch (RuntimeException iIgnored)
        {
            return "(not read)";
        }
    }

