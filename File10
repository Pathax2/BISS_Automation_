        iAction("CLICK",       "XPATH", ObjReader.getLocator("iNavbarLink").replace("{LINK}", "BISS Application"), null);
        iAction("WAITVISIBLE", "XPATH", ObjReader.getLocator("iApplicationSummaryPanel"), null);
        return UiHelpers.isVisible(UiHelpers.byXpath(ObjReader.getLocator("iBissApplicationSimTick")), PROBE_SECONDS);
    }

