// ===================================================================================================================================
// File          : TC_14_ENTS.java
// Package       : stepdefinitions.ENTS
// Description   : ETF Authorisation steps (TC_14_ENTS - an individual adds an ETF authorisation, the ETF partner checks it).
//
//                 Steps in this file (3):
//                   1. the individual adds ETF authorisation with the following details (DataTable)
//                   2. the ETF partner searches for herd {string} and opens it
//                   3. the ETF authorisation should be visible
//
//                 Playwright edition (22-09-2026):
//                   - Same step texts, same ObjectRepository keys, same flow.
//                   - Step 1 checks its Object Repository keys before the first click.
//                   - Step 2 uses EntsSession.openTransferOutHerd, which waits for the row of THAT herd and skips rows
//                     marked expired, instead of Thread.sleep + the first View link.
//                   - Step 3 is unchanged on purpose: the Selenium version only checks that "Create Transfer Application"
//                     is shown on the herd page, not the authorisation row itself.
//
//                 Random ETF (06-10-2026):
//                   - etfCode = {random} picks an ETF from the "Select one ETF" dropdown at random. Only ETFs that are not
//                     already on the authorisation table and that have a partner login in ENTS_DATA are picked, so a data
//                     refresh no longer breaks the test (SMYTH, SHEILA - [ETF00009] disappeared from the dropdown).
//                   - The ETF code and its partner login are kept for the tokens {etf.code} and {etf.partner}; the feature
//                     re-logs in as "{etf.partner}" instead of a fixed agr15512.
//                   - A typed etfCode still works: "SMYTH, SHEILA - [ETF00009]" or just "ETF00009". The option is found by
//                     the code in the brackets, so a changed name in front of the code does not matter.
//                   - The table keys use an {ETF} placeholder (iETF00009TableRow, iETF00009DeleteBtn), filled with the
//                     code in play. The key names are kept from Selenium.
//                   - Change from Selenium: when a typed ETF is already on the table, the row is removed (Remove +
//                     confirm) and added again. Selenium clicked Delete, Remove and then Edit on the removed row, which
//                     cannot work. iETF00009EditBtn and UpdateETABtn are no longer used.
//
// Author        : Aniket Pathare | aniket.pathare@government.ie
// Date Created  : 31-03-2026 | Updated: 22-09-2026 (Playwright) | 06-10-2026 (random ETF, {etf.partner})
// ===================================================================================================================================

package stepdefinitions.ENTS;

import com.microsoft.playwright.Locator;
import commonFunctions.UiHelpers;
import io.cucumber.datatable.DataTable;
import io.cucumber.java.en.*;
import stepdefinitions.Hooks;
import utilities.ConfigManager;
import utilities.EntsTestData;
import utilities.ObjReader;

import java.util.ArrayList;
import java.util.Collections;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Set;
import java.util.logging.Logger;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

import static commonFunctions.CommonFunctions.iAction;
import static stepdefinitions.ENTS.EntsSession.isVisible;

public class TC_14_ENTS
{
    private static final Logger log = Logger.getLogger(TC_14_ENTS.class.getName());

    // ETF code inside an option or a table cell, e.g. "SMYTH, SHEILA - [ETF00009]" -> ETF00009
    private static final Pattern ETF_CODE = Pattern.compile("\\b(ETF\\d+)\\b", Pattern.CASE_INSENSITIVE);

    // ETF code cells of the Entitlements Transfer Facilitator table (first column holds the code only)
    private static final String TABLE_CODE_CELLS_XPATH = "//tr[contains(@class,'mat-mdc-row')]/td[contains(@class,'mat-column-name')]";

    // Options of the open "Select one ETF" panel (rendered in the CDK overlay, outside the dialog)
    private static final String ETF_OPTIONS_XPATH = "//div[contains(@class,'cdk-overlay-pane')]//mat-option";

    // How long to wait for the table, the option list and the new row (ents.etf.wait.seconds, default 15)
    private static final int WAIT_SECONDS = ConfigManager.getInt("ents.etf.wait.seconds", 15);


    // ***************************************************************************************************************************************************************************************
    // Step          : the individual adds ETF authorisation with the following details (DataTable)
    // Description   : Allow Entitlement -> (typed ETF already on the table: Remove + confirm) -> Add ETF Authorisation ->
    //                 pick the ETF -> the two limits -> confirm. The ETF and its partner login are kept for {etf.code}
    //                 and {etf.partner}.
    //
    //                 DataTable keys:
    //                   etfCode          (String) - {random}, or the ETF as shown in the dropdown, e.g.
    //                                               "SMYTH, SHEILA - [ETF00009]", or just "ETF00009"
    //                   txorEntsAllowed  (String) - entitlements allowed as transferor, e.g. "2"
    //                   txeeEntsAllowed  (String) - entitlements allowed as transferee, e.g. "3"
    //
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 31-03-2026 | Updated: 22-09-2026 (Playwright) | 06-10-2026 (random ETF)
    // ***************************************************************************************************************************************************************************************
    @And("the individual adds ETF authorisation with the following details")
    public void theIndividualAddsETFAuthorisation(DataTable pDataTable)
    {
        log.info("[STEP] And the individual adds ETF authorisation with the following details");

        EntsSupport.requireKeys("the individual adds ETF authorisation with the following details",
                "iAllowEntitlementBtn", "iETF00009TableRow", "iETF00009DeleteBtn", "iRemoveETABtn",
                "iAddETFAuthorisationBtn", "iETFAvailableDropdown", "iTxorEntsAllowedField",
                "iTxeeEntsAllowedField", "iAddETFAuthorisationConfirmBtn");

        Map<String, String> iData = pDataTable.asMap(String.class, String.class);

        String  iEtfWanted = value(iData, "etfCode");
        String  iTxor      = EntsTestData.resolve(value(iData, "txorEntsAllowed"));
        String  iTxee      = EntsTestData.resolve(value(iData, "txeeEntsAllowed"));
        boolean iRandom    = iEtfWanted.isEmpty() || "{random}".equalsIgnoreCase(iEtfWanted) || "random".equalsIgnoreCase(iEtfWanted);
        String  iWantedCode = iRandom ? "" : codeOf(iEtfWanted);

        iAction("CLICK", "XPATH", ObjReader.getLocator("iAllowEntitlementBtn"), null);
        isVisible(ObjReader.getLocator("iAddETFAuthorisationBtn"), WAIT_SECONDS);

        Set<String> iOnTable = codesOnTable();
        log.info("[ETF-AUTH] ETFs already authorised: " + (iOnTable.isEmpty() ? "none" : iOnTable));

        if (!iWantedCode.isEmpty() && iOnTable.contains(iWantedCode))
        {
            removeExistingRow(iWantedCode);
        }

        iAction("CLICK", "XPATH", ObjReader.getLocator("iAddETFAuthorisationBtn"), null);
        iAction("CLICK", "XPATH", ObjReader.getLocator("iETFAvailableDropdown"), null);

        if (!isVisible(ETF_OPTIONS_XPATH, WAIT_SECONDS))
        {
            throw new IllegalStateException("[ETF-AUTH] The \"Select one ETF\" list did not open within " + WAIT_SECONDS + " s.");
        }

        List<Locator> iOptions = UiHelpers.findAll(UiHelpers.byXpath(ETF_OPTIONS_XPATH));
        List<String>  iTexts   = new ArrayList<>();
        for (Locator iOption : iOptions) iTexts.add(iOption.innerText().trim());
        log.info("[ETF-AUTH] " + iTexts.size() + " ETF(s) in the dropdown.");

        int iIndex = iRandom ? pickRandomOption(iTexts, iOnTable) : findOption(iTexts, iEtfWanted, iWantedCode);

        String iOptionText = iTexts.get(iIndex);
        String iCode       = codeOf(iOptionText);
        String iPartner    = iCode.isEmpty() ? "" : EntsTestData.etfLogins().getOrDefault(iCode, "");

        iOptions.get(iIndex).click();
        EntsTestData.setEtf(iCode, iPartner);
        log.info("[ETF-AUTH] Selected " + (iRandom ? "random " : "") + "ETF: " + iOptionText
                + (iPartner.isEmpty() ? "" : " | partner login " + iPartner));

        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iTxorEntsAllowedField"), iTxor);
        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iTxeeEntsAllowedField"), iTxee);
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iAddETFAuthorisationConfirmBtn"), null);

        if (!iCode.isEmpty() && isVisible(etfXpath("iETF00009TableRow", iCode), WAIT_SECONDS))
        {
            log.info("[ETF-AUTH] ETF authorisation added: " + iCode + " | txor=" + iTxor + " txee=" + iTxee);
        }
        else
        {
            log.warning("[ETF-AUTH] " + (iCode.isEmpty() ? iOptionText : iCode) + " was submitted but its row is not on the "
                    + "table after " + WAIT_SECONDS + " s - see the screenshot.");
        }
    }


    // ***************************************************************************************************************************************************************************************
    // Step          : the ETF partner searches for herd {string} and opens it
    // Description   : Searches the herd in the ETF partner's list and opens its first not-expired row.
    // Parameters    : pHerd (String) - herd number, e.g. "Y104069X" (a runtime token also works)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 31-03-2026 | Updated: 22-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    @And("the ETF partner searches for herd {string} and opens it")
    public void theETFPartnerSearchesForHerdAndOpensIt(String pHerd)
    {
        String iHerd = EntsTestData.resolve(pHerd);
        log.info("[STEP] And the ETF partner searches for herd " + iHerd + " and opens it");

        EntsSession.openTransferOutHerd(iHerd);
    }


    // ***************************************************************************************************************************************************************************************
    // Step          : the ETF authorisation should be visible
    // Description   : Same check as Selenium: the herd page shows "Create Transfer Application" for the ETF partner.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 31-03-2026 | Updated: 22-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    @Then("the ETF authorisation should be visible")
    public void theETFAuthorisationShouldBeVisible()
    {
        log.info("[STEP] Then the ETF authorisation should be visible");
        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iCreateTransferBtn"), null);
    }


    // ===================================================================================================================================
    //  HELPERS
    // ===================================================================================================================================

    // ***************************************************************************************************************************************************************************************
    // Function Name : pickRandomOption
    // Description   : Index of a random dropdown option whose ETF is not on the table yet, has a partner login in ENTS_DATA
    //                 and whose login has not been seen expired in this run. Fails with the counts when none is left.
    // Parameters    : pTexts (List<String>) - option texts | pOnTable (Set<String>) - ETF codes already authorised
    // Returns       : int - option index
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 06-10-2026
    // ***************************************************************************************************************************************************************************************
    private static int pickRandomOption(List<String> pTexts, Set<String> pOnTable)
    {
        Map<String, String> iLogins     = EntsTestData.etfLogins();
        List<Integer>       iCandidates = new ArrayList<>();
        int iNoCode = 0, iAuthorised = 0, iNoLogin = 0, iExpired = 0;

        for (int i = 0; i < pTexts.size(); i++)
        {
            String iCode = codeOf(pTexts.get(i));
            if (iCode.isEmpty())                  { iNoCode++;     continue; }
            if (pOnTable.contains(iCode))         { iAuthorised++; continue; }
            String iLogin = iLogins.get(iCode);
            if (iLogin == null || iLogin.isEmpty()) { iNoLogin++;  continue; }
            if (Hooks.EXPIRED_AGENTS.contains(iLogin)) { iExpired++; continue; }
            iCandidates.add(i);
        }

        log.info("[ETF-AUTH] Random pick from " + iCandidates.size() + " ETF(s) | skipped: " + iAuthorised + " already authorised, "
                + iNoLogin + " without a partner login, " + iExpired + " with an expired login, " + iNoCode + " without an ETF code");

        if (iCandidates.isEmpty())
        {
            throw new IllegalStateException("[ETF-AUTH] No ETF in the dropdown can be used: " + pTexts.size() + " option(s), "
                    + iAuthorised + " already authorised, " + iNoLogin + " without a partner login in ENTS_DATA, " + iExpired
                    + " with an expired login. Remove an authorisation from the table or type an etfCode in the feature file.");
        }

        Collections.shuffle(iCandidates);
        return iCandidates.get(0);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : findOption
    // Description   : Index of the option for a typed etfCode: by the ETF code when one is given, otherwise by the full text
    //                 (case and outer spaces ignored). Fails with the first options when it is not in the dropdown.
    // Parameters    : pTexts (List<String>) - option texts | pWanted (String) - etfCode cell | pCode (String) - its ETF code
    // Returns       : int - option index
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 06-10-2026
    // ***************************************************************************************************************************************************************************************
    private static int findOption(List<String> pTexts, String pWanted, String pCode)
    {
        for (int i = 0; i < pTexts.size(); i++)
        {
            boolean iMatch = pCode.isEmpty()
                    ? pTexts.get(i).equalsIgnoreCase(pWanted.trim())
                    : pCode.equals(codeOf(pTexts.get(i)));
            if (iMatch) return i;
        }
        throw new IllegalStateException("[ETF-AUTH] " + pWanted + " is not in the \"Select one ETF\" dropdown (likely gone after a "
                + "data refresh). Use {random} in the feature file. First options: "
                + pTexts.subList(0, Math.min(10, pTexts.size())));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : removeExistingRow
    // Description   : Removes a typed ETF that is already authorised, so it can be added again: Remove in its row, the
    //                 confirmation button when a confirmation dialog opens, then waits for the row to go.
    // Parameters    : pCode (String) - ETF code, e.g. "ETF00009"
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 06-10-2026
    // ***************************************************************************************************************************************************************************************
    private static void removeExistingRow(String pCode)
    {
        log.info("[ETF-AUTH] " + pCode + " is already authorised - removing it before adding it again.");
        iAction("CLICK", "XPATH", etfXpath("iETF00009DeleteBtn", pCode), null);

        if (isVisible(ObjReader.getLocator("iRemoveETABtn"), EntsSession.PROBE_SECONDS))
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iRemoveETABtn"), null);
        }
        else
        {
            log.info("[ETF-AUTH] No Remove confirmation shown - the row is removed directly.");
        }

        UiHelpers.waitHidden(UiHelpers.byXpath(etfXpath("iETF00009TableRow", pCode)), WAIT_SECONDS);
        log.info("[ETF-AUTH] " + pCode + " removed from the table.");
    }

    // ETF codes in the first column of the authorisation table (empty when there is no row)
    private static Set<String> codesOnTable()
    {
        Set<String> iCodes = new LinkedHashSet<>();
        for (Locator iCell : UiHelpers.findAll(UiHelpers.byXpath(TABLE_CODE_CELLS_XPATH)))
        {
            String iCode = codeOf(iCell.innerText());
            if (!iCode.isEmpty()) iCodes.add(iCode);
        }
        return iCodes;
    }

    // Object Repository XPath with the {ETF} placeholder filled in
    private static String etfXpath(String pKey, String pCode)
    {
        String iXpath = ObjReader.getLocator(pKey);
        if (!iXpath.contains("{ETF}"))
        {
            log.warning("[ETF-AUTH] " + pKey + " has no {ETF} placeholder, so it only finds the ETF written in it.");
        }
        return iXpath.replace("{ETF}", pCode);
    }

    // "SMYTH, SHEILA - [ETF00009]" or "ETF00009" -> "ETF00009"; "" when the text holds no ETF code
    private static String codeOf(String pText)
    {
        Matcher iM = ETF_CODE.matcher(pText == null ? "" : pText);
        return iM.find() ? iM.group(1).toUpperCase(Locale.ROOT) : "";
    }

    // DataTable cell, trimmed; "" when the key is missing
    private static String value(Map<String, String> pData, String pKey)
    {
        String iValue = pData.get(pKey);
        return iValue == null ? "" : iValue.trim();
    }
}
