    // ***************************************************************************************************************************************************************************************
    // Function Name : nextSameAgentPair
    // Description   : Picks two different, unused herds of the same agent (transferor + transferee), records them in
    //                 the used-herds file, logs them and makes them the current pair.
    // Parameters    : pAgent   (String) - agent login, e.g. "aga6077"
    //                 pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextSameAgentPair(String pAgent, String pPurpose)
    {
        if (pAgent == null || pAgent.isBlank())
        {
            throw new IllegalStateException(LOG_PREFIX + "No agent is logged in, so there is no agent to take herds from. "
                    + "The ENTS login step must run before the transfer is created.");
        }

        String     iAgent     = pAgent.trim();
        List<Herd> iPool      = agentPool(iAgent);
        Set<String> iUsed     = usedHerds();
        List<Herd> iAvailable = new ArrayList<>();

        for (Herd iHerd : iPool)
        {
            if (!iUsed.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }

        if (iAvailable.size() < 2)
        {
            throw new IllegalStateException(LOG_PREFIX + "Agent Login query for " + iAgent + " has " + iAvailable.size()
                    + " unused herd(s) left out of " + iPool.size() + ", and a transfer needs 2. "
                    + "Clear or trim " + usedFile() + ", raise ents.pool.size, or use another agent.");
        }

        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        Herd iTransferor = iAvailable.get(0);
        Herd iTransferee = iAvailable.get(1);

        markUsed("transferor", iTransferor.herdNumber, iAgent, pPurpose);
        markUsed("transferee", iTransferee.herdNumber, iAgent, pPurpose);

        iCurrentPair = new TransferPair(iAgent, iTransferor, iTransferee);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] | Agent=" + iAgent
                + " | Transferor=" + iTransferor + " | Transferee=" + iTransferee
                + " | " + (iAvailable.size() - 2) + " unused herd(s) left in the pool");

        return iCurrentPair;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : nextNoEntitlementPair
    // Description   : Negative-case version of nextSameAgentPair (TC_02_ENTS Section 2). Both herds belong to the same
    //                 agent and are picked at random:
    //                   transferor - an unused herd of the agent with NO entitlements in the scheme year
    //                                (query "ENTS Agent herds without entitlements")
    //                   transferee - an unused herd from the agent's usual Agent Login pool
    //                 Both are recorded in the used-herds file and become the current pair, so {transferor.herd},
    //                 {transferee.herd} and {transferee.name} work as usual.
    // Parameters    : pAgent   (String) - agent login, e.g. "aga6077"
    //                 pPurpose (String) - written to the used-herds file, e.g. the transfer type
    // Returns       : TransferPair
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 23-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized TransferPair nextNoEntitlementPair(String pAgent, String pPurpose)
    {
        if (pAgent == null || pAgent.isBlank())
        {
            throw new IllegalStateException(LOG_PREFIX + "No agent is logged in, so there is no agent to take herds from. "
                    + "The ENTS login step must run before the transfer search.");
        }

        String      iAgent = pAgent.trim();
        Set<String> iUsed  = usedHerds();

        List<Herd> iNoEnts    = noEntitlementPool(iAgent);
        List<Herd> iAvailable = new ArrayList<>();
        for (Herd iHerd : iNoEnts)
        {
            if (!iUsed.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }

        if (iAvailable.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "\"ENTS Agent herds without entitlements\" for " + iAgent
                    + " has no unused herd left out of " + iNoEnts.size() + ". "
                    + "Clear or trim " + usedFile() + ", raise ents.pool.size, or use another agent.");
        }

        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        Herd iTransferor = iAvailable.get(0);

        Set<String> iUsedPlus = new HashSet<>(iUsed);
        iUsedPlus.add(iTransferor.herdNumber);
        Herd iTransferee = pickUnused(iAgent, iUsedPlus, "transferee");

        markUsed("transferor-no-ents", iTransferor.herdNumber, iAgent, pPurpose);
        markUsed("transferee",         iTransferee.herdNumber, iAgent, pPurpose);

        iCurrentPair = new TransferPair(iAgent, iTransferor, iTransferee);

        CommonFunctions.log.info(LOG_PREFIX + "Picked for [" + pPurpose + "] (no entitlements) | Agent=" + iAgent
                + " | Transferor=" + iTransferor + " | Transferee=" + iTransferee
                + " | " + (iAvailable.size() - 1) + " unused no-entitlement herd(s) left");

        return iCurrentPair;
    }


    // ***************************************************************************************************************************************************************************************
    // Function Name : pickUnused
    // Description   : One random herd of an agent that is not in pExclude. Throws with a clear message when the pool
    //                 has no unused herd left.
    // Parameters    : pAgent (String) - agent login | pExclude (Set) - herds already used | pRole (String) - for the message
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Herd pickUnused(String pAgent, Set<String> pExclude, String pRole)
    {
        List<Herd> iPool      = agentPool(pAgent);
        List<Herd> iAvailable = new ArrayList<>();
        for (Herd iHerd : iPool)
        {
            if (!pExclude.contains(iHerd.herdNumber)) iAvailable.add(iHerd);
        }

        if (iAvailable.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "Agent Login query for " + pAgent + " has no unused herd left out of "
                    + iPool.size() + ", and one is needed as the " + pRole + ". "
                    + "Clear or trim " + usedFile() + ", raise ents.pool.size, or use another agent.");
        }

        Collections.shuffle(iAvailable, new Random(System.nanoTime()));
        return iAvailable.get(0);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : usePortalName
    // Description   : Replaces the name of a herd of the current pair with the name shown in the portal.
    //                 The transferee search only matches the exact portal name, and the DB name can differ from it
    //                 (e.g. "Martin Starr" in the DB, "Martin Starr Jnr" in the portal). After this call,
    //                 {transferor.name} / {transferee.name} return the portal name.
    // Parameters    : pHerd (String) - herd number of the current pair | pPortalName (String) - name from the Name column
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void usePortalName(String pHerd, String pPortalName)
    {
        if (iCurrentPair == null || pHerd == null || pPortalName == null || pPortalName.isBlank()) return;

        String iName = pPortalName.trim().replaceAll("\\s+", " ");
        Herd   iOr   = iCurrentPair.transferor;
        Herd   iEe   = iCurrentPair.transferee;

        if (iOr.herdNumber.equalsIgnoreCase(pHerd.trim()) && !iName.equals(iOr.name))
        {
            CommonFunctions.log.info(LOG_PREFIX + "Transferor " + iOr.herdNumber + " name: DB='" + iOr.name + "' portal='" + iName + "' - using the portal name");
            iOr = new Herd(iOr.herdNumber, iName, iOr.address);
        }
        else if (iEe.herdNumber.equalsIgnoreCase(pHerd.trim()) && !iName.equals(iEe.name))
        {
            CommonFunctions.log.info(LOG_PREFIX + "Transferee " + iEe.herdNumber + " name: DB='" + iEe.name + "' portal='" + iName + "' - using the portal name");
            iEe = new Herd(iEe.herdNumber, iName, iEe.address);
        }
        else
        {
            return;
        }
        iCurrentPair = new TransferPair(iCurrentPair.agent, iOr, iEe);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : agentPool
    // Description   : Rows of the Agent Login query for one agent, fetched once per run and cached
    // Parameters    : pAgent (String) - agent login
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static List<Herd> agentPool(String pAgent)
    {
        String     iKey    = pAgent.toLowerCase(Locale.ROOT);
        List<Herd> iCached = AGENT_POOLS.get(iKey);
        if (iCached != null) return iCached;

        int    iLimit = ConfigManager.getInt("ents.pool.size", 200);
        String iYear  = ConfigManager.getOrDefault("ents.scheme.year", "").trim();
        String iType  = ConfigManager.getOrDefault("ents.cust.type", "").trim();
        String iTwo   = ConfigManager.getBool("ents.name.two.words", true) ? "Y" : "";
        long   iStart = System.currentTimeMillis();

        CommonFunctions.log.info(LOG_PREFIX + "Running Agent Login query for " + pAgent + " (up to " + iLimit + " rows"
                + (iYear.isEmpty() ? ", all scheme years" : ", scheme year " + iYear)
                + (iType.isEmpty() ? ", all customer types" : ", cust_type " + iType)
                + (iTwo.isEmpty() ? "" : ", two-word names only") + ")...");
        DBRouter.runDB("ENTS", "ENTS Agent Login herds", pAgent, String.valueOf(iLimit), iYear, iType, iTwo);

        List<Herd> iPool = new ArrayList<>();
        for (Map<String, Object> iRow : DBRouter.getRows())
        {
            String iHerd = text(iRow, "HERD_NUMBER");
            if (!iHerd.isEmpty())
            {
                iPool.add(new Herd(iHerd, text(iRow, "HERD_NAME"), text(iRow, "ADDRESSLINE1")));
            }
        }

        CommonFunctions.log.info(LOG_PREFIX + "Agent Login query for " + pAgent + " returned " + iPool.size()
                + " herd(s) in " + (System.currentTimeMillis() - iStart) / 1000 + " s");

        if (iPool.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "Agent Login query returned no herds for " + pAgent
                    + ". Check the agent login, or run the query in SQL Developer on CENTEST_ENTS_DATA.");
        }

        AGENT_POOLS.put(iKey, iPool);
        return iPool;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : noEntitlementPool
    // Description   : Herds of one agent with NO entitlements in the scheme year, fetched once per run and cached.
    //                 Scheme year = ents.scheme.year, or the current year when that is blank (the query needs a year).
    //                 No two-word name filter: the transferor name is never typed.
    // Parameters    : pAgent (String) - agent login
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 23-09-2026
    // ***************************************************************************************************************************************************************************************
    private static List<Herd> noEntitlementPool(String pAgent)
    {
        String     iKey    = pAgent.toLowerCase(Locale.ROOT);
        List<Herd> iCached = NO_ENTS_POOLS.get(iKey);
        if (iCached != null) return iCached;

        int    iLimit = ConfigManager.getInt("ents.pool.size", 200);
        String iYear  = ConfigManager.getOrDefault("ents.scheme.year", "").trim();
        if (iYear.isEmpty()) iYear = String.valueOf(LocalDate.now().getYear());
        String iType  = ConfigManager.getOrDefault("ents.cust.type", "").trim();
        long   iStart = System.currentTimeMillis();

        CommonFunctions.log.info(LOG_PREFIX + "Running \"ENTS Agent herds without entitlements\" for " + pAgent
                + " (up to " + iLimit + " rows, scheme year " + iYear
                + (iType.isEmpty() ? ", all customer types" : ", cust_type " + iType) + ")...");
        DBRouter.runDB("ENTS", "ENTS Agent herds without entitlements", pAgent, String.valueOf(iLimit), iYear, iType);

        List<Herd> iPool = new ArrayList<>();
        for (Map<String, Object> iRow : DBRouter.getRows())
        {
            String iHerd = text(iRow, "HERD_NUMBER");
            if (!iHerd.isEmpty())
            {
                iPool.add(new Herd(iHerd, text(iRow, "HERD_NAME"), text(iRow, "ADDRESSLINE1")));
            }
        }

        CommonFunctions.log.info(LOG_PREFIX + "\"ENTS Agent herds without entitlements\" for " + pAgent + " returned "
                + iPool.size() + " herd(s) in " + (System.currentTimeMillis() - iStart) / 1000 + " s");

        if (iPool.isEmpty())
        {
            throw new IllegalStateException(LOG_PREFIX + "No herd without entitlements found for " + pAgent
                    + " in scheme year " + iYear + ". Check ents.scheme.year, or run the query in SQL Developer on CENTEST_ENTS_DATA.");
        }

        NO_ENTS_POOLS.put(iKey, iPool);
        return iPool;
    }

    private static String text(Map<String, Object> pRow, String pColumn)
    {
        return Objects.toString(pRow.get(pColumn), "").trim();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markNotFound
    // Description   : Records that a picked herd could not be found on screen (for example not in the agent's
    //                 Transfer Out list). The herd is already in the used-herds file, so it is never picked again;
    //                 this extra line only explains why, for whoever reads the file.
    // Parameters    : pHerd   (String) - herd number
    //                 pReason (String) - short reason, e.g. "not in Transfer Out list"
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void markNotFound(String pHerd, String pReason)
    {
        String iAgent = iCurrentPair == null ? iLoggedInUser : iCurrentPair.agent;
        markUsed("not-found", pHerd, iAgent, pReason);
        CommonFunctions.log.warning(LOG_PREFIX + "Herd " + pHerd + " skipped: " + pReason);
    }

    // =================================================================================================
    // USED-HERDS FILE
    // =================================================================================================

    private static Path usedFile()
    {
        return Paths.get(ConfigManager.getOrDefault("ents.used.herds.file", "runtime-data/ents_used_herds.csv"));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : usedHerds
    // Description   : Herds that must not be picked: those handed out in this run, plus (when ents.skip.used.herds=true)
    //                 every herd listed in the used-herds file from earlier runs.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Set<String> usedHerds()
    {
        Set<String> iUsed = new HashSet<>(USED_THIS_RUN);

        if (!ConfigManager.getBool("ents.skip.used.herds", true)) return iUsed;

        Path iFile = usedFile();
        if (!Files.exists(iFile)) return iUsed;

        try
        {
            for (String iLine : Files.readAllLines(iFile, StandardCharsets.UTF_8))
            {
                String[] iCells = iLine.split(",", -1);
                if (iCells.length >= 4 && !iCells[3].isBlank() && !"herd".equalsIgnoreCase(iCells[3].trim()))
                {
                    iUsed.add(iCells[3].trim());
                }
            }
        }
        catch (IOException e)
        {
            CommonFunctions.log.warning(LOG_PREFIX + "Could not read " + iFile + " (" + e.getMessage()
                    + ") - only herds used in this run are skipped.");
        }
        return iUsed;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markUsed
    // Description   : Adds one line to the used-herds file. A write failure is logged, never fatal.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void markUsed(String pRole, String pHerd, String pLogin, String pPurpose)
    {
        USED_THIS_RUN.add(pHerd);

        Path iFile = usedFile();
        try
        {
            if (iFile.getParent() != null) Files.createDirectories(iFile.getParent());
            if (!Files.exists(iFile))
            {
                Files.write(iFile, (CSV_HEADER + System.lineSeparator()).getBytes(StandardCharsets.UTF_8));
            }

            String iLine = String.join(",",
                    LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")),
                    csv(System.getProperty("testcase", "")),
                    csv(pRole),
                    csv(pHerd),
                    csv(pLogin),
                    csv(pPurpose)) + System.lineSeparator();

            Files.write(iFile, iLine.getBytes(StandardCharsets.UTF_8), StandardOpenOption.APPEND);
        }
        catch (IOException e)
        {
            CommonFunctions.log.warning(LOG_PREFIX + "Could not record " + pHerd + " in " + iFile + " (" + e.getMessage() + ")");
        }
    }

    // Commas would break the simple CSV format - replace them
    private static String csv(String pValue)
    {
        return pValue == null ? "" : pValue.replace(',', ' ').replace('\n', ' ').replace('\r', ' ').trim();
    }
}
