-- 1. Columns of the crop tables (Q103 uses these)
SELECT table_name, column_name, data_type
FROM   all_tab_columns
WHERE  table_name IN ('TSBS_CROP', 'TSBS_CROP_USAGE')
ORDER  BY table_name, column_id;

-- 2. Crop rows that mention grass
SELECT *
FROM   tsbs_crop
WHERE  UPPER(TO_CHAR(crp_desc)) LIKE '%GRASS%'
AND    ROWNUM <= 50;
-- If crp_desc does not exist, use this instead and look for the description column:
-- SELECT * FROM tsbs_crop WHERE ROWNUM <= 20;

-- 3. Same for crop usage
SELECT * FROM tsbs_crop_usage WHERE ROWNUM <= 30;

-- 4. Where the crop is stored on a claimed parcel
SELECT table_name, column_name
FROM   all_tab_columns
WHERE  table_name IN ('TDBS_APPLICATION_LAND', 'VWBS_APPLICATION_LAND')
ORDER  BY table_name, column_id;

-- 5. Any other table or view with a grass column
SELECT owner, table_name, column_name
FROM   all_tab_columns
WHERE  column_name LIKE '%GRASS%'
ORDER  BY owner, table_name;
