    // ***************************************************************************************************************************************************************************************
    // Function Name : isAutoAgentToken / resolveAgent / rankedAgents
    // Description   : {auto.agent} = the agent with the most usable herds, other than the logged-in agent and the
    //                 current transferor agent; {auto.agent.N} = the N-th best. The pick is made once per scenario and
    //                 kept, so the transfereeAgent row, the re-login step and the acceptance steps all get the same
    //                 agent. Plain logins are returned unchanged, so every pair method can call resolveAgent safely.
    //
    //                 Ranking, first that answers:
    //                   1. Test Data Vault - ENTS_AGENT pools by AVAILABLE rows (what can actually be used today)
    //                   2. vault.meta top.agents - stored by TC_00_DATA from the "ENTS Top agents" query
    //                   3. live query "ENTS Top agents" (cached for the run)
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static boolean isAutoAgentToken(String pValue)
    {
        return pValue != null && pValue.trim().toLowerCase(Locale.ROOT).startsWith("{auto.agent");
    }

    public static synchronized String resolveAgent(String pValue)
    {
        if (!isAutoAgentToken(pValue)) return pValue == null ? "" : pValue.trim();

        String iToken = pValue.trim().toLowerCase(Locale.ROOT);
        int    iIndex = 1;
        if (iToken.startsWith("{auto.agent.") && iToken.endsWith("}"))
        {
            try { iIndex = Math.max(1, Integer.parseInt(iToken.substring("{auto.agent.".length(), iToken.length() - 1).trim())); }
            catch (NumberFormatException e)
            {
                throw new IllegalArgumentException(LOG_PREFIX + "Unknown token " + pValue.trim() + ". Use {auto.agent} or {auto.agent.2}, {auto.agent.3}, ...");
            }
        }
        if (AUTO_AGENTS.containsKey(iIndex)) return AUTO_AGENTS.get(iIndex);

        // Never the agent who is logged in or who owns the transferor herd - a transfer needs two different agents
        Set<String> iExclude = new HashSet<>();
        if (!iLoggedInUser.isEmpty()) iExclude.add(iLoggedInUser.toLowerCase(Locale.ROOT));
        if (iCurrentPair != null && iCurrentPair.agent != null) iExclude.add(iCurrentPair.agent.toLowerCase(Locale.ROOT));

        int iRank = 0;
        for (String iAgent : rankedAgents())
        {
            if (iExclude.contains(iAgent.toLowerCase(Locale.ROOT)) || TestDataVault.isLoginExpired(iAgent)) continue;
            iRank++;
            if (iRank == iIndex)
            {
                AUTO_AGENTS.put(iIndex, iAgent);
                CommonFunctions.log.info(LOG_PREFIX + pValue.trim() + " -> " + iAgent
                        + (iExclude.isEmpty() ? "" : " (skipped " + iExclude + ")") + " - kept for the rest of the scenario.");
                return iAgent;
            }
        }
        throw new IllegalStateException(LOG_PREFIX + "No agent with usable herds found for " + pValue.trim()
                + " (excluded " + iExclude + "). Run TC_00_DATA, or check the \"ENTS Top agents\" query.");
    }

    public static synchronized List<String> rankedAgents()
    {
        // 1. the vault: what is really available right now
        if (TestDataVault.isEnabled())
        {
            List<Map.Entry<String, Integer>> iPools = new ArrayList<>();
            for (Map.Entry<String, Integer> iEntry : TestDataVault.availableCounts().entrySet())
            {
                if (iEntry.getKey().startsWith(TestDataVault.POOL_ENTS_AGENT + "/") && iEntry.getValue() > 0) iPools.add(iEntry);
            }
            if (!iPools.isEmpty())
            {
                iPools.sort((a, b) -> b.getValue() - a.getValue() != 0 ? b.getValue() - a.getValue() : a.getKey().compareTo(b.getKey()));
                List<String> iRanked = new ArrayList<>();
                for (Map.Entry<String, Integer> iEntry : iPools) iRanked.add(iEntry.getKey().substring(TestDataVault.POOL_ENTS_AGENT.length() + 1));
                CommonFunctions.log.info(LOG_PREFIX + "Agent ranking from the vault: " + iPools);
                return iRanked;
            }
            // 2. the ranking TC_00_DATA stored
            List<String> iStored = TestDataVault.topAgents();
            if (!iStored.isEmpty())
            {
                CommonFunctions.log.info(LOG_PREFIX + "Agent ranking from vault.meta: " + iStored);
                return iStored;
            }
        }
        // 3. live
        if (RANKED_AGENTS == null)
        {
            RANKED_AGENTS = topAgentsLive(ConfigManager.getInt("data.auto.agents.rank", 10));
            CommonFunctions.log.info(LOG_PREFIX + "Agent ranking from the Top agents query: " + RANKED_AGENTS);
        }
        return RANKED_AGENTS;
    }

    // Runs "ENTS Top agents" and returns the logins, most herds first (shared with DataHarvester)
    public static List<String> topAgentsLive(int pHowMany)
    {
        String iYear = ConfigManager.getOrDefault("ents.scheme.year", "").trim();
        String iType = ConfigManager.getOrDefault("ents.cust.type", "").trim();
        String iTwo  = ConfigManager.getBool("ents.name.two.words", true) ? "Y" : "";
        String iLike = ConfigManager.getOrDefault("data.auto.agents.like", "ag%").trim();
        List<String> iRanked = new ArrayList<>();
        for (Map<String, Object> iRow : DBRouter.query("ENTS", "ENTS Top agents", String.valueOf(pHowMany), iYear, iType, iTwo, iLike))
        {
            String iLogin = text(iRow, "AGENT_LOGIN");
            if (!iLogin.isEmpty()) iRanked.add(iLogin);
        }
        return iRanked;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : resolveTable
    // Description   : Returns a copy of a DataTable map with every token replaced (keys and order kept)
    // Parameters    : pTable (Map) - the DataTable as a key/value map
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Map<String, String> resolveTable(Map<String, String> pTable)
    {
        Map<String, String> iResolved = new LinkedHashMap<>();
        for (Map.Entry<String, String> iEntry : pTable.entrySet())
        {
            iResolved.put(iEntry.getKey(), resolve(iEntry.getValue()));
        }
        return iResolved;
    }

    // =================================================================================================
