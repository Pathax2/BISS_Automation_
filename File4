# ------------------------------------------------ ETF Authorisation (TC_14_ENTS) - 06-10-2026 ------------------------------------------------
# Individual -> Transfers -> Allow Entitlement Transfer Facilitators. Key names kept from Selenium.
# {ETF} is filled at runtime with the ETF code in play, e.g. ETF00038 (the table's first column holds the code only).
 
# Allow Entitlement Transfer Facilitators - the <br> splits the label, so both halves are matched separately
iAllowEntitlementBtn                = //button[contains(@class,'nav-button') and contains(normalize-space(.),'Allow Entitlement') and contains(normalize-space(.),'Transfer Facilitators')]
 
# Add ETF Authorisation - opens the etf-add-dialog
iAddETFAuthorisationBtn             = //button[.//span[contains(@class,'mdc-button__label') and normalize-space()='Add ETF Authorisation']]
 
# Select one ETF - mat-select; the step opens it and clicks an option of the CDK overlay
iETFAvailableDropdown               = //mat-dialog-container//mat-select[@formcontrolname='etfAvailable']
 
# Transfer Ents Out / Transfer Ents In - number inputs
iTxorEntsAllowedField               = //mat-dialog-container//input[@formcontrolname='txorEntsAllowed']
iTxeeEntsAllowedField               = //mat-dialog-container//input[@formcontrolname='txeeEntsAllowed']
 
# Add Entitlements Transfer Facilitator Authorisation - submit button of the add dialog (Cancel is type=button)
iAddETFAuthorisationConfirmBtn      = //etf-add-dialog//mat-dialog-actions//button[@type='submit']
 
# Row of one ETF in the authorisation table
iETF00009TableRow                   = //tr[contains(@class,'mat-mdc-row')][td[contains(@class,'mat-column-name') and normalize-space()='{ETF}']]
 
# Remove button of that row (Selenium named it Delete; the screen says Remove)
iETF00009DeleteBtn                  = //tr[contains(@class,'mat-mdc-row')][td[contains(@class,'mat-column-name') and normalize-space()='{ETF}']]//td[contains(@class,'mat-column-editRemove')]//button[normalize-space()='Remove']
 
# Edit button of that row - not used since 06-10-2026 (a typed ETF already on the table is removed and added again)
iETF00009EditBtn                    = //tr[contains(@class,'mat-mdc-row')][td[contains(@class,'mat-column-name') and normalize-space()='{ETF}']]//td[contains(@class,'mat-column-editRemove')]//button[normalize-space()='Edit']
 
# NOT VERIFIED (dialog not seen yet): confirm button of the dialog after Remove. The step clicks it only when shown.
iRemoveETABtn                       = //mat-dialog-container//button[contains(normalize-space(.),'Remove')]
 
# NOT VERIFIED and not used since 06-10-2026: save button of the Edit dialog
UpdateETABtn                        = //mat-dialog-container//button[@type='submit' or contains(normalize-space(.),'Update')]
