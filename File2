        // 27-10-2026: the confirmation dialog is not always shown - Submit Changes can go straight to the Application
        // Summary. OK is clicked only when the poll above saw it; otherwise the step logs it and carries on.
        if (pConfirm)
        {
            if (iOkButton.equals(iShown))
            {
                try
                {
                    iAction("CLICK", "XPATH", iOkButton, null);
                }
                catch (RuntimeException iGone)
                {
                    // The dialog closed between the poll and the click - nothing left to confirm
                    log.warning("[STAFF] Confirmation OK could not be clicked (dialog already closed): " + iGone.getMessage());
                }
            }
            else
            {
                log.info("[STAFF] No confirmation dialog after Submit Changes within " + iWaitSeconds
                        + " s - nothing to confirm (current page: " + CommonFunctions.getPage().url() + ").");
            }
        }
    }
