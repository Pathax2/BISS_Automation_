    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theQueryLetterPreviewShouldBeDisplayed
    // Description   : Previews the drafted letter and confirms it renders before it would be issued.
    //                 15-10-2026: the preview may open as a new tab (the PDF, like the generated map) or inside the
    //                 page. A new tab within staff.preview.tab.seconds (default 20) is logged and closed; otherwise
    //                 the in-page preview must be visible. Neither: the step fails. Selenium only clicked Preview.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the query letter preview should be displayed")
    public void theQueryLetterPreviewShouldBeDisplayed()
    {
        log.info("[STEP] the query letter preview should be displayed");

        Page iMainPage = CommonFunctions.getPage();
        int  iSeconds  = ConfigManager.getInt("staff.preview.tab.seconds", 20);

        try
        {
            Page iPreviewTab = CommonFunctions.getContext().waitForPage(
                    new BrowserContext.WaitForPageOptions().setTimeout(iSeconds * 1000d),
                    () -> iAction("CLICK", "XPATH", ObjReader.getLocator("iPreviewButton"), null));
            log.info("[STAFF] Query letter preview opened in a new tab: " + iPreviewTab.url() + " - closing it.");
            iPreviewTab.close();
            PlaywrightFactory.switchToPage(iMainPage);
            return;
        }
        catch (TimeoutError iNoTab)
        {
            PlaywrightFactory.switchToPage(iMainPage);
            log.info("[STAFF] No preview tab within " + iSeconds + "s - looking for the preview in the page.");
        }

        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iQueryLetterPreviewPanel"), null);
    }

