-- Which ETF codes have a login, and what it is
SELECT businessid, username
FROM   vw_sso_roles_for_user_ents
WHERE  businessid LIKE 'ETF%'
AND    ROWNUM <= 30;

-- Which ETF the current partner logins belong to
SELECT businessid, username
FROM   vw_sso_roles_for_user_ents
WHERE  LOWER(username) IN ('agr15512', 'agr15678');
