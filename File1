
    // ===================================================================================================================================
    //  LOGIN
    // ===================================================================================================================================

    // ***************************************************************************************************************************************************************************************
    // Function Name : loginAs
    // Description   : Full Keycloak login for any ENTS user (agent, individual or ETF partner).
    //                 Same sequence as the Selenium ENTS login steps:
    //                   username -> Continue -> password (TD:Password) -> Login
    //                   PIN screen:  PIN slots 1-7 -> PIN Login -> new-user Next screens -> T&C -> TOTP 111111 -> T&C
    //                   otherwise :  OTP 111111 -> Login
    //                 If the username box is not on screen (for example after an earlier section left the portal open),
    //                 the base URL is opened first.
    //                 Records the user in EntsTestData so a same-agent transfer knows whose herds to use.
    //
    //                 Change from Selenium: "Account Expired" now fails the step with the user name in the message.
    //                 The Selenium copies called Hooks.markAgentExpired() for the BISS runtime agent (a different user)
    //                 and then logged in again as the same expired ENTS user, which could never succeed.
    //
    // Parameters    : pUsername  (String) - login name, e.g. "aga6077", "agr15512", "PADDYMORGAN"
    //                 pLogPrefix (String) - log prefix, e.g. "[LOGIN]"
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026 (merged from TC_03_ENTS, TC_07_ENTS and TC_08_ENTS)
    // ***************************************************************************************************************************************************************************************
    static void loginAs(String pUsername, String pLogPrefix)
    {
        log.info(pLogPrefix + " Logging in as: " + pUsername);

        if (!isVisible(ObjReader.getLocator("iUsernametxtbox"), PROBE_SECONDS))
        {
            log.info(pLogPrefix + " Username box not on screen - opening the base URL first.");
            UiHelpers.navigateTo(Hooks.iUrl);
        }

        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iUsernametxtbox"),      pUsername);
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iUsernameContinuebtn"), null);
        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iPasswordtxtbox"),      "TD:Password");
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iLoginbtn"),            null);

        // -- Account Expired -------------------------------------------------------------------------------------
        String iExpiredXpath = "//*[contains(@class,'kc-feedback-text') and contains(normalize-space(),'Account Expired')]";
        if (isVisible(iExpiredXpath, PROBE_SECONDS))
        {
            throw new IllegalStateException(pLogPrefix + " SSO account expired for " + pUsername
                    + ". Use another login in the feature file or ask for the account to be renewed.");
        }

        // -- PIN + TOTP, or OTP only -----------------------------------------------------------------------------
        if (isVisible(ObjReader.getLocator("iPinForm"), PROBE_SECONDS))
        {
            log.info(pLogPrefix + " PIN screen detected.");
            fillPinSlots(pLogPrefix);
            iAction("CLICK", "XPATH", ObjReader.getLocator("iPinLoginBtn"), null);
            log.info(pLogPrefix + " PIN login submitted.");

            enterMobileNumberIfAsked(pLogPrefix);

            acceptTermsIfShown(pLogPrefix, 2);

            // New-user introduction screens - click Next while it is there (Selenium clicked 7 times blindly)
            for (int iNext = 1; iNext <= 7; iNext++)
            {
                if (!isVisible(ObjReader.getLocator("iNextBtnNewUser"), iNext == 1 ? PROBE_SECONDS : 1)) break;
                iAction("CLICK", "XPATH", ObjReader.getLocator("iNextBtnNewUser"), null);
                log.info(pLogPrefix + " New-user Next clicked (" + iNext + ")");
            }

            iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iTOTPtextbox"),   "111111");
            iAction("CLICK",   "XPATH", ObjReader.getLocator("iTOTPsubmitBtn"), null);
            log.info(pLogPrefix + " TOTP submitted.");

            acceptTermsIfShown(pLogPrefix, PROBE_SECONDS);
        }
        else
        {
            iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iOPTtxtbox"), "111111");
            iAction("CLICK",   "XPATH", ObjReader.getLocator("iLoginbtn"),  null);
            log.info(pLogPrefix + " OTP login submitted.");
        }

        EntsTestData.setLoggedInUser(pUsername);
        log.info(pLogPrefix + " Login complete----------------------------------------------------------: " + pUsername);
    }

    // Types '1' into every enabled PIN slot (data-index 1 to 7) - same as TC_03.fillPinSlots
    private static void fillPinSlots(String pLogPrefix)
    {
        for (int idx = 1; idx <= 7; idx++)
        {
            String iSlotXpath = ObjReader.getLocator("iPinInputIndex").replace("{idx}", String.valueOf(idx));

            if (!isVisible(iSlotXpath, 1))
            {
                log.info(pLogPrefix + " PIN index " + idx + " not present - skipping.");
                continue;
            }

            Locator iInput = xp(iSlotXpath).first();
            if (iInput.getAttribute("disabled") == null && iInput.isEnabled())
            {
                iInput.fill("");
                iInput.pressSequentially("1");
                log.info(pLogPrefix + " Entered '1' into PIN index: " + idx);
            }
            else
            {
                log.info(pLogPrefix + " PIN index " + idx + " is DISABLED - skipping.");
            }
        }
    }

    // Mobile number form shown by Keycloak after the PIN for some users (seen for individuals, TC_03_IND 25-09-2026)
    private static final String MOBILE_NUMBER_INPUT_XPATH = "//form[@id='kc-totp-login-form']//input[@id='mobile_number']";
    private static final String MOBILE_VALIDATE_BTN_XPATH = "//form[@id='kc-totp-login-form']//button[@id='kc-login']";

    // Enters login.test.mobile (default 1111111111) and clicks Validate when the mobile number form is shown
    private static void enterMobileNumberIfAsked(String pLogPrefix)
    {
        if (!isVisible(MOBILE_NUMBER_INPUT_XPATH, 2)) return;

        String iMobile = ConfigManager.getOrDefault("login.test.mobile", "1111111111").trim();
        iAction("TEXTBOX", "XPATH", MOBILE_NUMBER_INPUT_XPATH, iMobile);
        iAction("CLICK",   "XPATH", MOBILE_VALIDATE_BTN_XPATH, null);
        log.info(pLogPrefix + " Mobile number form shown - entered " + iMobile + " and clicked Validate.");
    }

    // Ticks and accepts Terms & Conditions when the screen is shown
    private static void acceptTermsIfShown(String pLogPrefix, int pSeconds)
    {
        if (isVisible(ObjReader.getLocator("iAcceptTermsCheckbox"), pSeconds))
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iAcceptTermsCheckbox"), null);
            iAction("CLICK", "XPATH", ObjReader.getLocator("iAcceptTermsBtn"),      null);
            log.info(pLogPrefix + " Terms & Conditions accepted.");
        }
    }
