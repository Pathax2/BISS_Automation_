    // ***************************************************************************************************************************************************************************************
    // Function Name : toSelector
    // Description   : Converts the framework IdentifyBy + locator value into a Playwright selector string.
    //                   XPATH           -> xpath=<value>        (all current Object Repository entries)
    //                   ID / NAME       -> css=[id="..."] / css=[name="..."]
    //                   CSS             -> css=<value>
    //                   CLASSNAME       -> css=[class~="..."]
    //                   TAGNAME         -> css=<tag>
    //                   LINKTEXT        -> css=a:text-is("...")
    //                   PARTIALLINKTEXT -> css=a:has-text("...")
    //                   PLAYWRIGHT      -> value used as-is (text=..., role=..., data-testid=..., chained >> selectors)
    // Parameters    : pIdentifyBy (String) - locator strategy
    //                 pObjectName (String) - locator value
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static String toSelector(String pIdentifyBy, String pObjectName)
    {
        String iValue = pObjectName.trim();

        switch (pIdentifyBy.trim().toUpperCase(Locale.ROOT))
        {
            case "XPATH":
                return iValue.startsWith("xpath=") ? iValue : "xpath=" + iValue;

            case "ID":
                return "css=[id=" + cssQuote(iValue) + "]";

            case "NAME":
                return "css=[name=" + cssQuote(iValue) + "]";

            case "CSS":
            case "CSSSELECTOR":
            case "CSS_SELECTOR":
                return iValue.startsWith("css=") ? iValue : "css=" + iValue;

            case "CLASSNAME":
            case "CLASS_NAME":
                return "css=[class~=" + cssQuote(iValue) + "]";

            case "TAGNAME":
            case "TAG_NAME":
                return "css=" + iValue;

            case "LINKTEXT":
            case "LINK_TEXT":
                return "css=a:text-is(" + cssQuote(iValue) + ")";

            case "PARTIALLINKTEXT":
            case "PARTIAL_LINK_TEXT":
                return "css=a:has-text(" + cssQuote(iValue) + ")";

            case "PLAYWRIGHT":
            case "PW":
            case "SELECTOR":
                return iValue;

            default:
                throw new RuntimeException("Unsupported IdentifyBy value : '" + pIdentifyBy
                        + "'. Supported values: ID, NAME, XPATH, CSS, CSSSELECTOR, CSS_SELECTOR, CLASSNAME, CLASS_NAME, "
                        + "TAGNAME, TAG_NAME, LINKTEXT, LINK_TEXT, PARTIALLINKTEXT, PARTIAL_LINK_TEXT, PLAYWRIGHT");
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : getLocator
    // Description   : Returns a Playwright Locator for the current page.
    //                 locator.strict=false (default) -> first match, same behaviour as Selenium findElement().
    //                 locator.strict=true            -> Playwright strict mode (fails when more than one element matches).
    // Parameters    : pIdentifyBy (String) - locator strategy
    //                 pObjectName (String) - locator value
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Locator getLocator(String pIdentifyBy, String pObjectName)
    {
        Locator iLocator = requirePage().locator(toSelector(pIdentifyBy, pObjectName));
        return iStrictLocators ? iLocator : iLocator.first();
    }

    private static Locator.WaitForOptions waitState(WaitForSelectorState pState, double pTimeoutMs)
    {
        return new Locator.WaitForOptions().setState(pState).setTimeout(pTimeoutMs);
    }

    private static void waitVisible(Locator pLocator)
    {
        pLocator.waitFor(waitState(WaitForSelectorState.VISIBLE, iActionTimeoutMs));
    }

