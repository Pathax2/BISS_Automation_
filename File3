    // Staff Check Sum of Net Payment Amounts
    public Double StaffCalculateTotalNetPayments() {
        By BissNetAmount = By.xpath("//p[contains(text(),'Net Payment Amount')]/ancestor::tr/descendant::td[contains(@class,'cdk-column-bissAmount')]");
        By CrissNetAmount = By.xpath("//p[contains(text(),'Net Payment Amount')]/ancestor::tr/descendant::td[contains(@class,'cdk-column-crissAmount')]");
        By CisyfNetAmount = By.xpath("//p[contains(text(),'Net Payment Amount')]/ancestor::tr/descendant::td[contains(@class,'cdk-column-cisyfAmount')]");
        String Biss = driver.findElement(BissNetAmount).getText();
        Biss = Biss.replaceAll(",","");
        String Criss = driver.findElement(CrissNetAmount).getText();
        Criss = Criss.replaceAll(",","");
        String Cisyf = driver.findElement(CisyfNetAmount).getText();
        Cisyf = Cisyf.replaceAll(",","");
        Double NetPaymentTotal = Double.parseDouble(Biss) + Double.parseDouble(Criss) + Double.parseDouble(Cisyf);
        System.out.println(NetPaymentTotal);
        return NetPaymentTotal;
    }

