// ===================================================================================================================================
// File          : UiHelpers.java
// Package       : commonFunctions
// Description   : Shared Playwright helpers that replace the ~111 direct getDriver() usages found in step definitions
//                 (TC_03, TC_18, TC_13_ENTS, TC_03_ENTS, ...). One implementation instead of ten private copies.
//
//                 Selenium pattern                                        ->  UiHelpers call
//                 ---------------------------------------------------------------------------------------------------
//                 private isVisible(By, int) (10 copies)                  ->  UiHelpers.isVisible("iKey", 5)
//                 getDriver().findElements(By.xpath(x))                   ->  UiHelpers.findAll("iKey")
//                 row.findElement(By.xpath(".//td[...]"))                 ->  row.locator("xpath=.//td[...]")
//                 ((JavascriptExecutor) d).executeScript("arguments[0].click()", e) -> UiHelpers.jsClick(locator)  or  iAction("JSCLICK", ...)
//                 ((JavascriptExecutor) d).executeScript(anyScript, e, v)     -> CommonFunctions.executeScript(anyScript, locator, v)
//                 JS removeAttribute('disabled') + value + dispatchEvent  ->  UiHelpers.setValueByJs(locator, "01/01/2026")
//                 JS un-hide file input + sendKeys(path)                  ->  UiHelpers.uploadFile("iKey", "path")
//                 getDriver().navigate().to(url) / back()                 ->  UiHelpers.navigateTo(url) / navigateBack()
//                 getDriver().manage().deleteAllCookies()                 ->  UiHelpers.clearCookies()
//                 Keys.chord(Keys.CONTROL, "a"), Keys.TAB                 ->  locator.press("ControlOrMeta+A"), press("Tab")
//                 switchTo().window(handle)                               ->  UiHelpers.clickAndSwitchToNewTab("iKey")
//                 switchTo().frame(...)                                   ->  UiHelpers.frame("css=iframe#map").locator(...)
//                 switchTo().alert().accept()                             ->  UiHelpers.acceptNextDialog()   (before the click that opens it)
//                 switchTo().alert().dismiss() / getText()                ->  UiHelpers.dismissNextDialog() / lastDialogText()
//                 file in ~/Downloads                                     ->  UiHelpers.downloadByClicking("iKey")
//                 Thread.sleep(n)                                         ->  delete it; use waitVisible / waitHidden
//
// Author        : Aniket Pathare | aniket.pathare@goverment.ie
// Date Created  : 15-09-2026
// ===================================================================================================================================

package commonFunctions;

import com.microsoft.playwright.Download;
import com.microsoft.playwright.FrameLocator;
import com.microsoft.playwright.Locator;
import com.microsoft.playwright.Page;
import com.microsoft.playwright.TimeoutError;
import com.microsoft.playwright.options.WaitForSelectorState;
import utilities.ConfigManager;
import utilities.ObjReader;

import java.io.File;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.List;
import java.util.logging.Logger;

public final class UiHelpers
{
    private static final Logger log = Logger.getLogger(UiHelpers.class.getName());

    private UiHelpers() {}

    public static Page page()
    {
        Page iPage = CommonFunctions.getPage();
        if (iPage == null) { throw new RuntimeException("No active Playwright page on this thread."); }
        return iPage;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : byKey
    // Description   : Builds a Locator from an Object Repository key. Optional String.format arguments fill %s placeholders.
    //                 Keys with {index}/{value}/${INDEX} placeholders: call ObjReader.getLocator(key).replace(...) and use byXpath().
    // Parameters    : pKey  (String)   - ObjectRepository.properties key
    //                 pArgs (Object[]) - optional values for %s placeholders
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Locator byKey(String pKey, Object... pArgs)
    {
        String iRaw = ObjReader.getLocator(pKey);
        String iValue = (pArgs == null || pArgs.length == 0) ? iRaw : String.format(iRaw, pArgs);
        return page().locator(CommonFunctions.toSelector(ObjReader.getLocatorType(pKey), iValue));
    }

    public static Locator byXpath(String pXpath)
    {
        return page().locator(CommonFunctions.toSelector("XPATH", pXpath));
    }

    public static boolean isVisible(String pKey, int pTimeoutSeconds)
    {
        return isVisible(byKey(pKey).first(), pTimeoutSeconds);
    }

    public static boolean isVisible(Locator pLocator, int pTimeoutSeconds)
    {
        try
        {
            pLocator.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE).setTimeout(pTimeoutSeconds * 1000d));
            return true;
        }
        catch (TimeoutError iTimeout)
        {
            return false;
        }
    }

    public static void waitHidden(Locator pLocator, int pTimeoutSeconds)
    {
        pLocator.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.HIDDEN).setTimeout(pTimeoutSeconds * 1000d));
    }

    // Snapshot of all current matches - same semantics as driver.findElements() (no waiting, may be empty)
    public static List<Locator> findAll(String pKey)
    {
        return byKey(pKey).all();
    }

    public static List<Locator> findAll(Locator pLocator)
    {
        return pLocator.all();
    }

    public static void jsClick(Locator pLocator)
    {
        CommonFunctions.jsClick(pLocator);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : setValueByJs
    // Description   : Sets a value on an input that Angular keeps disabled/readonly (mat-datepicker) and fires the
    //                 events Angular listens to. Replacement for the removeAttribute + executeScript blocks in TC_13_ENTS.
    // Parameters    : pLocator (Locator) - the input
    //                 pValue   (String)  - value to set, e.g. 01/06/2024
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void setValueByJs(Locator pLocator, String pValue)
    {
        pLocator.evaluate(
                "(element, value) => {"
                        + " element.removeAttribute('disabled'); element.removeAttribute('readonly');"
                        + " element.focus(); element.value = value;"
                        + " element.dispatchEvent(new Event('input', { bubbles: true }));"
                        + " element.dispatchEvent(new Event('change', { bubbles: true }));"
                        + " element.dispatchEvent(new Event('blur', { bubbles: true })); }",
                pValue);
    }

    public static String getAttribute(Locator pLocator, String pName)
    {
        return pLocator.getAttribute(pName);
    }

    public static String inputValue(Locator pLocator)
    {
        return pLocator.inputValue();
    }

    public static void uploadFile(String pKey, String pFilePath)
    {
        byKey(pKey).first().setInputFiles(CommonFunctions.resolveFilePath(pFilePath));
    }

    public static void navigateTo(String pUrl)
    {
        page().navigate(pUrl);
    }

    public static void navigateBack()
    {
        page().goBack();
    }

    public static void clearCookies()
    {
        CommonFunctions.getContext().clearCookies();
    }

    public static void pressKey(String pKey)
    {
        page().keyboard().press(pKey);
    }

    public static FrameLocator frame(String pSelector)
    {
        return page().frameLocator(pSelector);
    }

    // The framework handles every pop-up dialog itself (see PlaywrightFactory). These set what happens to the NEXT
    // alert / confirm / prompt only; afterwards dialog.default.action applies again.
    public static void acceptNextDialog()
    {
        PlaywrightFactory.setNextDialogAction("accept", null);
    }

    public static void acceptNextDialog(String pPromptText)
    {
        PlaywrightFactory.setNextDialogAction("accept", pPromptText);
    }

    public static void dismissNextDialog()
    {
        PlaywrightFactory.setNextDialogAction("dismiss", null);
    }

    // Text of the last dialog shown - replacement for driver.switchTo().alert().getText()
    public static String lastDialogText()
    {
        return PlaywrightFactory.getLastDialogText();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : clickAndSwitchToNewTab
    // Description   : Clicks an element that opens a new tab/window, waits for it, and makes it the active page for iAction().
    // Parameters    : pKey (String) - Object Repository key of the element that opens the tab
    // Returns       : Page - the new page (keep the old one if you need to switch back via PlaywrightFactory.switchToPage)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Page clickAndSwitchToNewTab(String pKey)
    {
        Page iNewPage = CommonFunctions.getContext().waitForPage(() -> byKey(pKey).first().click());
        iNewPage.waitForLoadState();
        PlaywrightFactory.switchToPage(iNewPage);
        return iNewPage;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : downloadByClicking
    // Description   : Clicks an element that triggers a download and saves the file under report.downloads.path.
    //                 Works identically on Windows and in the Linux container (no dependency on ~/Downloads).
    // Parameters    : pKey (String) - Object Repository key of the download button/link
    // Returns       : Path - saved file
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Path downloadByClicking(String pKey)
    {
        Download iDownload = page().waitForDownload(() -> byKey(pKey).first().click());

        File iDir = new File(ConfigManager.getOrDefault("report.downloads.path", "Test_Report/downloads"));
        if (!iDir.exists()) { iDir.mkdirs(); }

        Path iTarget = Paths.get(iDir.getAbsolutePath(), iDownload.suggestedFilename());
        iDownload.saveAs(iTarget);
        log.info("[UiHelpers] Download saved : " + iTarget);
        return iTarget;
    }
}
