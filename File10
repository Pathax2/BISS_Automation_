// ===================================================================================================================================
// File          : TC_00_DATA.java
// Package       : stepdefinitions
// Description   : Step definitions for TC_00_DATA - fills the Test Data Vault before the test cases run.
//
//                 Three steps, no browser:
//                   Given the test data vault is checked for freshness    -> logs whether the jar is fresh or why it is stale
//                   When  the test data for every selected test case is extracted -> utilities.DataHarvester.run(...)
//                   Then  the test data stock report should be printed    -> stock report + LOW STOCK warnings
//
//                 Hooks skips the browser, TestData.xlsx row and Word report for test case IDs containing "_DATA".
//
// Author        : Aniket Pathare | aniket.pathare@government.ie
// Date Created  : 01-10-2026
// ===================================================================================================================================

package stepdefinitions;

import commonFunctions.CommonFunctions;
import io.cucumber.java.en.Given;
import io.cucumber.java.en.Then;
import io.cucumber.java.en.When;
import org.junit.jupiter.api.Assertions;
import utilities.ConfigManager;
import utilities.DataHarvester;
import utilities.TestDataVault;

import java.util.List;
import java.util.logging.Logger;

public class TC_00_DATA
{
    private static final Logger log = Logger.getLogger(TC_00_DATA.class.getName());

    private String iStockReport = "";


    // ***************************************************************************************************************************************************************************************
    // Step          : Given the test data vault is checked for freshness
    // Description   : Logs the state of the jar: where it is, when it was filled and whether the weekly refresh day or
    //                 data.force.refresh says it must be refilled. The decision itself is taken by DataHarvester.run.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    @Given("the test data vault is checked for freshness")
    public void theTestDataVaultIsCheckedForFreshness()
    {
        log.info("[STEP] Given the test data vault is checked for freshness");

        Assertions.assertTrue(TestDataVault.isEnabled(),
                "data.vault.enabled=false - set it to true in application.properties to use TC_00_DATA.");

        String iStale = TestDataVault.staleReason();
        log.info("[DATA] Vault folder : " + TestDataVault.dir().toAbsolutePath());
        log.info("[DATA] Filled       : " + (TestDataVault.filledAt().isEmpty() ? "never" : TestDataVault.filledAt()));
        log.info("[DATA] Refresh day  : " + ConfigManager.getOrDefault("data.refresh.day", "MONDAY"));
        log.info("[DATA] Freshness    : " + (iStale.isEmpty() ? "fresh - pools below target are topped up" : "STALE - " + iStale + " - the jar will be refilled"));
    }


    // ***************************************************************************************************************************************************************************************
    // Step          : When the test data for every selected test case is extracted
    // Description   : Runs the harvest: demand scan, parallel fetch, spot check, Excel view. The BISS blacklist and the
    //                 expired logins known to this run are passed in so those herds and logins are never stored.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    @When("the test data for every selected test case is extracted")
    public void theTestDataForEverySelectedTestCaseIsExtracted()
    {
        log.info("[STEP] When the test data for every selected test case is extracted");

        boolean iForce = ConfigManager.getBool("data.force.refresh", false);
        iStockReport = DataHarvester.run(iForce, Hooks.BLACKLISTED_HERDS, Hooks.EXPIRED_AGENTS);

        Assertions.assertFalse(iStockReport == null || iStockReport.isEmpty(), "The harvest produced no stock report.");
    }


    // ***************************************************************************************************************************************************************************************
    // Step          : Then the test data stock report should be printed
    // Description   : Prints the stock report and one warning per LOW STOCK / EMPTY pool. The step passes even when a
    //                 pool is low - the test cases fall back to live queries - so the rest of the run is never blocked
    //                 by this step. It fails only when nothing at all was stored (no pool could be fetched).
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    @Then("the test data stock report should be printed")
    public void theTestDataStockReportShouldBePrinted()
    {
        log.info("[STEP] Then the test data stock report should be printed");

        String iReport = iStockReport.isEmpty() ? TestDataVault.stockReport() : iStockReport;
        System.out.println(iReport);
        CommonFunctions.log.info(iReport);

        List<String> iLow = TestDataVault.lowStockPools();
        for (String iPool : iLow)
        {
            log.warning("[DATA] LOW STOCK: " + iPool + " - that test case will use live queries once the pool is empty.");
        }

        boolean iAnyRows = !TestDataVault.availableCounts().isEmpty();
        Assertions.assertTrue(iAnyRows || ConfigManager.getBool("data.allow.empty", false),
                "The vault holds no available rows after the harvest. Check the [HARVEST] Demand line: with data.demand.scope=selected "
                + "only Execution=Y rows count. Check the database connection when the demand was not empty.");
    }
}
