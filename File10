<?xml version="1.0" encoding="UTF-8"?>
<settings xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd" xmlns="http://maven.apache.org/SETTINGS/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <servers>
    <server>
		<username>${env.username}</username>
		<password>${env.password}</password>
        <id>central</id>
    </server>
    <server>
		<username>${env.username}</username>
		<password>${env.password}</password>
        <id>snapshots</id>
    </server>
    <server>
		<username>${env.username}</username>
		<password>${env.password}</password>
        <id>libs</id>
    </server>
</servers>
  <mirrors>
    <mirror>
      <mirrorOf>*</mirrorOf>
      <name>libs</name>
      <url>https://repo.ntier.agriculture.gov.ie:443/artifactory/libs</url>
      <id>libs</id>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <repositories>
        <repository>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <id>central</id>
          <name>libs</name>
          <url>https://repo.ntier.agriculture.gov.ie:443/artifactory/libs</url>
        </repository>
        <repository>
          <snapshots />
          <id>snapshots</id>
          <name>libs</name>
          <url>https://repo.ntier.agriculture.gov.ie:443/artifactory/libs</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <id>central</id>
          <name>plugins-release</name>
          <url>https://repo.ntier.agriculture.gov.ie:443/artifactory/plugins-release</url>
        </pluginRepository>
        <pluginRepository>
          <snapshots />
          <id>snapshots</id>
          <name>plugins-release</name>
          <url>https://repo.ntier.agriculture.gov.ie:443/artifactory/plugins-release</url>
        </pluginRepository>
      </pluginRepositories>
      <id>artifactory</id>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>
</settings>

