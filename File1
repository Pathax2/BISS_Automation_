    public static synchronized void markLoginExpired(String pLogin, String pNote)
    {
        load();
        String iKey = n(pLogin).toLowerCase(Locale.ROOT);
        if (iKey.isEmpty()) return;
        Person iPerson = PEOPLE.get(iKey);
        if (iPerson == null)
        {
            iPerson = new Person(pLogin, "AGENT");
            PEOPLE.put(iKey, iPerson);
        }
        iPerson.status      = "EXPIRED";
        iPerson.lastChecked = now();
        iPerson.note        = n(pNote);
        save();
        CommonFunctions.log.warning(LOG + "Login " + pLogin + " marked EXPIRED - its rows are skipped from now on.");
    }

    public static synchronized boolean isLoginExpired(String pLogin)
    {
        load();
        Person iPerson = PEOPLE.get(n(pLogin).toLowerCase(Locale.ROOT));
        return iPerson != null && "EXPIRED".equals(iPerson.status);
    }

