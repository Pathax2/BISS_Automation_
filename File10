    // Text of one amount cell of a Reduction Type row, for the log only
    private static String iRowAmount(String pRowName, String pColumn)
    {
        return iShortText(ObjReader.getLocator("iPaymentRowAmount").replace("{HEADER}", pRowName.trim()).replace("{COLUMN}", pColumn), 40);
    }

    // Number in an amount cell: commas, euro sign and spaces removed; blank or a dash counts as 0
    private static double iAmount(String pXpath)
    {
        String iRaw   = UiHelpers.byXpath(pXpath).innerText();
        String iClean = iRaw == null ? "" : iRaw.replaceAll("[^0-9.\\-]", "");
        if (iClean.isEmpty() || "-".equals(iClean))
        {
            return 0;
        }
        try
        {
            return Double.parseDouble(iClean);
        }
        catch (NumberFormatException e)
        {
            throw new AssertionError("Amount '" + iRaw + "' is not a number (" + pXpath + ").");
        }
    }

