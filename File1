    // ***************************************************************************************************************************************************************************************
    // Function Name : isStale
    // Description   : True when the jar must be refilled before it is used:
    //                   - data.force.refresh=true
    //                   - the jar was never filled
    //                   - it was filled before the most recent data.refresh.day (default MONDAY), i.e. before the
    //                     weekly database refresh
    //                 The fingerprint comparison is done by DataHarvester (it needs the database).
    // Returns       : the reason when stale, "" when fresh
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized String staleReason()
    {
        load();
        if (ConfigManager.getBool("data.force.refresh", false)) return "data.force.refresh=true";

        String iFilledOn = META.getProperty("filled_on", "");
        if (iFilledOn.isEmpty()) return "the jar has never been filled";

        LocalDate iFilled;
        try { iFilled = LocalDate.parse(iFilledOn); }
        catch (Exception e) { return "vault.meta has an unreadable filled_on value (" + iFilledOn + ")"; }

        DayOfWeek iDay;
        try { iDay = DayOfWeek.valueOf(ConfigManager.getOrDefault("data.refresh.day", "MONDAY").trim().toUpperCase(Locale.ROOT)); }
        catch (Exception e) { iDay = DayOfWeek.MONDAY; }

        LocalDate iLastRefresh = LocalDate.now().with(TemporalAdjusters.previousOrSame(iDay));
        if (iFilled.isBefore(iLastRefresh))
        {
            return "filled on " + iFilled + ", before the last " + iDay + " refresh (" + iLastRefresh + ")";
        }
        return "";
    }

    public static boolean isStale() { return !staleReason().isEmpty(); }

    // ***************************************************************************************************************************************************************************************
    // Function Name : archiveAndClear
    // Description   : Moves the current files to archive/<yyyy-MM-dd_HHmmss>/ and starts an empty jar. Also archives
    //                 the ENTS used-herds file when it exists: after a database refresh the herds used last week are
    //                 back in their original state, so an empty used list is the correct one.
    // Parameters    : pReason (String) - written to the log and to a README in the archive folder
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void archiveAndClear(String pReason)
    {
        load();
        Path iArchive = dir().resolve("archive").resolve(LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd_HHmmss")));
        try
        {
            Files.createDirectories(iArchive);
            for (Path iFile : new Path[]{ herdsFile(), peopleFile(), metaFile(), viewFile() })
            {
                if (Files.exists(iFile)) Files.move(iFile, iArchive.resolve(iFile.getFileName()), StandardCopyOption.REPLACE_EXISTING);
            }
            Path iUsed = Paths.get(ConfigManager.getOrDefault("ents.used.herds.file", "runtime-data/ents_used_herds.csv"));
            if (Files.exists(iUsed))
            {
                Files.move(iUsed, iArchive.resolve(iUsed.getFileName()), StandardCopyOption.REPLACE_EXISTING);
            }
            Files.write(iArchive.resolve("README.txt"), ("Archived " + now() + " - " + pReason + System.lineSeparator()).getBytes(StandardCharsets.UTF_8));
            CommonFunctions.log.info(LOG + "Archived the old jar to " + iArchive + " (" + pReason + ")");
        }
        catch (IOException e)
        {
            CommonFunctions.log.warning(LOG + "Could not archive the old jar (" + e.getMessage() + ") - clearing it in place.");
        }
        HERDS.clear();
        PEOPLE.clear();
        META.clear();
        iLoaded = true;
        save();
    }

