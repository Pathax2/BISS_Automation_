    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : closeSecondTab
    // Description   : Closes every tab other than the one the test works in and stays on that one. Not a step;
    //                 kept from Selenium (which closed window handle 1 and switched back to handle 0).
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026 | Updated: 05-10-2026 (Playwright)
    // ---------------------------------------------------------------------------------------------------------------------------------
    public void closeSecondTab()
    {
        Page iMainPage = CommonFunctions.getPage();
        for (Page iPage : CommonFunctions.getContext().pages())
        {
            if (iPage != iMainPage)
            {
                log.info("[STAFF] Closing extra tab: " + iPage.url());
                iPage.close();
            }
        }
        PlaywrightFactory.switchToPage(iMainPage);
    }

    // Replacement for Thread.sleep - keeps Playwright's event loop running while waiting
    private static void pause(long pMilliseconds)
    {
        CommonFunctions.getPage().waitForTimeout(pMilliseconds);
    }

    // Clicks the button with this label in an open dialog, or on the page when no dialog shows it (Selenium
    // StaffClickOnButton matched any button with the text)
    private void iClickButton(String pLabel)
    {
        String iDialogButton = ObjReader.getLocator("iDialogButton").replace("{LABEL}", pLabel);
        if (UiHelpers.isVisible(UiHelpers.byXpath(iDialogButton), PROBE_SECONDS))
        {
            iAction("CLICK", "XPATH", iDialogButton, null);
        }
        else
        {
            iAction("CLICK", "XPATH", ObjReader.getLocator("iButtonByText").replace("{LABEL}", pLabel), null);
        }
    }

    // Visible text of the first match, on one line and cut to pMax characters (for the log only, never fails)
    private static String iShortText(String pXpath, int pMax)
    {
        try
        {
            String iText = UiHelpers.byXpath(pXpath).innerText().replaceAll("\\s+", " ").trim();
            return iText.length() > pMax ? iText.substring(0, pMax) + " ..." : iText;
        }
        catch (RuntimeException iIgnored)
        {
            return "(not read)";
        }
    }

    // Trimmed DataTable cell, or null when the key is missing / the cell is empty
    private static String trimOrNull(String pValue)
    {
        return pValue == null || pValue.trim().isEmpty() ? null : pValue.trim();
    }
