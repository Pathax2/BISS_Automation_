    // ***************************************************************************************************************************************************************************************
    // Function Name : iAction
    // Description   : Performs reusable UI actions dispatched to dedicated private methods per action type.
    //                 Supports: CLICK, JSCLICK, DOUBLECLICK, RIGHTCLICK, HOVER, MOUSEHOVER, TEXTBOX, CLEARTEXTBOX,
    //                           RADIOBUTTON, CHECKBOX, LIST, DRAGDROP, UPLOADFILE, WAITVISIBLE, WAITCLICKABLE,
    //                           WAITINVISIBLE, SCROLLTOELEMENT, GETTEXT, VERIFYTEXT, VERIFYELEMENT,
    //                           CALENDAR (also accepts legacy typo CALENDER)
    // Parameters    : pActionType   (String) - action to perform (case-insensitive)
    //                 pIdentifyBy   (String) - locator strategy (XPATH, CSS, ID, ... or PLAYWRIGHT)
    //                 pObjectName   (String) - locator value
    //                 pValueToEnter (String) - input value where applicable; supports TD:ColumnName syntax
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 10-03-2026 | Updated: 15-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    public static String iAction(String pActionType, String pIdentifyBy, String pObjectName, String pValueToEnter)
    {
        String iReturnedText = "";
        long   iStartTime    = System.currentTimeMillis();

        iMaskNextValue.set(pValueToEnter != null && isSensitiveReference(pValueToEnter));

        try
        {
            Page iPage = requirePage();

            if (pActionType == null || pActionType.trim().isEmpty())
            {
                throw new RuntimeException("Action type cannot be blank.");
            }

            if (pIdentifyBy == null || pIdentifyBy.trim().isEmpty())
            {
                throw new RuntimeException("IdentifyBy cannot be blank.");
            }

            if (pObjectName == null || pObjectName.trim().isEmpty())
            {
                throw new RuntimeException("ObjectName cannot be blank.");
            }

            String  iResolvedValue = resolveValue(pValueToEnter);
            String  iSelector      = toSelector(pIdentifyBy, pObjectName);
            Locator iLocator       = getLocator(pIdentifyBy, pObjectName);
            String  iActionType    = pActionType.trim().toUpperCase(Locale.ROOT);

            logStepStart(iActionType, pIdentifyBy, pObjectName, iResolvedValue);

            switch (iActionType)
            {
                case "CLICK":
                    performClick(iLocator, pObjectName);
                    break;

                case "JSCLICK":
                case "JAVASCRIPTCLICK":
                    performJsClick(iLocator, pObjectName);
                    break;

                case "DOUBLECLICK":
                    performDoubleClick(iLocator);
                    break;

                case "RIGHTCLICK":
                    performRightClick(iLocator);
                    break;

                case "HOVER":
                case "MOUSEHOVER":
                    performHover(iLocator);
                    break;

                case "TEXTBOX":
                    performTextBox(iLocator, iResolvedValue);
                    break;

                case "CLEARTEXTBOX":
                    performClearTextBox(iLocator);
                    break;

                case "RADIOBUTTON":
                    performRadioButton(iLocator, pObjectName);
                    break;

                case "CHECKBOX":
                    performCheckBox(iLocator, pObjectName, iResolvedValue);
                    break;

                case "LIST":
                    performList(iPage, iLocator, iResolvedValue);
                    break;

                case "DRAGDROP":
                    performDragDrop(iLocator, iResolvedValue);
                    break;

                case "UPLOADFILE":
                    performUploadFile(iLocator, iResolvedValue);
                    break;

                case "WAITVISIBLE":
                    performWaitVisible(iLocator, pObjectName);
                    break;

                case "WAITCLICKABLE":
                    performWaitClickable(iPage, iLocator, pObjectName);
                    break;

                case "WAITINVISIBLE":
                    performWaitInvisible(iPage, iSelector, pObjectName);
                    break;

                case "SCROLLTOELEMENT":
                    performScrollToElement(iLocator);
                    break;

                case "GETTEXT":
                    iReturnedText = performGetText(iPage, iLocator, pObjectName);
                    break;

                case "VERIFYTEXT":
                    iReturnedText = performVerifyText(iLocator, iResolvedValue);
                    break;

                case "VERIFYELEMENT":
                    performVerifyElement(iLocator, pObjectName);
                    break;

                case "CALENDAR":
                case "CALENDER": // Legacy alias retained for backward compatibility - use CALENDAR going forward
                    performCalendar(iLocator, iResolvedValue);
                    break;

                default:
                    throw new RuntimeException("Unsupported action type : '" + pActionType + "'.");
            }

            long iDuration = System.currentTimeMillis() - iStartTime;
            logStepPass(iActionType, pIdentifyBy, pObjectName, iResolvedValue, iDuration);
            appendToStepLog(iActionType, pObjectName, displayValue(pValueToEnter, iResolvedValue), "PASS", iDuration, "", "");
        }
        catch (Exception | AssertionError iException)
        {
            long   iDuration  = System.currentTimeMillis() - iStartTime;
            String iRootCause = classifyException(iException);
            logStepFail(pActionType, pIdentifyBy, pObjectName, pValueToEnter, iDuration, iException.getMessage());
            appendToStepLog(pActionType, pObjectName, pValueToEnter, "FAIL", iDuration, firstLine(iException.getMessage()), iRootCause);
            throw new RuntimeException("iAction failed | Action=[" + pActionType + "] | Object=[" + pObjectName + "] | Reason : "
                    + firstLine(iException.getMessage()), iException);
        }
        finally
        {
            iMaskNextValue.set(Boolean.FALSE);
        }

        return iReturnedText;
    }

    private static boolean isSensitiveReference(String pValue)
    {
        String iLower = pValue.toLowerCase(Locale.ROOT);
        return iLower.contains("password") || iLower.contains("pin") || iLower.contains("otp") || iLower.contains("secret");
    }

    // The Word report shows TD:Password rather than the password itself
    private static String displayValue(String pRawValue, String pResolvedValue)
    {
        if (pRawValue != null && isSensitiveReference(pRawValue)) { return pRawValue.trim().startsWith("TD:") ? pRawValue.trim() : "****"; }
        return pResolvedValue;
    }

