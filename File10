    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : theStaffUserShouldBeAbleToDownloadTheGeneratedMap
    // Description   : Confirms the completed map exposes a working download link and follows it. The map opens as a
    //                 PDF in a new tab: the tab is waited for (staff.map.tab.seconds, default 30 as in Selenium),
    //                 its address logged, then closed, and the test carries on in the main tab.
    //                 No new tab within the time: a warning, as in Selenium (the step does not fail).
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026 | Updated: 05-10-2026 (Playwright)
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the staff user should be able to download the generated map")
    public void theStaffUserShouldBeAbleToDownloadTheGeneratedMap()
    {
        log.info("[STEP] the staff user should be able to download the generated map");

        Page iMainPage = CommonFunctions.getPage();
        int  iSeconds  = ConfigManager.getInt("staff.map.tab.seconds", 30);

        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iReadyToDownloadLink"), null);

        Page iMapTab;
        try
        {
            iMapTab = CommonFunctions.getContext().waitForPage(
                    new BrowserContext.WaitForPageOptions().setTimeout(iSeconds * 1000d),
                    () -> iAction("CLICK", "XPATH", ObjReader.getLocator("iReadyToDownloadLink"), null));
        }
        catch (TimeoutError e)
        {
            log.warning("[STEP] No new tab opened for the generated map within " + iSeconds + "s.");
            PlaywrightFactory.switchToPage(iMainPage);
            return;
        }

        log.info("[STEP] Closing map PDF tab: " + iMapTab.url());
        iMapTab.close();
        PlaywrightFactory.switchToPage(iMainPage);
    }

