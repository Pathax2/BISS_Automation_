    @And("the staff user submits the amendment and confirms")
    public void theStaffUserSubmitsTheAmendmentAndConfirms()
    {
        log.info("[STEP] the staff user submits the amendment and confirms");
        iAction("CLICK", "XPATH", ObjReader.getLocator("iNextButton"), null);
        iAction("CLICK", "XPATH", ObjReader.getLocator("iSubmitChangesButton"), null);
        iAction("CLICK", "XPATH", ObjReader.getLocator("iDialogButton").replace("{LABEL}", "OK"), null);
    }

