    // Staff minimize resolution of screen
    public void StaffReduceResolutionOfScreen() throws AWTException, InterruptedException {
        Robot robot = new Robot();
        for(int i=0; i<4; i++) {
            //driver.findElement(By.tagName("html")).sendKeys(Keys.chord(Keys.CONTROL,Keys.SUBTRACT));
            robot.keyPress(KeyEvent.VK_CONTROL);
            robot.keyPress(KeyEvent.VK_SUBTRACT);
            robot.keyRelease(KeyEvent.VK_SUBTRACT);
            robot.keyRelease(KeyEvent.VK_CONTROL);
            Thread.sleep(4000);
        }
    }

    // Staff minimize resolution of screen
    public void StaffReduceResolutionOfScreenNumberOfTimes(String times) throws AWTException, InterruptedException {
        Robot robot = new Robot();
        int j = Integer.parseInt(times);
        for(int i=0; i<j; i++) {
            //driver.findElement(By.tagName("html")).sendKeys(Keys.chord(Keys.CONTROL,Keys.SUBTRACT));
            robot.keyPress(KeyEvent.VK_CONTROL);
            robot.keyPress(KeyEvent.VK_SUBTRACT);
            robot.keyRelease(KeyEvent.VK_SUBTRACT);
            robot.keyRelease(KeyEvent.VK_CONTROL);
            Thread.sleep(4000);
        }
    }

