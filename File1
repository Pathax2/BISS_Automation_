    public static final class Row
    {
        public final String pool;
        public final String key;
        public final String herd;
        public final String name;
        public final String address;
        public final String login;
        public String status;
        public String testCase;
        public String purpose;
        public String reason;
        public final String fetchedAt;
        public String updatedAt;

        public Row(String pPool, String pKey, String pHerd, String pName, String pAddress, String pLogin)
        {
            pool      = n(pPool).toUpperCase(Locale.ROOT);
            key       = n(pKey);
            herd      = n(pHerd);
            name      = n(pName);
            address   = n(pAddress);
            login     = n(pLogin);
            status    = AVAILABLE;
            testCase  = "";
            purpose   = "";
            reason    = "";
            fetchedAt = now();
            updatedAt = fetchedAt;
        }

        private Row(String[] pCells)
        {
            pool      = cell(pCells, 0).toUpperCase(Locale.ROOT);
            key       = cell(pCells, 1);
            herd      = cell(pCells, 2);
            name      = cell(pCells, 3);
            address   = cell(pCells, 4);
            login     = cell(pCells, 5);
            status    = cell(pCells, 6).isEmpty() ? AVAILABLE : cell(pCells, 6).toUpperCase(Locale.ROOT);
            testCase  = cell(pCells, 7);
            purpose   = cell(pCells, 8);
            reason    = cell(pCells, 9);
            fetchedAt = cell(pCells, 10);
            updatedAt = cell(pCells, 11);
        }

        String toCsv()
        {
            return String.join(",", csv(pool), csv(key), csv(herd), csv(name), csv(address), csv(login), csv(status),
                    csv(testCase), csv(purpose), csv(reason), csv(fetchedAt), csv(updatedAt));
        }

        boolean matches(String pPool, String pKey)
        {
            return pool.equalsIgnoreCase(n(pPool)) && key.equalsIgnoreCase(n(pKey));
        }

        @Override
        public String toString() { return herd + " (" + name + (login.isEmpty() ? "" : ", " + login) + ")"; }
    }

    public static final class Person
    {
        public final String login;
        public final String type;        // AGENT | INDIVIDUAL | ETF
        public String status;            // ACTIVE | EXPIRED
        public String lastChecked;
        public String note;

        Person(String pLogin, String pType)
        {
            login = n(pLogin); type = n(pType).toUpperCase(Locale.ROOT); status = "ACTIVE"; lastChecked = now(); note = "";
        }

        private Person(String[] pCells)
        {
            login = cell(pCells, 0); type = cell(pCells, 1).toUpperCase(Locale.ROOT);
            status = cell(pCells, 2).isEmpty() ? "ACTIVE" : cell(pCells, 2).toUpperCase(Locale.ROOT);
            lastChecked = cell(pCells, 3); note = cell(pCells, 4);
        }

        String toCsv() { return String.join(",", csv(login), csv(type), csv(status), csv(lastChecked), csv(note)); }
    }

