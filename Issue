        }
    }

    private static void sleepOnPage(Page pPage, int pMillis)
    {
        pPage.waitForTimeout(pMillis);
    }

    private static Boolean readCheckedState(Locator pLocator)
    {
        Object iState = pLocator.evaluate(JS_CHECKED_STATE);
        return iState instanceof Boolean ? (Boolean) iState : null;
    }

    private static String readTextOrValue(Locator pLocator)
    {
        Object iText = pLocator.evaluate(JS_TEXT_OR_VALUE);
        return iText == null ? "" : String.valueOf(iText).trim();
    }

    // Playwright sends java.util.regex.Pattern to the browser as a JavaScript RegExp, so Pattern.quote()
    // (which produces \Q...\E - unsupported in JavaScript) must NOT be used. Escape the characters manually.
    private static Pattern exactTextPattern(String pText)
    {
        return Pattern.compile("^\\s*" + escapeForJsRegex(pText.trim()) + "\\s*$", Pattern.CASE_INSENSITIVE);
    }

    public static String escapeForJsRegex(String pText)
    {
        return pText.replaceAll("[.*+?^${}()|\\[\\]\\\\/]", "\\\\$0");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : clickWithFallback
    // Description   : Click used by every CLICK-type action. Behaviour depends on click.strategy:
    //                   auto   (default) - Step 1: normal Playwright click (waits for visible, stable, enabled, not covered).
    //                                      Step 2: if Step 1 fails for any reason within click.attempt.timeout.ms
    //                                      (overlay intercepts it, element hidden or disabled, timeout), a JavaScript
    //                                      click is used - same safety net as the Selenium
    //                                      ElementClickInterceptedException -> executeScript("arguments[0].click()").
    //                                      If both fail, the error shows both reasons.
    //                   js               - always a JavaScript click (the Selenium JavascriptExecutor way).
    //                   native           - normal Playwright click only, no fallback (full explicit wait).
    // Parameters    : pLocator    (Locator) - element to click
    //                 pObjectName (String)  - locator text for logs
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026 | Updated: 16-09-2026 (click.strategy)
    // ***************************************************************************************************************************************************************************************
    public static void clickWithFallback(Locator pLocator, String pObjectName)
    {
        if ("js".equals(iClickStrategy))
        {
            jsClick(pLocator, pObjectName);
            return;
        }

        if ("native".equals(iClickStrategy))
        {
            pLocator.click();
            return;
        }

        // Step 1 : normal Playwright click (real mouse click, like WebElement.click())
        try
        {
            pLocator.click(new Locator.ClickOptions().setTimeout(iClickAttemptTimeoutMs));
            return;
        }
        catch (PlaywrightException iNormalClickError)
        {
            // TimeoutError is a PlaywrightException, so blocked, covered, hidden and not-yet-enabled elements all land here.
            // A closed page or browser cannot be clicked at all - report that straight away instead of trying JavaScript.
            String iReason = firstLine(iNormalClickError.getMessage());
            if (isPageClosed(iNormalClickError))
            {
                throw iNormalClickError;
            }

            log.warning("[" + getCurrentTimestamp() + "] Normal click failed within " + (long) iClickAttemptTimeoutMs
                    + " ms. Retrying with JavaScript click for locator : " + pObjectName + " | " + iReason);

            // Step 2 : JavaScript click - executeScript("arguments[0].click();", element)
            try
            {
                jsClick(pLocator, pObjectName);
            }
            catch (RuntimeException iJsClickError)
            {
                throw new RuntimeException("Click failed for locator : " + pObjectName
                        + " | Normal click : " + iReason
                        + " | JavaScript click : " + firstLine(iJsClickError.getMessage()), iJsClickError);
            }
        }
    }

    private static boolean isPageClosed(Throwable pError)
    {
        String iMessage = pError.getMessage() == null ? "" : pError.getMessage().toLowerCase(Locale.ROOT);
        return iMessage.contains("target page, context or browser has been closed")
            || iMessage.contains("target closed")
            || iMessage.contains("browser has been closed");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : jsClick
    // Description   : JavaScript click - the Playwright equivalent of
    //                   ((JavascriptExecutor) driver).executeScript("arguments[0].click();", element)
    //                 Scrolls the element to the centre first. Works even when an overlay covers the element or the
    //                 element is not considered visible, because no mouse event is simulated.
    //                 Waits (explicit.wait.seconds) for the element to exist in the page before clicking.
    // Parameters    : pLocator    (Locator) - element to click
    //                 pObjectName (String)  - locator text for logs (may be blank)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void jsClick(Locator pLocator, String pObjectName)
    {
        if (pLocator == null)
        {
            throw new RuntimeException("jsClick: locator cannot be null.");
        }

        pLocator.evaluate(JS_CLICK);
        log.info("[" + getCurrentTimestamp() + "] JavaScript click performed" + (pObjectName == null || pObjectName.isBlank() ? "" : " | Object=" + pObjectName));
    }

    public static void jsClick(Locator pLocator)
    {
        jsClick(pLocator, "");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : jsClick
    // Description   : JavaScript click by IdentifyBy + locator, e.g.
    //                   CommonFunctions.jsClick("XPATH", ObjReader.getLocator("iLoginbtn"));
    //                 Same result as iAction("JSCLICK", ...) but without a step-log row.
    // Parameters    : pIdentifyBy (String) - XPATH | CSS | ID | ... | PLAYWRIGHT
    //                 pObjectName (String) - locator value
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void jsClick(String pIdentifyBy, String pObjectName)
