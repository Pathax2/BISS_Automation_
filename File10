    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : iSubmitAmendment
    // Description   : Next, Submit Changes and (pConfirm) OK on the confirmation dialog, as before, plus the Protein Aid
    //                 Scheme cases (21-10-2026):
    //                   - a parcel changed earlier for the protein scheme while the scheme is now deselected: its old
    //                     Parcel Use is put back before Submit Changes (the post-test reset leaves the herd as found)
    //                   - Submit Changes shows "You have opted into the Protein Scheme but you haven't added eligible
    //                     crops": OK, the protein crop on the first tillage row (iAddProteinCrop), Submit Changes again
    //                 The dialog that follows Submit Changes is waited for once (staff.submit.dialog.seconds, default 20),
    //                 so a submit without the popup takes no longer than before.
    // Parameters    : pConfirm (boolean) - true = click OK on the confirmation dialog
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 21-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    private void iSubmitAmendment(boolean pConfirm)
    {
        iAction("CLICK", "XPATH", ObjReader.getLocator("iNextButton"), null);

        if (iProteinCropParcel != null && Boolean.FALSE.equals(iProteinSchemeSelected))
        {
            iRestoreProteinCropParcel();
        }

        iAction("CLICK", "XPATH", ObjReader.getLocator("iSubmitChangesButton"), null);

        String iProteinDialog = ObjReader.getLocator("iProteinCropDialog");
        String iOkButton      = ObjReader.getLocator("iDialogButton").replace("{LABEL}", "OK");
        int    iWaitSeconds   = ConfigManager.getInt("staff.submit.dialog.seconds", 20);

        // The protein popup has an OK button too, so it is looked for first on every poll
        String iShown = iFirstShown(pConfirm ? iWaitSeconds : PROBE_SECONDS + 2, iProteinDialog, iOkButton);

        if (iProteinDialog.equals(iShown))
        {
            log.info("[PROTEIN] Submit Changes: " + iShortText(iProteinDialog, 160));
            iAction("CLICK", "XPATH", ObjReader.getLocator("iProteinCropDialogOkBtn"), null);
            iWaitHidden(iProteinDialog, 10);

            iAddProteinCrop();

            iAction("CLICK", "XPATH", ObjReader.getLocator("iSubmitChangesButton"), null);
            iShown = iFirstShown(pConfirm ? iWaitSeconds : PROBE_SECONDS + 2, iProteinDialog, iOkButton);
            if (iProteinDialog.equals(iShown))
            {
                throw new AssertionError("[PROTEIN] The 'no eligible crops' popup is still shown after parcel " + iProteinCropParcel
                        + " was given '" + ConfigManager.getOrDefault("staff.protein.crop", "Beans - Spring")
                        + "'. Check staff.protein.crop and the Parcel Use list.");
            }
        }

        if (pConfirm)
        {
            iAction("CLICK", "XPATH", iOkButton, null);
        }
    }
