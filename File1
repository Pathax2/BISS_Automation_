    public static synchronized boolean hasPool(String pPool, String pKey)
    {
        load();
        for (Row iRow : HERDS) if (iRow.matches(pPool, pKey)) return true;
        return false;
    }

    public static synchronized int countStatus(String pPool, String pKey, String pStatus)
    {
        load();
        int iCount = 0;
        for (Row iRow : HERDS) if (iRow.matches(pPool, pKey) && iRow.status.equals(pStatus)) iCount++;
        return iCount;
    }

    // Copies of the AVAILABLE rows of a pool (the caller must not change them - use reserve / markUsed / markBad)
    public static synchronized List<Row> available(String pPool, String pKey)
    {
        load();
        List<Row> iRows = new ArrayList<>();
        for (Row iRow : HERDS) if (iRow.matches(pPool, pKey) && AVAILABLE.equals(iRow.status)) iRows.add(iRow);
        return iRows;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : reserve
    // Description   : Takes one random AVAILABLE row of the pool, not in pExcludeHerds and whose login is not in
    //                 pExcludeLogins, marks it RESERVED for the test case and saves. Null when the pool has nothing left.
    // Parameters    : pPool, pKey | pExcludeHerds (Set, may be null) | pExcludeLogins (Set, may be null)
    //                 pTestCase (String) | pPurpose (String) - e.g. the transfer type
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized Row reserve(String pPool, String pKey, Set<String> pExcludeHerds, Set<String> pExcludeLogins,
                                           String pTestCase, String pPurpose)
    {
        load();
        List<Row> iCandidates = new ArrayList<>();
        for (Row iRow : HERDS)
        {
            if (!iRow.matches(pPool, pKey) || !AVAILABLE.equals(iRow.status)) continue;
            if (pExcludeHerds != null && pExcludeHerds.contains(iRow.herd)) continue;
            if (pExcludeLogins != null && !iRow.login.isEmpty() && pExcludeLogins.contains(iRow.login)) continue;
            Person iPerson = PEOPLE.get(iRow.login.toLowerCase(Locale.ROOT));
            if (iPerson != null && "EXPIRED".equals(iPerson.status)) continue;
            iCandidates.add(iRow);
        }
        if (iCandidates.isEmpty()) return null;

        Collections.shuffle(iCandidates, new Random(System.nanoTime()));
        Row iRow = iCandidates.get(0);
        iRow.status    = RESERVED;
        iRow.testCase  = n(pTestCase);
        iRow.purpose   = n(pPurpose);
        iRow.reason    = "";
        iRow.updatedAt = now();
        save();
        CommonFunctions.log.info(LOG + "Reserved " + iRow + " from " + iRow.pool + "/" + iRow.key + " for " + iRow.testCase
                + " [" + iRow.purpose + "] | " + (iCandidates.size() - 1) + " available left");
        return iRow;
    }

    // Marks the row of this herd (RESERVED or AVAILABLE) as RESERVED - used when a test picked the herd some other way
    public static synchronized void reserveHerd(String pHerd, String pTestCase, String pPurpose)
    {
        update(pHerd, r -> { if (!USED.equals(r.status) && !BAD.equals(r.status)) { r.status = RESERVED; r.testCase = n(pTestCase); r.purpose = n(pPurpose); } });
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : markUsed / markUsedFinal / isReuseOn / isReusablePool
    // Description   : markUsed - a herd finished its transfer. Normally the row becomes USED. In reuse mode
    //                 (data.reuse.herds=true) a row of a reusable pool goes back to AVAILABLE with a use count in the
    //                 reason column ("used 3x, last ..."), because an ENTS transfer only moves 0.01 entitlements and the
    //                 herd still has more than 10 afterwards. (01-10-2026)
    //                 Reusable pools: data.reuse.pools (default the ENTS pools). BISS pools are never reused - a BISS
    //                 application changes the herd's status for the rest of the scheme year.
    //                 markUsedFinal - USED whatever the mode: for herds that must not come back this week (a lease
    //                 transferee, a transfer whose submission was not confirmed).
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized void markUsed(String pHerd)
    {
        update(pHerd, r ->
        {
            if (isReusablePool(r.pool))
            {
                r.status = AVAILABLE;
                r.reason = "used " + (useCount(r.reason) + 1) + "x, last " + now();
            }
            else
            {
                r.status = USED;
            }
        });
    }

    public static synchronized void markUsedFinal(String pHerd, String pReason)
    {
        update(pHerd, r -> { r.status = USED; r.reason = n(pReason); });
    }

    public static boolean isReuseOn()
    {
        return ConfigManager.getBool("data.reuse.herds", false);
    }

    public static boolean isReusablePool(String pPool)
    {
        if (!isReuseOn() || pPool == null) return false;
        for (String iPool : ConfigManager.getOrDefault("data.reuse.pools", POOL_ENTS_AGENT + "," + POOL_ENTS_ETF + ","
                + POOL_ENTS_INDIVIDUAL + "," + POOL_ENTS_NO_ENTS).split("[,;\\s]+"))
        {
            if (iPool.trim().equalsIgnoreCase(pPool.trim())) return true;
        }
        return false;
    }

    // "used 3x, last 2026-10-01 16:00:00" -> 3
    private static int useCount(String pReason)
    {
        java.util.regex.Matcher iMatcher = java.util.regex.Pattern.compile("used (\\d+)x").matcher(n(pReason));
        return iMatcher.find() ? Integer.parseInt(iMatcher.group(1)) : 0;
    }

    public static synchronized void markBad(String pHerd, String pReason)
    {
        update(pHerd, r -> { r.status = BAD; r.reason = n(pReason); });
    }

    // Puts a RESERVED row back to AVAILABLE (only when nothing was done with the herd)
    public static synchronized void release(String pHerd)
    {
        update(pHerd, r -> { if (RESERVED.equals(r.status)) { r.status = AVAILABLE; r.testCase = ""; r.purpose = ""; } });
    }

    private static void update(String pHerd, Consumer<Row> pChange)
    {
        load();
        boolean iChanged = false;
        for (Row iRow : HERDS)
        {
            if (iRow.herd.equalsIgnoreCase(n(pHerd)))
            {
                String iBefore = iRow.status;
                pChange.accept(iRow);
                iRow.updatedAt = now();
                iChanged = true;
                CommonFunctions.log.info(LOG + iRow.herd + " (" + iRow.pool + "/" + iRow.key + "): " + iBefore + " -> " + iRow.status
                        + (iRow.reason.isEmpty() ? "" : " | " + iRow.reason));
            }
        }
        if (iChanged) save();
    }

