// ===================================================================================================================================
// File          : pipeline/Jenkinsfile
// Project       : DAFM AUTOMATION_Playwright (GitLab biss/biss-automation/dafm-automation_playwright)
// Description   : Runs the BISS / ENTS Playwright BDD framework on the DAFM OpenShift Jenkins (multibranch pipeline).
//                 One job, two daily pipelines:
//                   - SUITE=BISS runs the BISS_DAILY_TESTCASES list, SUITE=ENTS the ENTS_DAILY_TESTCASES list,
//                     SUITE=CUSTOM the TESTCASE_IDS typed in Build with Parameters
//                   - on DAILY_BRANCH Jenkins starts a BISS build at about BISS_DAILY_HOUR and an ENTS build at about
//                     ENTS_DAILY_HOUR (Dublin time, Monday to Friday); a timed build picks its suite from the hour
//                 Built from the DAFM Playwright template (podTemplate on the 'openshift' cloud, Playwright Java image,
//                 Artifactory settings in pipeline/settings.xml, Maven proxy arguments). Changes versus the template:
//                   - parameters: test case IDs, application environment, timeout
//                   - timeout in minutes is a parameter (the template's timeout(1) stops after 1 minute)
//                   - db.properties and TestData.xlsx come from the OpenShift secret 'biss-playwright-credentials'
//                     (mounted read-only into the pod), never from Git
//                   - run-tests.sh returns the real Maven exit code; failed tests mark the build UNSTABLE, a broken run FAILURE
//                   - JUnit XML published; HTML report, Word evidence and logs archived (Playwright traces are NOT archived -
//                     they hold typed passwords and cookies)
//                   - GITLAB_OBJECT_KIND read safely (env. prefix) so a manual "Build with Parameters" does not fail
//
// Prerequisites (one-off):
//   1. The Jenkins GitLab organization folder scans this project (done: biss group, Jenkins reads pipeline/Jenkinsfile).
//   2. OpenShift secret 'biss-playwright-credentials' in namespace biss-cicd (created by the OpenShift platform team),
//      two keys named exactly like the files:
//        db.properties   -> the db.properties file
//        TestData.xlsx   -> the TestData.xlsx file
//      oc create secret generic biss-playwright-credentials -n biss-cicd
//         --from-file=db.properties=<path to db.properties> --from-file=TestData.xlsx=<path to TestData.xlsx>
//   3. The image tag below exists in the internal registry. The pom uses Playwright 1.61.0; the pipeline passes
//      -Dplaywright.version to match the image so the bundled browsers are used (no download).
//
// Author        : Aniket Pathare | aniket.pathare@government.ie
// Date Created  : 09-10-2026
// Updated       : 15-10-2026 - moved to pipeline/Jenkinsfile; secrets from Jenkins "Secret file" credentials instead of the
//                              OpenShift secret volume (a missing secret volume kept the agent pod from starting)
// Updated       : 16-10-2026 - back to the OpenShift secret, named biss-playwright-credentials by the platform team (Jenkins
//                              credentials are not changed per team); the volume is optional, so a missing secret no
//                              longer keeps the pod offline - run-tests.sh stops with a clear message instead
// Updated       : 16-10-2026 - HOME / XDG_CONFIG_HOME / XDG_CACHE_HOME set to the workspace volume, so Chromium can start
//                              under the random OpenShift user (build #7: chrome_crashpad_handler --database is required)
// Updated       : 16-10-2026 - daily BISS and ENTS pipelines: SUITE parameter, fixed daily test case lists, weekday timer
//                              (BISS ~05:00, ENTS ~07:00 Dublin time) on DAILY_BRANCH, build name shows the suite
//                              history kept: 30 builds, reports of the last 10
//                              first daily lists: BISS TC_00_DATA to TC_10 (INET), ENTS TC_01_ENTS to TC_25_ENTS
// Updated       : 19-10-2026 - "Test Dashboard" link per build (HTML Publisher, team + stakeholder report), pass/fail counts
//                              in the build description, JUnit trend counts test cases only (surefire runner file left out)
// ===================================================================================================================================

//Project Specific
// no spaces allowed in app name
def APP = "BISS-Playwright"
def BUILD_REF = "${APP}-${BUILD_ID}"

//Environment Specific
def JENKINS_AGENT_IMAGE = "registry.redhat.io/ocp-tools-4/jenkins-agent-base-rhel9:v4.18.0"
def JENKINS_HOME = "/home/jenkins"

// Keep PLAYWRIGHT_VERSION equal to the image tag (java-v<version>-noble)
def PLAYWRIGHT_VERSION = "1.60.0"
def PLAYWRIGHT_IMAGE = "registry.apps.services1.agriculture.gov.ie/openshift/playwright:java-v${PLAYWRIGHT_VERSION}-noble"
def MAVEN_ARGS = "-Dmaven.repo.local=${JENKINS_HOME}/.m2/repository -DproxySet=true -DproxyHost=vsdbahlprxy1 -DproxyPort=8080 -s ./pipeline/settings.xml"

// db.properties and TestData.xlsx are mounted here from the OpenShift secret; run-tests.sh copies them into the framework
def SECRETS_SECRET_NAME = "biss-playwright-credentials"
def SECRETS_DIR = "${JENKINS_HOME}/biss-secrets"

// ---- Daily pipelines -----------------------------------------------------------------------------------------------------------
// Only this branch gets the daily timer (change it to main / develop once the migration is merged)
def DAILY_BRANCH = "feature/playwright-migration"

// Start hours, Dublin time, Monday to Friday. Jenkins picks a fixed minute between :00 and :14 for this job.
// A timed build starting before ENTS_DAILY_HOUR runs BISS, otherwise ENTS - keep BISS_DAILY_HOUR the earlier one.
def BISS_DAILY_HOUR = 5
def ENTS_DAILY_HOUR = 7

// Daily builds stop after this many minutes (a manual build uses the TIMEOUT_MINUTES parameter)
def DAILY_TIMEOUT_MINUTES = 240

// Test cases of each daily run, one per line. Keep TC_00_DATA first so the Test Data Vault is filled (the pod
// starts with an empty vault every time, for BISS and ENTS alike).
// Every ID must be a TestCase_ID row of ExecutionControl.xlsx (an unknown ID is reported at the end of the run).
// The test cases run in the row order of ExecutionControl.xlsx, not in the order of this list.
// Add the other BISS INET and STAFF test cases here once they have run green on their own.
def BISS_DAILY_TESTCASES = [
    "TC_00_DATA",
    "TC_01_Login",
    "TC_02_InvalidCredentials_Login",
    "TC_03",
    "TC_03_IND",
    "TC_04",
    "TC_05",
    "TC_06",
    "TC_07",
    "TC_08",
    "TC_09",
    "TC_10"
]

def ENTS_DAILY_TESTCASES = [
    "TC_00_DATA",
    "TC_01_ENTS",
    "TC_02_ENTS",
    "TC_03_ENTS",
    "TC_04_ENTS",
    "TC_05_ENTS",
    "TC_06_ENTS",
    "TC_07_ENTS",
    "TC_08_ENTS",
    "TC_09_ENTS",
    "TC_10_ENTS",
    "TC_11_ENTS",
    "TC_12_ENTS",
    "TC_13_ENTS",
    "TC_14_ENTS",
    "TC_15_ENTS",
    "TC_16_ENTS",
    "TC_17_ENTS",
    "TC_18_ENTS",
    "TC_19_ENTS",
    "TC_20_ENTS",
    "TC_21_ENTS",
    "TC_22_ENTS",
    "TC_23_ENTS",
    "TC_24_ENTS",
    "TC_25_ENTS"
]

// Timer lines: TZ first, then one line per daily run (minute hour day-of-month month day-of-week)
def DAILY_CRON = "TZ=Europe/Dublin\n" +
                 "H(0-14) ${BISS_DAILY_HOUR} * * 1-5\n" +
                 "H(0-14) ${ENTS_DAILY_HOUR} * * 1-5"
def DAILY_TRIGGERS = (env.BRANCH_NAME == DAILY_BRANCH) ? [cron(DAILY_CRON)] : []

properties([
    // Two daily builds a weekday: keep about two weeks of history and one week of reports
    buildDiscarder(logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '10', daysToKeepStr: '', numToKeepStr: '30')),
    parameters([
        choice(name: 'SUITE', choices: ['CUSTOM', 'BISS', 'ENTS'],
               description: 'CUSTOM = the TESTCASE_IDS below. BISS / ENTS = the daily list of that suite in pipeline/Jenkinsfile (TESTCASE_IDS is ignored). Timed daily builds choose BISS or ENTS themselves.'),
        string(name: 'TESTCASE_IDS', defaultValue: 'TC_00_DATA,TC_01_Login',
               description: 'Used when SUITE=CUSTOM. Comma-separated TestCase_IDs from ExecutionControl.xlsx. Keep TC_00_DATA first so the Test Data Vault is filled.'),
        string(name: 'APP_ENVIRONMENT', defaultValue: '',
               description: 'Blank = the Environment column of ExecutionControl.xlsx. Otherwise the value passed as -Denvironment (e.g. QA).'),
        string(name: 'TIMEOUT_MINUTES', defaultValue: '180',
               description: 'Stop the whole build after this many minutes.')
    ]),
    // One build at a time: if the BISS run is still going at the ENTS start time, the ENTS build waits in the queue
    disableConcurrentBuilds(),
    pipelineTriggers(DAILY_TRIGGERS),
])

podTemplate(
    cloud: 'openshift',
    label: BUILD_REF,
    serviceAccount: 'jenkins',
    containers: [

        containerTemplate(
                name: "playwright-java", workingDir: JENKINS_HOME,
                envVars: [
                    envVar(key: 'https_proxy', value: "http://vsdbahlprxy1:8080"),
                    // Internal hosts (application, Keycloak, Oracle, Artifactory) must not go through the proxy
                    envVar(key: 'no_proxy', value: "localhost,127.0.0.1,.agriculture.gov.ie,.svc,.cluster.local"),
                    // Use the browsers bundled in the image; never download at run time
                    envVar(key: 'PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD', value: "1"),
                    // OpenShift runs the pod as a random user with no writable home folder; Chromium then cannot
                    // start its crash handler ("chrome_crashpad_handler: --database is required") and exits.
                    // Point home, config and cache at the writable workspace volume.
                    envVar(key: 'HOME', value: JENKINS_HOME),
                    envVar(key: 'XDG_CONFIG_HOME', value: "${JENKINS_HOME}/.config"),
                    envVar(key: 'XDG_CACHE_HOME', value: "${JENKINS_HOME}/.cache"),
                    envVar(key: 'BISS_SECRETS_DIR', value: SECRETS_DIR),
                    secretEnvVar(key: 'username', secretName: 'mvn-repo-secret', secretKey: 'username'),
                    secretEnvVar(key: 'password', secretName: 'mvn-repo-secret', secretKey: 'password')
                ],
                image: PLAYWRIGHT_IMAGE, ttyEnabled: true, command: 'cat'),
        containerTemplate(
                name: "jnlp", workingDir: JENKINS_HOME,
                image: JENKINS_AGENT_IMAGE)
    ],
    volumes: [
        // optional: the pod still starts when the secret is missing; run-tests.sh then stops with exit code 2
        secretVolume(secretName: SECRETS_SECRET_NAME, mountPath: SECRETS_DIR, optional: true)
    ]) {

    // Started by the daily timer (not by a person or a GitLab event)
    def isDailyBuild = !currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause').isEmpty()

    def timeoutText = (params.TIMEOUT_MINUTES ?: '180').toString().trim()
    def timeoutMinutes = timeoutText.isInteger() ? timeoutText.toInteger() : 180
    if (isDailyBuild) {
        timeoutMinutes = DAILY_TIMEOUT_MINUTES
    }

    timeout(time: timeoutMinutes, unit: 'MINUTES') {
        node(BUILD_REF) {

            // Same rule as the template: do not run the tests on every push / merge request event, only on demand
            def objectKind = env.GITLAB_OBJECT_KIND ?: ""
            if (objectKind && ["push", "tag_push", "merge_request"].contains(objectKind)) {
                echo "Ran due to a GitLab ${objectKind} event - tests are started manually with Build with Parameters. Aborting."
                currentBuild.result = 'SUCCESS'
                return
            }

            // Text shown under the build in Build History; the test counts are added after the run
            def runLabel = ''

            try {

                // Which test cases: the daily list of BISS / ENTS, or the TESTCASE_IDS parameter (CUSTOM)
                def suite = (params.SUITE ?: 'CUSTOM').toString().trim().toUpperCase()
                container("jnlp") {
                    if (isDailyBuild) {
                        def dublinHour = sh(script: 'TZ=Europe/Dublin date +%H', returnStdout: true).trim().toInteger()
                        suite = (dublinHour < ENTS_DAILY_HOUR) ? 'BISS' : 'ENTS'
                    }
                }

                def testCaseIds
                if (suite == 'BISS') {
                    testCaseIds = BISS_DAILY_TESTCASES.join(',')
                } else if (suite == 'ENTS') {
                    testCaseIds = ENTS_DAILY_TESTCASES.join(',')
                } else {
                    suite = 'CUSTOM'
                    testCaseIds = (params.TESTCASE_IDS ?: '').trim()
                }

                // Build history shows e.g. "#12 BISS daily", "#13 ENTS daily", "#14 CUSTOM"
                currentBuild.displayName = "#${env.BUILD_NUMBER} ${suite}${isDailyBuild ? ' daily' : ''}"
                runLabel = (suite == 'CUSTOM') ? testCaseIds : "${suite} ${isDailyBuild ? 'daily' : 'manual'} run"
                currentBuild.description = runLabel

                container("jnlp") {
                    stage('Clone source') {
                        checkout scm
                    }
                }

                container("playwright-java") {
                    stage('Run tests') {
                        env.MAVEN_ARGS = MAVEN_ARGS
                        env.PLAYWRIGHT_VERSION = PLAYWRIGHT_VERSION
                        env.TESTCASE_IDS = testCaseIds
                        env.APP_ENVIRONMENT = (params.APP_ENVIRONMENT ?: '').trim()

                        echo "Suite      : ${suite}${isDailyBuild ? ' (daily timer)' : ''}"
                        echo "Test cases : ${env.TESTCASE_IDS}"
                        echo "Environment: ${env.APP_ENVIRONMENT ?: '(ExecutionControl.xlsx column)'}"

                        def exitCode = sh(script: 'bash run-tests.sh', returnStatus: true)
                        echo "Exit code from tests is: ${exitCode}"

                        if (exitCode == 2) {
                            currentBuild.result = 'FAILURE'
                            error("Setup problem (see the run-tests.sh messages above) - the tests did not start.")
                        } else if (exitCode != 0) {
                            // Tests ran and some failed: UNSTABLE when a results file exists, FAILURE otherwise
                            currentBuild.result = fileExists('target/surefire-reports') ? 'UNSTABLE' : 'FAILURE'
                        }
                    }
                }
            }
            catch (e) {
                echo "Pipeline Failed: ${e}"
                if (!currentBuild.result || currentBuild.result == 'SUCCESS') {
                    currentBuild.result = 'FAILURE'
                }
            }
            finally {
                stage('Publish results') {
                    // Only the framework's results file: one entry per test case. The Maven surefire file
                    // (TEST-runner.TestRunner.xml) is left out - it counts the whole run as one extra test.
                    def tests = junit(testResults: 'target/surefire-reports/BISS_Execution_Results.xml', allowEmptyResults: true)
                    if (tests != null && tests.totalCount > 0) {
                        // Build History shows e.g. "BISS daily run | 11 passed, 1 failed of 12"
                        currentBuild.description = "${runLabel} | ${tests.passCount} passed, ${tests.failCount} failed of ${tests.totalCount}"
                    }

                    // Fixed names for the dashboard tab: the framework stamps every report with the time of the run
                    sh(script: 'if [ -d Test_Report/html ]; then cd Test_Report/html; ' +
                               't=$(ls -t BISS_Execution_Report_*.html 2>/dev/null | head -1); [ -n "$t" ] && cp "$t" index.html; ' +
                               's=$(ls -t BISS_Stakeholder_Report_*.html 2>/dev/null | head -1); [ -n "$s" ] && cp "$s" stakeholder.html; ' +
                               'fi; exit 0', returnStatus: true)

                    // "Test Dashboard" link on the left of every build (HTML Publisher plugin). Without the plugin the
                    // build carries on and the reports stay under Build Artifacts.
                    try {
                        publishHTML(target: [reportName: 'Test Dashboard', reportDir: 'Test_Report/html',
                                             reportFiles: 'index.html, stakeholder.html',
                                             keepAll: true, alwaysLinkToLastBuild: true, allowMissing: true])
                    } catch (NoSuchMethodError e) {
                        echo "HTML Publisher plugin is not installed - the dashboard is under Build Artifacts > Test_Report/html."
                    }

                    // HTML/PDF reports, Word evidence, failure screenshots (the dashboard links to them) and logs.
                    // Test_Report/traces is left out on purpose (passwords, cookies).
                    archiveArtifacts(artifacts: 'Test_Report/html/**, Test_Report/docs/**, Test_Report/screenshots/**, target/logs/**',
                                     allowEmptyArchive: true, fingerprint: false)
                }

                def currentResult = currentBuild.result ?: 'SUCCESS'
                def previousResult = currentBuild.previousBuild?.result
                if (previousResult != null && previousResult != currentResult) {
                    echo "Result changed: ${previousResult} -> ${currentResult}"
                }
            }
        }
    }
}
