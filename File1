    // ***************************************************************************************************************************************************************************************
    // Function Name : putPool
    // Description   : Replaces the AVAILABLE rows of one pool/key with freshly fetched rows. Rows of that pool that are
    //                 RESERVED, USED or BAD are kept, and a fresh row whose herd is already USED / BAD / RESERVED in the
    //                 jar is not added again (the herd is not fresh, whatever the query says).
    // Parameters    : pPool, pKey - pool and key | pRows - fresh rows from DataHarvester
    // Returns       : number of AVAILABLE rows of the pool after the call
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 01-10-2026
    // ***************************************************************************************************************************************************************************************
    public static synchronized int putPool(String pPool, String pKey, List<Row> pRows)
    {
        load();
        HERDS.removeIf(r -> r.matches(pPool, pKey) && AVAILABLE.equals(r.status));

        Set<String> iTaken = new java.util.HashSet<>();
        for (Row iRow : HERDS)
        {
            if (!AVAILABLE.equals(iRow.status)) iTaken.add(iRow.herd.toUpperCase(Locale.ROOT));
        }

        int iAdded = 0;
        for (Row iRow : pRows)
        {
            if (iRow.herd.isEmpty() || iTaken.contains(iRow.herd.toUpperCase(Locale.ROOT))) continue;
            iTaken.add(iRow.herd.toUpperCase(Locale.ROOT));
            HERDS.add(iRow);
            iAdded++;
            if (!iRow.login.isEmpty()) rememberPerson(iRow.login, typeFor(pPool));
        }
        save();
        CommonFunctions.log.info(LOG + "Pool " + pPool + "/" + pKey + " filled: " + iAdded + " fresh row(s), "
                + countStatus(pPool, pKey, AVAILABLE) + " available");
        return countStatus(pPool, pKey, AVAILABLE);
    }

    private static String typeFor(String pPool)
    {
        String iPool = n(pPool).toUpperCase(Locale.ROOT);
        if (iPool.equals(POOL_ENTS_INDIVIDUAL) || iPool.equals(POOL_BISS_IND_CISYF)) return "INDIVIDUAL";
        return "AGENT";
    }

    private static void rememberPerson(String pLogin, String pType)
    {
        String iKey = n(pLogin).toLowerCase(Locale.ROOT);
        if (iKey.isEmpty()) return;
        Person iPerson = PEOPLE.get(iKey);
        if (iPerson == null)
        {
            PEOPLE.put(iKey, new Person(pLogin, pType));
        }
        else
        {
            iPerson.lastChecked = now();
        }
    }

    // Records when the jar was filled and the database fingerprints (DataHarvester)
    public static synchronized void markFilled(Map<String, String> pFingerprints)
