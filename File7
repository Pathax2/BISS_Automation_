for Young Farmer


SELECT ve.herd_id Herd_ID, 
SUBSTR(ve.herd_agt, INSTR(ve.herd_agt, 'aga', -1, 1), 7) Login_ID
FROM vwco_ents_herd_abls_rpt ve
WHERE 1=1
AND ve.herd_agt IS NOT NULL
AND UPPER(ve.herd_agt) LIKE '%AGA%'
AND ve.herd_id NOT IN (
   SELECT iap_from_herd
   FROM tden_inet_application
   WHERE iap_group_code = 4)
AND herd_id in ('D1461126','D195C519','W1750439');
