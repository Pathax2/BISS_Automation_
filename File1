   SELECT iap_from_herd, iap_scheme_year, iap_status_code, iap_group_code,
          iap_date_received, iap_app_ref, iap_audit_date
   FROM   tden_inet_application
   WHERE  iap_from_herd IN ('Q1700791', 'Q1670329')
   AND    iap_scheme_year = 2026
   ORDER  BY iap_from_herd, iap_audit_date;


   SELECT table_name FROM all_tables
   WHERE  table_name LIKE '%STATUS%' OR table_name LIKE '%GROUP%';
