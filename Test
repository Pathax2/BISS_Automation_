# ===================================================================================================================================
# File          : application-docker.properties
# Description   : Container execution overrides for the BISS Playwright framework.
#                 Activated by -Denv=docker (the Maven "docker" profile sets it) or BISS_ENV=docker.
#                 Any key can still be overridden at run time with -Dkey=value or a BISS_ environment variable,
#                 e.g. BISS_EXPLICIT_WAIT_SECONDS=45, BISS_APP_URL=https://..., BISS_TRACE_MODE=on
#
# Folder        : src/test/resources/config/application-docker.properties
# Author        : Aniket Pathare | aniket.pathare@goverment.ie
# Date Created  : 15-09-2026
# Updated       : 17-09-2026 - browser.cleanup.before.start=none, execution.fail.fast=true
# ===================================================================================================================================

# Browser - bundled Chromium from the Playwright image, always headless, fixed viewport
browser=CHROME
browser.channel=
# The container runs as root - Chromium needs --no-sandbox there
browser.chromium.sandbox=false
headless=true
# Each container starts clean - no process or temp folder cleanup
browser.cleanup.before.start=none
browser.cleanup.temp.folders=false
browser.maximize=false
viewport.width=1920
viewport.height=1080
browser.locale=en-IE
browser.timezone=Europe/Dublin
highlight.enabled=false
playwright.slowmo.ms=0

# Internal SIT/UAT certificates are usually not trusted inside a fresh Linux image.
# Prefer adding the corporate CA to the image (see docker/certs/README.txt) and set this back to false.
ignore.https.errors=true

# Outbound proxy for the browser (leave blank when the container has direct access)
browser.proxy.server=
browser.proxy.bypass=

# Timeouts
explicit.wait.seconds=30
page.load.timeout.seconds=60
click.strategy=auto
click.attempt.timeout.ms=5000
browser.https.upgrades=true
dialog.default.action=accept
log.browser.events=true
# Application console errors are noisy in CI logs - page, request and dialog events are enough there
log.browser.console.errors=false
wait.visible.seconds=30
verify.element.timeout.seconds=20
list.option.timeout.seconds=30
wait.polling.interval.ms=250

# Page zoom - same 67% as local runs so layouts and locators behave identically in the container
browser.zoom.percent=67
# Extra CSS body zoom (old per-action 84% hack). Keep 100 (off).
ui.zoom.percent=100

# Locator behaviour - false = first match (Selenium parity), true = Playwright strict mode
locator.strict=false

# Playwright trace: off | on | retain-on-failure
trace.mode=retain-on-failure
trace.screenshots=false
report.traces.path=Test_Report/traces
report.downloads.path=Test_Report/downloads

# Screenshots - retention cleanup is pointless in an ephemeral container
screenshot.retention.days=0

# Retry analyser - Playwright exception names replace Selenium ones
retry.on.exceptions=TimeoutError,PlaywrightException

# A failed scenario skips the rest of its test case
execution.fail.fast=true

# Excel write-back - results are published through reports, not by mutating files in the image
execution.control.writeback=false
testdata.writeback.enabled=false

# Runtime herd bootstrap from Oracle (set false when the container cannot reach the DB)
db.bootstrap=true

# Logging
log.output.path=target/logs/
