-- 1. Find the transfer detail tables ("TRN" = transfer, as in TSEN_TRN_STATUS_CODES)
SELECT table_name FROM all_tables
WHERE  table_name LIKE 'TDEN%TRN%'
OR     table_name LIKE 'TDEN_INET%'
OR     table_name LIKE '%TRANSFER%'
ORDER  BY table_name;

-- 2. Every ETF partner: linked herds with more than 10 ents, and how many have no in-flight 2026 transfer
WITH apps AS (
  SELECT iap_from_herd herd,
         MAX(CASE WHEN iap_status_code IN (3, 4, 5) THEN 1 ELSE 0 END) busy
  FROM   tden_inet_application
  WHERE  iap_scheme_year = 2026
  AND    iap_group_code  = 2
  GROUP  BY iap_from_herd
),
ents AS (
  SELECT ohs_herd herd
  FROM   tden_owner_history, vwen_ent_sets
  WHERE  ohs_scheme_year = ent_scheme_year
  AND    ohs_own_id      = ent_own_id
  AND    ohs_hist_no     = ent_hist_no
  AND    ent_scheme_year = 2026
  GROUP  BY ohs_herd
  HAVING SUM(ent_num_ents) > 10
)
SELECT LOWER(u.username) etf_login,
       COUNT(DISTINCT l.hel_herd_no) herds,
       COUNT(DISTINCT CASE WHEN NVL(a.busy, 0) = 0 THEN l.hel_herd_no END) free_herds
FROM   tden_herd_etf_link l
JOIN   vw_sso_roles_for_user_ents u ON u.businessid = l.hel_etf_no
JOIN   ents e      ON e.herd = l.hel_herd_no
LEFT   JOIN apps a ON a.herd = l.hel_herd_no
WHERE  l.hel_scheme_year       = 2026
AND    l.hel_grantor_type      = 1
AND    l.hel_txor_ents_allowed > 10
GROUP  BY LOWER(u.username)
ORDER  BY free_herds DESC;
