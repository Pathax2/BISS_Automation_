-- A. Grassland crops valid in 2026 (only uses columns from your screenshots)
SELECT c.crp_code, c.crp_desc, u.cru_code,
       u.cru_temp_grass_ind, u.cru_permanent_grass_ind, u.cru_grass_year_1_ind
FROM   tsbs_crop_usage u
JOIN   tsbs_crop c ON c.crp_code = u.cru_crp_code
WHERE  u.cru_grassland_ind = 'Y'
AND    2026 BETWEEN u.cru_start_year AND u.cru_end_year
ORDER  BY c.crp_code;

