    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : thePaymentSummaryShouldShowTheBissCrissAndCisyfColumns
    // Description   : The Payment Summary table has the BISS, CRISS and CISYF headings, each with its amount column below
    //                 (bissAmount, crissAmount, cisyfAmount). Selenium printed whether they existed; here a missing one fails
    //                 the step, listing every missing heading.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 16-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the payment summary should show the BISS, CRISS and CISYF columns")
    public void thePaymentSummaryShouldShowTheBissCrissAndCisyfColumns()
    {
        log.info("[STEP] the payment summary should show the BISS, CRISS and CISYF columns");
        iAction("VERIFYELEMENT", "XPATH", ObjReader.getLocator("iPaymentSummaryHeader").replace("{HEADER}", "BISS"), null);

        StringBuilder iMissing = new StringBuilder();
        for (String iScheme : new String[] { "BISS", "CRISS", "CISYF" })
        {
            if (UiHelpers.byXpath(ObjReader.getLocator("iPaymentSummaryHeader").replace("{HEADER}", iScheme)).count() == 0)
            {
                iMissing.append(iMissing.length() == 0 ? "" : ", ").append(iScheme).append(" heading");
            }
            String iColumn = iScheme.toLowerCase(java.util.Locale.ROOT) + "Amount";
            if (UiHelpers.byXpath(ObjReader.getLocator("iPaymentAmountHeader").replace("{COLUMN}", iColumn)).count() == 0)
            {
                iMissing.append(iMissing.length() == 0 ? "" : ", ").append(iColumn).append(" column");
            }
        }
        if (iMissing.length() > 0)
        {
            throw new AssertionError("Payment Summary is missing: " + iMissing + " (herd " + iCurrentHerd + ").");
        }
        log.info("[PAYMENTS] BISS, CRISS and CISYF headings and amount columns shown for herd " + iCurrentHerd + ".");
    }

