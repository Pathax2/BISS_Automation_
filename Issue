    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : frame
    // Description   : Locator scope inside an iframe - replacement for switchTo().frame(...). No switching back is needed:
    //                 UiHelpers.frame("css=iframe#map").locator("xpath=//button").click();
    // Parameters    : pSelector (String) - selector of the iframe, e.g. css=iframe#map
    // Returns       : FrameLocator
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static FrameLocator frame(String pSelector)
    {
        return page().frameLocator(pSelector);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : acceptNextDialog
    // Description   : The framework handles every pop-up dialog itself (see PlaywrightFactory). Call this BEFORE the click
    //                 that opens an alert / confirm so the NEXT dialog is accepted; afterwards dialog.default.action applies again.
    //                 Replacement for switchTo().alert().accept().
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void acceptNextDialog()
    {
        PlaywrightFactory.setNextDialogAction("accept", null);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : acceptNextDialog
    // Description   : Same as acceptNextDialog(), and types the text into the NEXT prompt() dialog before accepting it.
    //                 Replacement for switchTo().alert().sendKeys(text) + accept().
    // Parameters    : pPromptText (String) - text for the prompt
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void acceptNextDialog(String pPromptText)
    {
        PlaywrightFactory.setNextDialogAction("accept", pPromptText);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : dismissNextDialog
    // Description   : Call BEFORE the click that opens the dialog - the NEXT alert / confirm / prompt is dismissed (Cancel).
    //                 Replacement for switchTo().alert().dismiss().
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static void dismissNextDialog()
    {
        PlaywrightFactory.setNextDialogAction("dismiss", null);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : lastDialogText
    // Description   : Text of the last pop-up dialog shown - replacement for driver.switchTo().alert().getText().
    // Returns       : String - dialog message, or empty when no dialog has been shown
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    public static String lastDialogText()
    {
        return PlaywrightFactory.getLastDialogText();
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : clickAndSwitchToNewTab
    // Description   : Clicks an element that opens a new tab/window, waits for it, and makes it the active page for iAction().
    // Parameters    : pKey (String) - Object Repository key of the element that opens the tab
    // Returns       : Page - the new page (keep the old one if you need to switch back via PlaywrightFactory.switchToPage)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Page clickAndSwitchToNewTab(String pKey)
    {
        Page iNewPage = CommonFunctions.getContext().waitForPage(() -> byKey(pKey).first().click());
        iNewPage.waitForLoadState();
        PlaywrightFactory.switchToPage(iNewPage);
        return iNewPage;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : downloadByClicking
    // Description   : Clicks an element that triggers a download and saves the file under report.downloads.path.
    //                 Works identically on Windows and in the Linux container (no dependency on ~/Downloads).
    // Parameters    : pKey (String) - Object Repository key of the download button/link
    // Returns       : Path - saved file
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Path downloadByClicking(String pKey)
    {
        Download iDownload = page().waitForDownload(() -> byKey(pKey).first().click());

        File iDir = new File(ConfigManager.getOrDefault("report.downloads.path", "Test_Report/downloads"));
        if (!iDir.exists()) { iDir.mkdirs(); }

        Path iTarget = Paths.get(iDir.getAbsolutePath(), iDownload.suggestedFilename());
        iDownload.saveAs(iTarget);
        log.info("[UiHelpers] Download saved : " + iTarget);
        return iTarget;
    }
}
