                function isMobilePhone() {
                    const userAgent = navigator.userAgent.toLowerCase();
                    const isMobile = userAgent.includes('mobile') && !userAgent.includes('tablet');
                    // const isSmallScreen = window.innerWidth <= 767;
                    // return isMobile && isSmallScreen;
                    return isMobile;
                }

                if (isMobilePhone()) {
                    // click the manual button programmatically
                    let manual_elem = document.getElementById('manual_link');
                    if (manual_elem) {
                        manual_elem.click();
                    }
                    let barcode_elem = document.getElementById('mode-barcode');
                    if (barcode_elem) {
                        barcode_elem.style.display = 'none';
                    }
                }
            });
