            if (isVisible(ObjReader.getLocator("iRentalExpiryDateInput"), 2))
            {
                // The portal only accepts an expiry date on or after 31 May of the year after the scheme year
                // (scheme year 2026 -> 31/05/2027), so the date is 31 May of next year
                String iExpiryDate = LocalDate.of(LocalDate.now().getYear() + 1, 5, 31)
                        .format(DateTimeFormatter.ofPattern("dd/MM/yyyy"));
                iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iRentalExpiryDateInput"), iExpiryDate);
                log.info("Set Rental/Lease Expiry Date to: " + iExpiryDate);
                iAnyFieldFixed = true;
            }
