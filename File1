-- TC_11_ENTS (agr15512): which rule leaves enough herds?
WITH etf_herds AS (
    SELECT DISTINCT ve.herd_id, l.hel_txor_ents_allowed, l.hel_txee_ents_allowed
    FROM   vwco_ents_herd_abls_rpt ve
    JOIN   tden_herd_etf_link l          ON l.hel_herd_no = ve.herd_id
    JOIN   vw_sso_roles_for_user_ents u  ON u.businessid  = l.hel_etf_no
    WHERE  ve.cust_type = 'Individual'
    AND    ve.herd_ols_login IS NOT NULL
    AND    REGEXP_LIKE(ve.herd_id, '^[A-Z]')
    AND    EXISTS (SELECT 1 FROM vwco_ems_client_details dn
                   WHERE dn.herd_number = ve.herd_id AND NVL(dn.death_indicator, 'N') = 'N')
    AND    l.hel_scheme_year       = 2026
    AND    l.hel_grantor_type      = 1
    AND    l.hel_txor_ents_allowed > 10
    AND    LOWER(u.username)       = LOWER('agr15512')
),
herd_ents AS (
    SELECT ohs_herd herd_id, SUM(ent_num_ents) ents_2026
    FROM   tden_owner_history, vwen_ent_sets
    WHERE  ohs_scheme_year = ent_scheme_year
    AND    ohs_own_id      = ent_own_id
    AND    ohs_hist_no     = ent_hist_no
    AND    ent_scheme_year = 2026
    GROUP BY ohs_herd
)
SELECT COUNT(DISTINCT e.herd_id)                                                     AS herds_now,
       COUNT(DISTINCT CASE WHEN e.hel_txee_ents_allowed > 10 THEN e.herd_id END)     AS with_txee_gt_10,
       COUNT(DISTINCT CASE WHEN h.ents_2026 > 10 THEN e.herd_id END)                 AS with_own_ents_gt_10,
       COUNT(DISTINCT CASE WHEN NVL(h.ents_2026, 0) = 0 THEN e.herd_id END)          AS with_no_ents_2026
FROM   etf_herds e
LEFT JOIN herd_ents h ON h.herd_id = e.herd_id;
