    // Loads the CSV files once per run (and again after a refill). Missing files = an empty jar.
    private static void load()
    {
        if (iLoaded) return;
        HERDS.clear();
        PEOPLE.clear();
        META.clear();

        try
        {
            if (Files.exists(herdsFile()))
            {
                for (String iLine : Files.readAllLines(herdsFile(), StandardCharsets.UTF_8))
                {
                    if (iLine.isBlank() || iLine.startsWith("pool,")) continue;
                    HERDS.add(new Row(splitCsv(iLine)));
                }
            }
            if (Files.exists(peopleFile()))
            {
                for (String iLine : Files.readAllLines(peopleFile(), StandardCharsets.UTF_8))
                {
                    if (iLine.isBlank() || iLine.startsWith("login,")) continue;
                    Person iPerson = new Person(splitCsv(iLine));
                    if (!iPerson.login.isEmpty()) PEOPLE.put(iPerson.login.toLowerCase(Locale.ROOT), iPerson);
                }
            }
            if (Files.exists(metaFile()))
            {
                try (java.io.Reader iReader = Files.newBufferedReader(metaFile(), StandardCharsets.UTF_8)) { META.load(iReader); }
            }
        }
        catch (IOException e)
        {
            CommonFunctions.log.warning(LOG + "Could not read the vault files in " + dir() + " (" + e.getMessage() + ") - starting with an empty jar.");
            HERDS.clear();
            PEOPLE.clear();
        }

        iLoaded = true;
        CommonFunctions.log.info(LOG + "Loaded " + HERDS.size() + " herd row(s) and " + PEOPLE.size() + " login(s) from " + dir()
                + (META.isEmpty() ? " (jar never filled)" : " | filled " + META.getProperty("filled_at", "?")));
    }

    // Rewrites all three files under the file lock
    private static void save()
    {
        withFileLock(() ->
        {
            try
            {
                Files.createDirectories(dir());
                List<String> iHerdLines = new ArrayList<>();
                iHerdLines.add(HERDS_HEADER);
                for (Row iRow : HERDS) iHerdLines.add(iRow.toCsv());
                Files.write(herdsFile(), iHerdLines, StandardCharsets.UTF_8);

                List<String> iPeopleLines = new ArrayList<>();
                iPeopleLines.add(PEOPLE_HEADER);
                for (Person iPerson : PEOPLE.values()) iPeopleLines.add(iPerson.toCsv());
                Files.write(peopleFile(), iPeopleLines, StandardCharsets.UTF_8);

                try (java.io.Writer iWriter = Files.newBufferedWriter(metaFile(), StandardCharsets.UTF_8))
                {
                    META.store(iWriter, "TestDataVault - when the jar was filled and the database fingerprints at that moment");
                }
            }
            catch (IOException e)
            {
                CommonFunctions.log.warning(LOG + "Could not write the vault files in " + dir() + ": " + e.getMessage());
            }
        });
    }

    // Forces the next call to read the files again (another process may have changed them)
    public static synchronized void reload()
    {
        iLoaded = false;
        load();
    }

