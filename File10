    }

    // ---------------------------------------------------------------------------------------------------------------------------------
    // Function Name : iNextFromPool
    // Description   : Returns the next unused value from a runtime pool. Fails loudly rather than wrapping around -
    //                 a scenario asking for more herds than the query returned is a data problem that must surface,
    //                 not be silently masked by re-using row 1. The caller advances its cursor.
    // Parameters    : pPool      (List<String>) - the resolved pool from StaffTestData
    //                 pCursor    (int)          - current position
    //                 pPoolName  (String)       - for the error message
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-07-2026 | Updated: 05-10-2026 (Playwright - pools from StaffTestData)
    // ---------------------------------------------------------------------------------------------------------------------------------
    private String iNextFromPool(List<String> pPool, int pCursor, String pPoolName)
    {
        if (pPool == null || pPool.isEmpty())
        {
            throw new IllegalStateException("Runtime pool '" + pPoolName + "' is empty. Check that the corresponding DBRouter "
                    + "query returns rows for this scheme year on the DATA database.");
        }

        if (pCursor >= pPool.size())
        {
            throw new IllegalStateException("Scenario requested more values from pool '" + pPoolName + "' than the query returned ("
                    + pPool.size() + "). Increase staff.pool.size or add a size tag to the feature, e.g. @herds:10:submitted.");
        }

        log.info("[STAFF-DATA] " + pPoolName + " row " + (pCursor + 1) + "/" + pPool.size() + " : " + pPool.get(pCursor));
        // Dashboard ledger (14-10-2026): staff values are picked here, so this is where they are recorded
        reporting.ExecutionMetrics.herdPicked("staff " + pPoolName, pPool.get(pCursor), "", "Internal portal - " + pPoolName);
        return pPool.get(pCursor);
    }

    // Next submitted herd for a scheme year (the pool most steps use)
    private String iNextSubmittedHerd(String pSchemeYear)
    {
        String iHerd = iNextFromPool(StaffTestData.pool(Pool.SUBMITTED, pSchemeYear), iSubmittedHerdCursor, Pool.SUBMITTED.description());
        iSubmittedHerdCursor++;
        return iHerd;
    }

