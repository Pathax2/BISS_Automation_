    }

    private static void performTextBox(Locator pLocator, String pValue)
    {
        if (pValue == null)
        {
            throw new RuntimeException("TEXTBOX action requires a non-null value.");
        }

        waitVisible(pLocator);
        highlightElement(pLocator);
        // fill() waits for the element to be enabled and editable (not readonly), clears it, then types the value
        // and fires input/change events - which Angular reactive forms need.
        pLocator.fill(pValue);
    }

    private static void performClearTextBox(Locator pLocator)
    {
        waitVisible(pLocator);
        highlightElement(pLocator);
        pLocator.clear();
    }

    private static void performRadioButton(Locator pLocator, String pObjectName)
    {
        waitVisible(pLocator);
        highlightElement(pLocator);

        Boolean iChecked = readCheckedState(pLocator);

        if (Boolean.TRUE.equals(iChecked))
        {
            log.info("[" + getCurrentTimestamp() + "] Radio button is already selected. No click performed.");
            return;
        }

        clickWithFallback(pLocator, pObjectName);
    }

    private static void performCheckBox(Locator pLocator, String pObjectName, String pValue)
    {
        if (pValue == null || pValue.trim().isEmpty())
        {
            throw new RuntimeException("CHECKBOX action requires CHECK or UNCHECK as value.");
        }

        waitVisible(pLocator);
        highlightElement(pLocator);

        String  iCheckboxAction = pValue.trim().toUpperCase(Locale.ROOT);
        Boolean iChecked        = readCheckedState(pLocator);

        if ("CHECK".equals(iCheckboxAction))
        {
            if (Boolean.TRUE.equals(iChecked))
            {
                log.info("[" + getCurrentTimestamp() + "] Checkbox is already checked. No click performed.");
            }
            else
            {
                clickWithFallback(pLocator, pObjectName);
            }
        }
        else if ("UNCHECK".equals(iCheckboxAction))
        {
            if (Boolean.TRUE.equals(iChecked))
            {
                clickWithFallback(pLocator, pObjectName);
            }
            else if (iChecked == null)
            {
                log.warning("[" + getCurrentTimestamp() + "] Checkbox state could not be read for " + pObjectName + ". No click performed.");
            }
            else
            {
                log.info("[" + getCurrentTimestamp() + "] Checkbox is already unchecked. No click performed.");
            }
        }
        else
        {
            throw new RuntimeException("CHECKBOX only accepts CHECK or UNCHECK. Passed value : '" + pValue + "'");
        }
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : performList
    // Description   : Self-healing dropdown handler supporting mat-select, native <select>, and Angular Material
    //                 options rendered inside cdk-overlay-container / mat-dialog portals / popover panels.
    //                   1. tag = mat-select                          -> performMatSelect
    //                   2. tag = select                              -> performNativeSelect (Playwright selectOption)
    //                   3. wrapper that contains a mat-select        -> performMatSelect on the inner mat-select
    //                      (lib-biss-select-search, mat-form-field, ...)
    //                   4. the mat-select trigger div itself         -> performMatSelect on the parent mat-select
    //                   5. anything else                             -> performOverlayOptionClick (root-scoped visible mat-option)
    // Date Updated  : 16-09-2026 (Playwright - wrapper and trigger-div support)
    // ***************************************************************************************************************************************************************************************
    private static void performList(Page pPage, Locator pLocator, String pValue)
    {
        if (pValue == null || pValue.trim().isEmpty())
        {
            throw new RuntimeException("LIST action requires a selection value.");
        }

        waitVisible(pLocator);
        highlightElement(pLocator);

        String iTagName   = String.valueOf(pLocator.evaluate("element => element.tagName.toLowerCase()")).trim();
        String iListValue = pValue.trim();

        log.info("[" + getCurrentTimestamp() + "] LIST | tag=<" + iTagName + "> | value=" + iListValue);

        if ("mat-select".equals(iTagName))
        {
            performMatSelect(pPage, pLocator, iListValue);
            return;
        }

        if ("select".equals(iTagName))
        {
            performNativeSelect(pLocator, iListValue);
            return;
        }

        Locator iInnerSelect = pLocator.locator("css=mat-select");
        if (iInnerSelect.count() > 0)
        {
            log.info("[" + getCurrentTimestamp() + "] LIST | <" + iTagName + "> wraps a mat-select - using the inner mat-select.");
            performMatSelect(pPage, iInnerSelect.first(), iListValue);
            return;
        }

        Locator iParentSelect = pLocator.locator("xpath=ancestor::mat-select[1]");
        if (iParentSelect.count() > 0)
        {
            log.info("[" + getCurrentTimestamp() + "] LIST | <" + iTagName + "> is inside a mat-select - using the parent mat-select.");
            performMatSelect(pPage, iParentSelect.first(), iListValue);
            return;
        }

        log.warning("[" + getCurrentTimestamp() + "] LIST | tag=<" + iTagName
                + "> is not a recognised dropdown tag. Attempting overlay direct-option click for value: '" + iListValue + "'");
        performOverlayOptionClick(pPage, iListValue);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : performOverlayOptionClick
    // Description   : Fallback for mat-option elements rendered in the CDK overlay portal (e.g. mat-select inside a mat-dialog).
    //                 Finds the first VISIBLE mat-option in the document whose text equals pValue (case-insensitive).
    // Date Updated  : 15-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    private static void performOverlayOptionClick(Page pPage, String pValue)
    {
        Locator iOption = pPage.locator(MAT_OPTION_CSS)
                .filter(new Locator.FilterOptions().setHasText(exactTextPattern(pValue)))
                .locator("visible=true")
                .first();

        try
        {
            iOption.waitFor(waitState(WaitForSelectorState.VISIBLE, iListOptionTimeoutMs));
        }
        catch (TimeoutError iTimeout)
        {
            throw new RuntimeException("Option '" + pValue + "' not found in DOM via root-scoped search. Available: "
                    + String.join(" | ", pPage.locator(MAT_OPTION_CSS).allInnerTexts()), iTimeout);
        }

        scrollIntoView(iOption);
        highlightElement(iOption);
        clickWithFallback(iOption, "mat-option '" + pValue + "'");
        log.info("[" + getCurrentTimestamp() + "] OVERLAY-LIST | Option clicked: '" + pValue + "'");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : performMatSelect
    // Description   : Angular Material <mat-select> handler (standard and searchable ngx-mat-select-search dropdowns,
    //                 panels in the CDK overlay container or in a popover). Accepts INDEX:, VISIBLETEXT:, VALUE: or plain text.
    //                 Built for speed: every wait runs INSIDE the browser (50 ms polling, one round trip) instead of
    //                 many small Playwright calls.
    //                   0. Read id / open / disabled state in one call and pin the dropdown by id
    //                      (an XPath such as "first empty dropdown" moves to another dropdown once this one has a value).
    //                   1. Open: wait while disabled (Townland before County), click the .mat-mdc-select-trigger div,
    //                      fall back to a JavaScript click on it, then the Enter key.
    //                   2. Find THIS dropdown's panel through aria-controls; read searchable / multiple once, while it is open.
    //                   3. Searchable: type the text (force - the box sits inside an aria-disabled mat-option).
    //                      If the option does not show, search again with the name before " - ", the code after it,
    //                      then an empty box.
    //                   4. The browser marks the matching option once the list has stopped changing, Playwright clicks it.
    //                   5. Check the dropdown now shows the chosen text.
    // Date Updated  : 16-09-2026 (Playwright - in-browser waits, no attribute reads on a closed panel)
    // ***************************************************************************************************************************************************************************************
    private static void performMatSelect(Page pPage, Locator pSelect, String pValue)
    {
        long   iStart = System.currentTimeMillis();
        String iToken = Long.toString(System.nanoTime(), 36);

        // STEP 0 : STATE + PIN BY ID
        Map<String, Object> iState    = selectState(pSelect);
        String              iSelectId = str(iState.get("id"));
        Locator iSelect = iSelectId.isEmpty() ? pSelect : pPage.locator("css=mat-select[id='" + iSelectId + "']");
        String  iName   = "mat-select" + (iSelectId.isEmpty() ? "" : " #" + iSelectId);

        // STEP 1 : OPEN
        openMatSelect(iSelect, iName, iState);

        // STEP 2 : PANEL (read everything we need now, while it is open)
        Map<String, Object> iPanelInfo = asMap(iSelect.evaluate(JS_RESOLVE_PANEL, mapOf("token", iToken, "ms", (long) iActionTimeoutMs)));
        if (iPanelInfo == null || str(iPanelInfo.get("id")).isEmpty())
        {
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | No panel found for " + iName
                    + ". Delegating to overlay option click for value: '" + pValue + "'");
            performOverlayOptionClick(pPage, pValue);
            return;
        }

        String  iPanelId   = str(iPanelInfo.get("id"));
        boolean iSearch    = Boolean.TRUE.equals(iPanelInfo.get("searchable"));
        boolean iMultiple  = Boolean.TRUE.equals(iPanelInfo.get("multiple"));
        Locator iPanel     = pPage.locator("css=[id='" + iPanelId + "']");

        // STEP 3 + 4 : FIND THE OPTION
        String  iUpper = pValue.toUpperCase(Locale.ROOT);
        String  iText;
        int     iIndex = -1;

        if (iUpper.startsWith("INDEX:"))
        {
            iIndex = Integer.parseInt(pValue.substring("INDEX:".length()).trim());
            iText  = "";
        }
        else if (iUpper.startsWith("VISIBLETEXT:"))
        {
            iText = pValue.substring("VISIBLETEXT:".length()).trim();
        }
        else if (iUpper.startsWith("VALUE:"))
        {
            iText = pValue.substring("VALUE:".length()).trim();
            log.warning("MAT-SELECT | VALUE: prefix treated as visible text.");
        }
        else
        {
            iText = pValue.trim();
        }

        Map<String, Object> iPick;
        if (iSearch && iIndex < 0)
        {
            iPick = searchAndPick(pPage, iPanel, iPanelId, iText, iToken);
        }
        else
        {
            iPick = pickOption(pPage, iPanelId, iText, iIndex, iToken, 0, LIST_NO_MATCH_MS, false, iListOptionTimeoutMs);
        }

        if (iPick == null || !Boolean.TRUE.equals(iPick.get("found")))
        {
            pPage.keyboard().press("Escape");
            throw new RuntimeException("MAT-SELECT | No option found matching: '" + (iIndex >= 0 ? "INDEX:" + iIndex : iText) + "' in " + iName
                    + "\nAvailable: " + (iPick == null ? "" : str(iPick.get("sample"))));
        }

        String  iPicked = str(iPick.get("text"));
        Locator iTarget = iPanel.locator("css=mat-option[data-pw-pick='" + iToken + "']");
        try
        {
            iTarget.click(new Locator.ClickOptions().setTimeout(Math.min(iClickAttemptTimeoutMs, 3000)));
        }
        catch (PlaywrightException iClickError)
        {
            if (isPageClosed(iClickError)) { throw iClickError; }

            // The list was redrawn between marking and clicking (late filter) - mark the option again once and click it
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | Click on '" + iPicked + "' did not land ("
                    + firstLine(iClickError.getMessage()) + ") - finding the option again.");
            Map<String, Object> iAgain = pickOption(pPage, iPanelId, iIndex >= 0 ? "" : iText, iIndex, iToken, 1000, -1, false, 10000);
            if (iAgain == null || !Boolean.TRUE.equals(iAgain.get("found")))
            {
                throw new RuntimeException("MAT-SELECT | Option '" + iPicked + "' disappeared from " + iName + " before it could be clicked.", iClickError);
            }
            clickWithFallback(iTarget, "mat-option '" + iPicked + "'");
        }

        // STEP 5 : CLOSE + VERIFY (the panel is not read again after the click - it may already be gone)
        if (!iMultiple)
        {
            waitPanelClosed(iPanel);
        }

        String iShown = str(selectState(iSelect).get("value"));
        String iWant  = iIndex >= 0 ? iPicked : iText;
        if (iShown.toLowerCase(Locale.ROOT).contains(iWant.toLowerCase(Locale.ROOT)) || iMultiple)
        {
            log.info("[" + getCurrentTimestamp() + "] MAT-SELECT | " + iName + " = '" + iShown + "' ("
                    + (System.currentTimeMillis() - iStart) + " ms" + (iSearch ? ", searchable" : "") + ")");
            return;
        }

        throw new RuntimeException("MAT-SELECT | Option '" + iPicked + "' was clicked but " + iName + " shows '" + iShown + "'.");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : searchAndPick
    // Description   : Searchable dropdowns do not all filter the same way (whole label, name only, server-side).
    //                 Searches with the full text, then the name before " - ", then the code after it, then an empty box,
    //                 and stops at the first search that shows the option. A search that leaves the list unchanged
    //                 without the option for 1.5 s counts as "no match" and the next search is tried. With the empty box,
    //                 a full list without the option for 3 s fails the step straight away.
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Map<String, Object> searchAndPick(Page pPage, Locator pPanel, String pPanelId, String pText, String pToken)
    {
        Locator iSearchInput = pPanel.locator("css=input.mat-select-search-input:not(.mat-select-search-hidden)").first();

        List<String> iTerms = new ArrayList<>();
        iTerms.add(pText);
        int iDash = pText.indexOf(" - ");
        if (iDash > 0)
        {
            iTerms.add(pText.substring(0, iDash).trim());
            iTerms.add(pText.substring(iDash + 3).trim());
        }
        iTerms.add("");

        Map<String, Object> iLast = null;
        for (int i = 0; i < iTerms.size(); i++)
        {
            String  iTerm     = iTerms.get(i);
            boolean iLastTerm = i == iTerms.size() - 1;

            typeIntoSelectSearch(iSearchInput, iTerm);

            // 400 ms of an unchanged list after typing covers debounced filters; the last search waits the full timeout
            iLast = pickOption(pPage, pPanelId, pText, -1, pToken, SEARCH_SETTLE_MS,
                    iLastTerm ? LIST_NO_MATCH_MS : SEARCH_NO_MATCH_MS, !iLastTerm,
                    iLastTerm ? iListOptionTimeoutMs : Math.min(iListOptionTimeoutMs, 10000));
            if (iLast != null && Boolean.TRUE.equals(iLast.get("found")))
            {
                if (i > 0)
                {
                    log.info("[" + getCurrentTimestamp() + "] MAT-SELECT | '" + pText + "' found after searching '" + iTerm + "'");
                }
                return iLast;
            }
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | '" + pText + "' not shown after searching '" + iTerm + "'"
                    + (iLastTerm ? "." : " - trying the next search."));
        }
        return iLast;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : pickOption
    // Description   : One browser round trip. Polls the panel every 50 ms until the option list has not changed for
    //                 pSettleMs and a matching option exists, then marks it with data-pw-pick=<token>.
    //                 Match: exact text (case-insensitive, spaces ignored at both ends), else the ONLY option that contains
    //                 the text; or the option at pIndex when pIndex >= 0.
    //                 pNoMatchMs  : give up early when the list has not changed for this long (-1 = never)
    //                 pAllowEmpty : an empty list also counts as "no match" (true while searching - the filter may hide everything)
    // Returns       : {found:true, text} | {found:false, sample} (no match after pNoMatchMs of a stable list, or timeout)
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    private static Map<String, Object> pickOption(Page pPage, String pPanelId, String pText, int pIndex, String pToken,
                                                  int pSettleMs, int pNoMatchMs, boolean pAllowEmpty, double pTimeoutMs)
    {
        Map<String, Object> iArgs = mapOf("panelId", pPanelId, "text", pText, "index", pIndex, "token", pToken,
                "settleMs", pSettleMs, "noMatchMs", pNoMatchMs, "allowEmpty", pAllowEmpty, "ms", (long) pTimeoutMs);
        return asMap(pPage.evaluate(JS_PICK_OPTION, iArgs));
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : openMatSelect
    // Description   : Opens a mat-select. Waits (in the browser) while it is disabled, e.g. Townland until County has loaded.
    //                 Angular Material listens for the click on the inner .mat-mdc-select-trigger div.
    //                 Order: normal click on the trigger div, JavaScript click on it, Enter key on the mat-select.
    // Date Created  : 16-09-2026 | Updated: 16-09-2026 (in-browser waits)
    // ***************************************************************************************************************************************************************************************
    private static void openMatSelect(Locator pSelect, String pName, Map<String, Object> pState)
    {
        if (Boolean.TRUE.equals(pState.get("open")))
        {
            return;
        }

        if (Boolean.TRUE.equals(pState.get("disabled")))
        {
            log.info("[" + getCurrentTimestamp() + "] MAT-SELECT | " + pName + " is disabled - waiting for it to be enabled.");
            if (!waitSelect(pSelect, "enabled", (long) iActionTimeoutMs))
            {
                throw new RuntimeException("MAT-SELECT | " + pName + " is still disabled after " + (long) iActionTimeoutMs
                        + " ms. A dropdown it depends on (e.g. County for Townland) may not have been set.");
            }
        }

        Locator iTrigger = Boolean.TRUE.equals(pState.get("hasTrigger"))
                ? pSelect.locator("css=.mat-mdc-select-trigger, .mat-select-trigger").first()
                : pSelect;

        // 1. Normal click
        try
        {
            iTrigger.click(new Locator.ClickOptions().setTimeout(iClickAttemptTimeoutMs));
        }
        catch (PlaywrightException iClickError)
        {
            if (isPageClosed(iClickError)) { throw iClickError; }
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | Normal click did not reach " + pName + " : " + firstLine(iClickError.getMessage()));
        }
        if (waitSelect(pSelect, "open", 1500)) { return; }

        // 2. JavaScript click on the trigger div
        log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | " + pName + " did not open - retrying with JavaScript click on the trigger.");
        try
        {
            jsClick(iTrigger, pName + " trigger");
        }
        catch (PlaywrightException iJsError)
        {
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | JavaScript click failed : " + firstLine(iJsError.getMessage()));
        }
        if (waitSelect(pSelect, "open", 1500)) { return; }

        // 3. Keyboard
        log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | " + pName + " still closed - trying the Enter key.");
        try
        {
            pSelect.focus();
            pSelect.press("Enter");
        }
        catch (PlaywrightException iKeyError)
        {
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | Enter key failed : " + firstLine(iKeyError.getMessage()));
        }
        if (waitSelect(pSelect, "open", 1500)) { return; }

        throw new RuntimeException("MAT-SELECT | " + pName + " did not open (normal click, JavaScript click and Enter key all tried).");
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : typeIntoSelectSearch
    // Description   : Types into the ngx-mat-select-search box of an open panel.
    //                 The box sits inside <mat-option aria-disabled="true">; Playwright treats everything under an
    //                 aria-disabled ancestor as disabled, so fill() needs force=true (Selenium sendKeys ignored aria-disabled).
    //                 Fallback: set the value with JavaScript and fire the input event Angular listens to.
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void typeIntoSelectSearch(Locator pSearchInput, String pText)
    {
        try
        {
            pSearchInput.fill(pText, new Locator.FillOptions().setForce(true).setTimeout(3000));
            return;
        }
        catch (PlaywrightException iFillError)
        {
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | fill() on the search box failed, setting it with JavaScript : "
                    + firstLine(iFillError.getMessage()));
        }

        try
        {
            pSearchInput.evaluate(JS_SET_SEARCH_VALUE, pText, new Locator.EvaluateOptions().setTimeout(3000));
        }
        catch (PlaywrightException iJsError)
        {
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | Could not type into the search box, picking from the full list : "
                    + firstLine(iJsError.getMessage()));
        }
    }

    // Reads id, open, disabled, trigger presence and the displayed value in one call
    private static Map<String, Object> selectState(Locator pSelect)
    {
        Map<String, Object> iState = asMap(pSelect.evaluate(JS_SELECT_STATE));
        return iState == null ? new java.util.HashMap<>() : iState;
    }

    // Polls inside the browser every 50 ms (one round trip). pWant = "open" | "enabled"
    private static boolean waitSelect(Locator pSelect, String pWant, long pTimeoutMs)
    {
        try
        {
            return Boolean.TRUE.equals(pSelect.evaluate(JS_WAIT_SELECT, mapOf("want", pWant, "ms", pTimeoutMs)));
        }
        catch (PlaywrightException iError)
        {
            log.warning("[" + getCurrentTimestamp() + "] MAT-SELECT | State check failed : " + firstLine(iError.getMessage()));
            return false;
        }
    }

    private static void waitPanelClosed(Locator pPanel)
    {
        try
        {
            pPanel.waitFor(waitState(WaitForSelectorState.HIDDEN, 5000));
        }
        catch (Exception iIgnored)
        {
            log.fine("MAT-SELECT | Panel still open after selection (slow animation).");
        }
    }

    @SuppressWarnings("unchecked")
    private static Map<String, Object> asMap(Object pValue)
    {
        return pValue instanceof Map ? (Map<String, Object>) pValue : null;
    }

    private static String str(Object pValue)
    {
        return pValue == null ? "" : String.valueOf(pValue);
    }

    private static Map<String, Object> mapOf(Object... pKeyValues)
    {
        Map<String, Object> iMap = new java.util.LinkedHashMap<>();
        for (int i = 0; i + 1 < pKeyValues.length; i += 2)
        {
            iMap.put(String.valueOf(pKeyValues[i]), pKeyValues[i + 1]);
        }
        return iMap;
    }

    private static void performNativeSelect(Locator pLocator, String pListValue)
    {
        String       iUpperValue = pListValue.toUpperCase(Locale.ROOT);
        SelectOption iOption;

        if (iUpperValue.startsWith("VISIBLETEXT:"))
        {
            iOption = new SelectOption().setLabel(pListValue.substring("VISIBLETEXT:".length()).trim());
        }
        else if (iUpperValue.startsWith("VALUE:"))
        {
            iOption = new SelectOption().setValue(pListValue.substring("VALUE:".length()).trim());
        }
        else if (iUpperValue.startsWith("INDEX:"))
        {
            iOption = new SelectOption().setIndex(Integer.parseInt(pListValue.substring("INDEX:".length()).trim()));
        }
        else
        {
            iOption = new SelectOption().setLabel(pListValue);
        }

        pLocator.selectOption(iOption);
        log.info("[" + getCurrentTimestamp() + "] NATIVE SELECT | Selected: '" + pListValue + "'");
    }

    private static void performDragDrop(Locator pSource, String pValue)
    {
        if (pValue == null || pValue.trim().isEmpty())
        {
            throw new RuntimeException("DRAGDROP action requires target locator in format IDENTIFYBY:::LOCATORVALUE.");
        }

        String[] iTargetDetails = pValue.split(":::", 2);

        if (iTargetDetails.length != 2)
        {
            throw new RuntimeException("DRAGDROP value format is invalid. Expected: IDENTIFYBY:::LOCATORVALUE. Received: '" + pValue + "'");
        }

        Locator iTarget = getLocator(iTargetDetails[0].trim(), iTargetDetails[1].trim());

        waitVisible(pSource);
        waitVisible(iTarget);
        highlightElement(pSource);
        highlightElement(iTarget);
        pSource.dragTo(iTarget);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : performUploadFile
    // Description   : Sets files on an <input type=file>. Works on HIDDEN inputs - no JavaScript un-hiding needed.
    //                 Relative paths are resolved against the project root (user.dir), which is /app in the container.
    // Date Updated  : 15-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    private static void performUploadFile(Locator pLocator, String pValue)
    {
        if (pValue == null || pValue.trim().isEmpty())
        {
            throw new RuntimeException("UPLOADFILE action requires a file path.");
        }

        Path iPath = resolveFilePath(pValue);
        pLocator.waitFor(waitState(WaitForSelectorState.ATTACHED, iActionTimeoutMs));
        pLocator.setInputFiles(iPath);
    }

    public static Path resolveFilePath(String pValue)
    {
        Path iPath = Paths.get(pValue.trim().replace('\\', '/'));
        if (!iPath.isAbsolute())
        {
            iPath = Paths.get(System.getProperty("user.dir")).resolve(iPath);
        }

        if (!Files.exists(iPath))
        {
            throw new RuntimeException("Upload file not found : " + iPath
                    + " (paths are case-sensitive inside the Linux container)");
        }
        return iPath;
    }

    private static void performWaitVisible(Locator pLocator, String pObjectName)
    {
        try
        {
            pLocator.waitFor(waitState(WaitForSelectorState.VISIBLE, iWaitVisibleTimeoutMs));
            scrollIntoView(pLocator);
            highlightElement(pLocator);
        }
        catch (Exception iException)
        {
            throw new RuntimeException("WAITVISIBLE failed for locator: " + pObjectName + " | Reason: " + firstLine(iException.getMessage()), iException);
        }
    }

    private static Locator performWaitClickable(Page pPage, Locator pLocator, String pObjectName)
    {
        waitVisible(pLocator);

        long iDeadline = System.currentTimeMillis() + (long) iActionTimeoutMs;
        while (!pLocator.isEnabled())
        {
            if (System.currentTimeMillis() > iDeadline)
            {
                throw new RuntimeException("WAITCLICKABLE timed out. Element is still disabled : " + pObjectName);
            }
            sleepOnPage(pPage, iPollIntervalMs);
        }

        scrollIntoView(pLocator);
        return pLocator;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : performWaitInvisible
    // Description   : Waits until a spinner/overlay is gone. "Gone" means: not in DOM, aria-hidden=true, display:none,
    //                 visibility:hidden, opacity 0, or zero size. (Playwright's own HIDDEN state treats opacity 0 as
    //                 visible, so the MDC spinner needs this custom check - same rules as the Selenium version.)
    // Date Updated  : 15-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    private static void performWaitInvisible(Page pPage, String pSelector, String pObjectName)
    {
        String  iSelector = resolveSpinnerSelector(pSelector, pObjectName);
        Locator iAll      = pPage.locator(iSelector);
        long    iDeadline = System.currentTimeMillis() + (long) iActionTimeoutMs;

        log.info("[" + getCurrentTimestamp() + "] WAITINVISIBLE - watching locator : " + pObjectName);

        while (!isGone(iAll))
        {
            if (System.currentTimeMillis() > iDeadline)
            {
                throw new RuntimeException("WAITINVISIBLE timed out. Spinner still visible after " + (long) iActionTimeoutMs
                        + " ms | Locator: " + pObjectName);
            }
            sleepOnPage(pPage, iPollIntervalMs);
        }

        log.info("[" + getCurrentTimestamp() + "] WAITINVISIBLE - spinner dismissed successfully : " + pObjectName);
    }

    private static boolean isGone(Locator pAll)
    {
        try
        {
            if (pAll.count() == 0) { return true; }
            Object iHidden = pAll.first().evaluate(JS_IS_HIDDEN, null, new Locator.EvaluateOptions().setTimeout(2000));
            return Boolean.TRUE.equals(iHidden);
        }
        catch (PlaywrightException iException)
        {
            // Element detached between count() and evaluate() - poll again, the next count() will be 0
            return false;
        }
    }

    private static String resolveSpinnerSelector(String pSelector, String pObjectName)
    {
        if (pObjectName != null && (
                pObjectName.contains("mdc-circular-progress__gap-patch") ||
                pObjectName.contains("name()='circle'") ||
                pObjectName.contains("name()='svg'")))
        {
            log.info("[" + getCurrentTimestamp() + "] WAITINVISIBLE - SVG spinner locator detected. Watching parent .mdc-circular-progress container.");
            return "css=.mdc-circular-progress";
        }

        return pSelector;
    }

    private static void performScrollToElement(Locator pLocator)
    {
        waitVisible(pLocator);
        scrollIntoView(pLocator);
        highlightElement(pLocator);
    }

    private static String performGetText(Page pPage, Locator pLocator, String pObjectName)
    {
        waitVisible(pLocator);

        long   iDeadline = System.currentTimeMillis() + (long) iActionTimeoutMs;
        String iText     = readTextOrValue(pLocator);

        while (iText.isEmpty())
        {
            if (System.currentTimeMillis() > iDeadline)
            {
                throw new RuntimeException("GETTEXT timed out. Element has no text or value : " + pObjectName);
            }
            sleepOnPage(pPage, iPollIntervalMs);
            iText = readTextOrValue(pLocator);
        }

        scrollIntoView(pLocator);
        highlightElement(pLocator);
        log.info("[" + getCurrentTimestamp() + "] GETTEXT value captured : '" + iText + "'");
        return iText;
    }

    private static String performVerifyText(Locator pLocator, String pValue)
    {
        if (pValue == null)
        {
            throw new RuntimeException("VERIFYTEXT action requires an expected value.");
        }

        waitVisible(pLocator);
        scrollIntoView(pLocator);
        highlightElement(pLocator);

        String  iActualText = readTextOrValue(pLocator);
        String  iTrimmed    = pValue.trim();
        String  iUpper      = iTrimmed.toUpperCase(Locale.ROOT);
        String  iResolvedExpected;
        String  iMatchMode;
        boolean iVerificationPassed;

        if (iUpper.startsWith("EXACT:"))
        {
            iResolvedExpected   = iTrimmed.substring("EXACT:".length()).trim();
            iMatchMode          = "EXACT";
            iVerificationPassed = iActualText.equalsIgnoreCase(iResolvedExpected);
        }
        else if (iUpper.startsWith("STARTSWITH:"))
        {
            iResolvedExpected   = iTrimmed.substring("STARTSWITH:".length()).trim();
            iMatchMode          = "STARTSWITH";
            iVerificationPassed = iActualText.toLowerCase(Locale.ROOT).startsWith(iResolvedExpected.toLowerCase(Locale.ROOT));
        }
        else
        {
            iResolvedExpected   = iUpper.startsWith("CONTAINS:") ? iTrimmed.substring("CONTAINS:".length()).trim() : iTrimmed;
            iMatchMode          = "CONTAINS";
            iVerificationPassed = iActualText.toLowerCase(Locale.ROOT).contains(iResolvedExpected.toLowerCase(Locale.ROOT));
        }

        if (!iVerificationPassed)
        {
            throw new AssertionError("VERIFYTEXT failed [Mode=" + iMatchMode + "]"
                    + " | Expected : '" + iResolvedExpected + "'"
                    + " | Actual   : '" + iActualText + "'");
        }

        return iActualText;
    }

    private static void performVerifyElement(Locator pLocator, String pObjectName)
    {
        try
        {
            pLocator.waitFor(waitState(WaitForSelectorState.VISIBLE, iVerifyElementTimeoutMs));
        }
        catch (TimeoutError iTimeout)
        {
            throw new AssertionError("VERIFYELEMENT failed. Element not visible after " + (long) iVerifyElementTimeoutMs + " ms: " + pObjectName);
        }

        scrollIntoView(pLocator);
        highlightElement(pLocator);
    }

    private static void performCalendar(Locator pLocator, String pValue)
    {
        if (pValue == null || pValue.trim().isEmpty())
        {
            throw new RuntimeException("CALENDAR action requires a date value.");
        }

        waitVisible(pLocator);
        scrollIntoView(pLocator);
        highlightElement(pLocator);

        try
        {
            pLocator.fill("", new Locator.FillOptions().setTimeout(2000));
        }
        catch (Exception iIgnored)
        {
            log.fine("CALENDAR | fill('') not possible, falling back to keyboard clear.");
        }

        pLocator.click();
        pLocator.press("ControlOrMeta+A");
        pLocator.press("Delete");
        pLocator.pressSequentially(pValue, new Locator.PressSequentiallyOptions().setDelay(20));
        pLocator.press("Tab");
    }


