    private static final ThreadLocal<Playwright>     iPlaywrightHolder = new ThreadLocal<>();
    private static final ThreadLocal<Browser>        iBrowserHolder    = new ThreadLocal<>();
    private static final ThreadLocal<BrowserContext> iContextHolder    = new ThreadLocal<>();
    private static final ThreadLocal<Page>           iPageHolder       = new ThreadLocal<>();
    private static final ThreadLocal<Boolean>        iTracingHolder    = ThreadLocal.withInitial(() -> Boolean.FALSE);
    private static final ThreadLocal<Path>           iProfileHolder    = new ThreadLocal<>();
    private static final ThreadLocal<String>         iVersionHolder    = new ThreadLocal<>();
    private static final ThreadLocal<String>         iNextDialogAction = new ThreadLocal<>();
    private static final ThreadLocal<String>         iNextPromptText   = new ThreadLocal<>();
    private static final ThreadLocal<String>         iLastDialogText   = ThreadLocal.withInitial(() -> "");
    private static final ThreadLocal<Boolean>        iOpeningMainPage  = ThreadLocal.withInitial(() -> Boolean.FALSE);
    private static final ThreadLocal<List<Path>>     iDownloadsHolder  = ThreadLocal.withInitial(ArrayList::new);
    private static final ThreadLocal<String>         iStartedTypeHolder = new ThreadLocal<>();
    private static final ThreadLocal<Boolean>        iChunkOpenHolder   = ThreadLocal.withInitial(() -> Boolean.FALSE);
    private static final ThreadLocal<Boolean>        iReusedHolder      = ThreadLocal.withInitial(() -> Boolean.FALSE);

    // Set while the run is ending, so stop() really closes instead of keeping the browser for the next test case
    private static volatile boolean iShuttingDown = false;
    private static final ThreadLocal<Integer> iReuseCountHolder = ThreadLocal.withInitial(() -> 0);
    private static final java.util.concurrent.atomic.AtomicBoolean iShutdownHookAdded =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static final DateTimeFormatter iFileTimestamp = DateTimeFormatter.ofPattern("dd_MM_yyyy_HH_mm_ss");

    private PlaywrightFactory() {}

    // ***************************************************************************************************************************************************************************************
    // Function Name : start
    // Description   : Creates Playwright, launches the requested browser, opens an isolated context and a page.
    //                 Any graph already bound to this thread is closed first (safe re-entry per test case).
    // Parameters    : pBrowserType (String) - CHROME | CHROMIUM | EDGE | FIREFOX | WEBKIT
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 15-09-2026
    // ***************************************************************************************************************************************************************************************
    public static Page start(String pBrowserType)
    {
        String  iBrowserType = pBrowserType == null ? "CHROME" : pBrowserType.trim().toUpperCase(Locale.ROOT);

        // The whole run is one JVM, so the browser from the previous test case is still here. Reusing it saves the
        // 8-30 s Chrome start and the 10-14 s close; the test case still begins with a clean session (see resetSession).
        if (ConfigManager.getBool("browser.reuse", true) && canReuse(iBrowserType))
        {
            Page iReusedPage = resetSession();
            if (iReusedPage != null)
            {
                return iReusedPage;
            }
            log.warning("[PlaywrightFactory] The open browser could not be reused - starting a new one.");
        }

        if (iPageHolder.get() != null)
        {
            log.warning("[PlaywrightFactory] A browser is already open on this thread. Closing it before starting a new one.");
            boolean iWasShuttingDown = iShuttingDown;
            iShuttingDown = true;              // force a real close, not a keep-alive
            stop(false, "stale");
            iShuttingDown = iWasShuttingDown;
        }

        addShutdownHookOnce();
        boolean iHeadless    = ConfigManager.getBool("headless", false);
        boolean iMaximize    = !iHeadless && ConfigManager.getBool("browser.maximize", false);
        String  iChannel     = ConfigManager.getOrDefault("browser.channel", "");
        double  iSlowMo      = ConfigManager.getInt("playwright.slowmo.ms", 0);
        // Playwright starts Chromium with --no-sandbox unless told otherwise; installed Chrome then shows the
        // "unsupported command-line flag" banner. true on the laptop, false in Docker (the container runs as root).
        boolean iSandbox     = ConfigManager.getBool("browser.chromium.sandbox", false);

        // Clean start: stop leftover automation (or all) browser processes and old Playwright temp folders.
        // Replaces the Selenium killProcessByName("chrome") call. See utilities.BrowserProcessCleaner.
        utilities.BrowserProcessCleaner.cleanBeforeLaunch(iBrowserType, iChannel);

        // Installed Chrome/Edge (browser.channel) or an explicit flag means Playwright must not download its own
        // Chromium. The department web gateway blocks cdn.playwright.dev (HTTP 407), so this avoids a hard failure.
        java.util.Map<String, String> iDriverEnv = new java.util.HashMap<>(System.getenv());
        if (!iChannel.isEmpty() || "EDGE".equals(iBrowserType)
                || ConfigManager.getBool("playwright.skip.browser.download", false))
        {
            iDriverEnv.put("PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD", "1");
        }

        Playwright iPlaywright = Playwright.create(new Playwright.CreateOptions().setEnv(iDriverEnv));
        iPlaywrightHolder.set(iPlaywright);

        BrowserType.LaunchOptions iLaunch = new BrowserType.LaunchOptions()
                .setHeadless(iHeadless)
                .setSlowMo(iSlowMo)
                .setChromiumSandbox(iSandbox);

        String iProxyServer = ConfigManager.getOrDefault("browser.proxy.server", "");
        if (!iProxyServer.isEmpty())
        {
            iLaunch.setProxy(buildProxy(iProxyServer));
        }

        BrowserType iType;
        List<String> iArgs = new ArrayList<>();

        switch (iBrowserType)
        {
            case "CHROME":
            case "CHROMIUM":
                iType = iPlaywright.chromium();
                if (!iChannel.isEmpty()) { iLaunch.setChannel(iChannel); }
                // Containers often ship a tiny /dev/shm - this keeps Chromium stable even without --ipc=host
                iArgs.add("--disable-dev-shm-usage");
                if (iMaximize) { iArgs.add("--start-maximized"); }
                break;

            case "EDGE":
                // Edge is NOT inside the official Playwright image. Use locally or build a custom image.
                iType = iPlaywright.chromium();
                iLaunch.setChannel("msedge");
                if (iMaximize) { iArgs.add("--start-maximized"); }
                break;

            case "FIREFOX":
                iType = iPlaywright.firefox();
                break;

            case "WEBKIT":
            case "SAFARI":
                iType = iPlaywright.webkit();
                break;

            default:
                closeQuietly();
                throw new RuntimeException("Unsupported browser type : '" + pBrowserType
                        + "'. Supported values: CHROME, CHROMIUM, EDGE, FIREFOX, WEBKIT.");
        }

        // Chrome normally opens http:// links over https:// first (HTTPS-Upgrades). Playwright switches that off, so a
        // plain http:// link (the BISS Exit link) goes to port 80, which the department network blocks -> timeout.
        // Re-declaring Playwright's own --disable-features list without HttpsUpgrades restores normal Chrome behaviour
        // (Chrome uses the last --disable-features it is given).
        boolean iHttpsUpgrades = "chromium".equals(iType.name()) && ConfigManager.getBool("browser.https.upgrades", true);
        List<String> iIgnoredDefaults = new ArrayList<>();
        if (iHttpsUpgrades)
        {
            iIgnoredDefaults.add("--disable-features=" + String.join(",", PLAYWRIGHT_DISABLED_FEATURES));
            iArgs.add("--disable-features=" + String.join(",", withoutHttpsUpgrades()));
            iLaunch.setIgnoreDefaultArgs(iIgnoredDefaults);
        }

        if (!iArgs.isEmpty()) { iLaunch.setArgs(iArgs); }

        boolean iIgnoreHttps = ConfigManager.getBool("ignore.https.errors", false);
        String  iLocale      = ConfigManager.getOrDefault("browser.locale", "en-IE");
        String  iTimezone    = ConfigManager.getOrDefault("browser.timezone", "Europe/Dublin");
        int     iWidth       = ConfigManager.getInt("viewport.width", 1920);
        int     iHeight      = ConfigManager.getInt("viewport.height", 1080);
        int     iZoomPercent = ConfigManager.getInt("browser.zoom.percent", 100);
        boolean iChromium    = "chromium".equals(iType.name());
        boolean iZoomed      = iZoomPercent > 0 && iZoomPercent != 100;

        BrowserContext iContext;
        String         iZoomMode;

        if (iZoomed && iChromium)
        {
            // Chrome page zoom lives in the browser profile, so this path launches a persistent context on a fresh temporary profile
            Path iProfile = createZoomedProfile(iZoomPercent);
            iProfileHolder.set(iProfile);

            BrowserType.LaunchPersistentContextOptions iPersistent = new BrowserType.LaunchPersistentContextOptions()
                    .setHeadless(iHeadless)
                    .setSlowMo(iSlowMo)
                    .setChromiumSandbox(iSandbox)
                    .setIgnoreHTTPSErrors(iIgnoreHttps)
                    .setAcceptDownloads(true)
                    .setLocale(iLocale)
                    .setTimezoneId(iTimezone);

            String iPersistentChannel = "EDGE".equals(iBrowserType) ? "msedge" : iChannel;

            // Headless Chromium normally runs as the stripped-down 'headless shell', which ignores the zoom preference.
            // Channel 'chromium' runs the full Chromium build in new headless mode instead (it is inside the Docker image).
            if (iPersistentChannel.isEmpty() && iHeadless)
            {
                iPersistentChannel = "chromium";
            }
            if (!iPersistentChannel.isEmpty()) { iPersistent.setChannel(iPersistentChannel); }
            if (!iArgs.isEmpty())              { iPersistent.setArgs(iArgs); }
            if (!iIgnoredDefaults.isEmpty())   { iPersistent.setIgnoreDefaultArgs(iIgnoredDefaults); }
            if (!iProxyServer.isEmpty())       { iPersistent.setProxy(buildProxy(iProxyServer)); }

            if (iMaximize) { iPersistent.setViewportSize(null); }
            else           { iPersistent.setViewportSize(iWidth, iHeight); }

            iContext = iType.launchPersistentContext(iProfile, iPersistent);
            iBrowserHolder.set(iContext.browser());
            iZoomMode = iZoomPercent + "% (Chrome zoom preference)";
        }
        else
        {
            Browser iBrowser = iType.launch(iLaunch);
            iBrowserHolder.set(iBrowser);

            Browser.NewContextOptions iContextOptions = new Browser.NewContextOptions()
                    .setIgnoreHTTPSErrors(iIgnoreHttps)
                    .setAcceptDownloads(true)
                    .setLocale(iLocale)
                    .setTimezoneId(iTimezone);

            if (iMaximize) { iContextOptions.setViewportSize(null); }
            else           { iContextOptions.setViewportSize(iWidth, iHeight); }

            iContext = iBrowser.newContext(iContextOptions);

            if (iZoomed)
            {
                // Firefox / WebKit have no zoom preference Playwright can set - scale the page root with CSS instead
                iContext.addInitScript(String.format(Locale.ROOT, JS_ROOT_ZOOM, iZoomPercent));
                iZoomMode = iZoomPercent + "% (CSS zoom)";
            }
            else
            {
                iZoomMode = "100%";
            }
        }

        iContext.setDefaultTimeout(ConfigManager.getInt("explicit.wait.seconds", 30) * 1000d);
        iContext.setDefaultNavigationTimeout(ConfigManager.getInt("page.load.timeout.seconds", 60) * 1000d);
        iContextHolder.set(iContext);

        startTracingIfEnabled(iContext);
        attachBrowserListeners(iContext);
        attachHttpsUpgradeRoutes(iContext);

        // A persistent context opens with one blank tab already - reuse it instead of leaving it behind
        boolean iReuseFirstTab = !iContext.pages().isEmpty();
        Page    iPage;
        if (iReuseFirstTab)
        {
            iPage = iContext.pages().get(0);
            attachPageListeners(iPage, "main");
        }
        else
        {
            // newPage() raises the context 'page' event - the flag tells that listener this is the main tab, not a pop-up
            iOpeningMainPage.set(Boolean.TRUE);
            try     { iPage = iContext.newPage(); }
            finally { iOpeningMainPage.set(Boolean.FALSE); }
        }
        iPageHolder.set(iPage);

        Browser iActiveBrowser = iBrowserHolder.get();
        String  iEffectiveChannel = "EDGE".equals(iBrowserType) ? "msedge" : iChannel;
        String  iProductName;
        switch (iEffectiveChannel.toLowerCase(Locale.ROOT))
        {
            case "chrome": case "chrome-beta": case "chrome-dev": case "chrome-canary":
                iProductName = "Google Chrome (installed)";
                break;
            case "msedge": case "msedge-beta": case "msedge-dev": case "msedge-canary":
                iProductName = "Microsoft Edge (installed)";
                break;
            default:
                // Playwright names the Chrome engine 'chromium' even for Google Chrome, so name the product explicitly
                iProductName = "chromium".equals(iType.name()) ? "Chromium (Playwright bundled)" : iType.name();
        }
        iVersionHolder.set(iProductName + " " + (iActiveBrowser != null ? iActiveBrowser.version() : readUserAgentVersion(iPage)));

        iStartedTypeHolder.set(iBrowserType);

        log.info("[PlaywrightFactory] Started | Browser=" + iBrowserType
                + (iChannel.isEmpty() ? "" : " | Channel=" + iChannel)
                + " | Version=" + iVersionHolder.get()
                + " | Headless=" + iHeadless
                + " | Zoom=" + iZoomMode
                + " | HttpsUpgrades=" + (iHttpsUpgrades ? "on" : "off")
                + " | TraceMode=" + traceMode());

        return iPage;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : attachBrowserListeners
    // Description   : Registers context-wide listeners:
    //                   - dialogs  : 'Leave site?' (beforeunload) is accepted like Selenium; alert / confirm / prompt follow
    //                                dialog.default.action unless UiHelpers.acceptNextDialog / dismissNextDialog said otherwise.
    //                                Every dialog is logged with its text.
    //                   - log.browser.events=true : new tabs, main-page changes, failed page/API requests and HTTP 4xx/5xx
    //                     responses are written to the run log with the [BROWSER] prefix. This shows why a page did not
    //                     load (blocked request, certificate, proxy, server error, a link that opened a new tab ...).
    // Parameters    : pContext (BrowserContext) - the context just created
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void attachBrowserListeners(BrowserContext pContext)
    {
        pContext.onDialog(PlaywrightFactory::handleDialog);

        // Downloads are always captured, whatever log.browser.events says - the file itself is the test evidence
        pContext.onPage(iNewPage ->
        {
            attachPageListeners(iNewPage, Boolean.TRUE.equals(iOpeningMainPage.get()) ? "main" : "tab");

            if (ConfigManager.getBool("log.browser.events", true) && !Boolean.TRUE.equals(iOpeningMainPage.get()))
            {
                log.warning("[BROWSER] New tab/window opened : " + safeUrl(iNewPage)
                        + " | The test keeps working on the current tab - use UiHelpers.clickAndSwitchToNewTab(...) to follow it.");
            }
        });

        if (!ConfigManager.getBool("log.browser.events", true))
        {
            return;
        }

        pContext.onRequestFailed(iRequest ->
        {
            String iType    = iRequest.resourceType();
            String iFailure = iRequest.failure() == null ? "unknown error" : iRequest.failure();
            boolean iPage   = "document".equals(iType);
            boolean iApi    = "xhr".equals(iType) || "fetch".equals(iType);

            // Aborted API calls are normal while a page is being left - only aborted page loads matter
            if (iPage || (iApi && !iFailure.contains("ERR_ABORTED")))
            {
                log.warning("[BROWSER] " + (iPage ? "Page load" : "API call") + " failed : " + describe(iRequest) + " | " + iFailure);
            }
        });

        pContext.onResponse(iResponse ->
        {
            if (iResponse.status() < 400) { return; }
            String iType = iResponse.request().resourceType();
            if ("document".equals(iType) || "xhr".equals(iType) || "fetch".equals(iType))
            {
                log.warning("[BROWSER] HTTP " + iResponse.status() + " : " + describe(iResponse.request()));
            }
        });

        if (ConfigManager.getBool("log.browser.console.errors", true))
        {
            pContext.onConsoleMessage(iMessage ->
            {
                // 'Failed to load resource' repeats what the request / HTTP listeners above already log
                if ("error".equals(iMessage.type()) && !String.valueOf(iMessage.text()).startsWith("Failed to load resource"))
                {
                    log.warning("[BROWSER] Console error : " + shorten(iMessage.text(), 300));
                }
            });
        }
    }

    private static void attachPageListeners(Page pPage, String pLabel)
    {
        // Every file this page downloads is copied into report.downloads.path (see saveDownload)
        pPage.onDownload(PlaywrightFactory::saveDownload);

        if (!ConfigManager.getBool("log.browser.events", true)) { return; }

        pPage.onFrameNavigated(iFrame ->
        {
            if (iFrame.parentFrame() == null)
            {
                log.info("[BROWSER] Page changed (" + pLabel + ") : " + shorten(iFrame.url(), 200));
            }
        });
    }

    private static void handleDialog(Dialog pDialog)
    {
        String iType    = pDialog.type();
        String iMessage = pDialog.message() == null ? "" : pDialog.message();
        iLastDialogText.set(iMessage);

        String iAction = "beforeunload".equals(iType)
                ? "accept"
                : (iNextDialogAction.get() != null ? iNextDialogAction.get()
                                                   : ConfigManager.getOrDefault("dialog.default.action", "accept").trim().toLowerCase(Locale.ROOT));
        String iPromptText = iNextPromptText.get();
        iNextDialogAction.remove();
        iNextPromptText.remove();

        log.info("[BROWSER] Dialog (" + iType + ") '" + shorten(iMessage, 200) + "' -> " + iAction);

        try
        {
            if ("dismiss".equals(iAction))       { pDialog.dismiss(); }
            else if (iPromptText != null)        { pDialog.accept(iPromptText); }
            else                                 { pDialog.accept(); }
        }
        catch (Exception iException)
        {
            log.warning("[BROWSER] Dialog could not be handled : " + iException.getMessage());
        }
    }

    // Used by UiHelpers.acceptNextDialog / dismissNextDialog - applies to the next alert / confirm / prompt only
    static void setNextDialogAction(String pAction, String pPromptText)
    {
        iNextDialogAction.set(pAction);
        if (pPromptText == null) { iNextPromptText.remove(); } else { iNextPromptText.set(pPromptText); }
    }

    public static String getLastDialogText()
    {
        return iLastDialogText.get();
    }

    private static String describe(Request pRequest)
    {
        return pRequest.method() + " " + shorten(pRequest.url(), 200);
    }

    private static String safeUrl(Page pPage)
    {
        try { return shorten(pPage.url(), 200); } catch (Exception iException) { return "(loading)"; }
    }

    private static String shorten(String pText, int pMax)
    {
        if (pText == null) { return ""; }
        String iOneLine = pText.replaceAll("\\s+", " ").trim();
        return iOneLine.length() <= pMax ? iOneLine : iOneLine.substring(0, pMax) + "...";
    }

    // Playwright 1.61 default '--disable-features' list (coreBundle.js chromiumSwitches). Only HttpsUpgrades is removed
    // from it here; the rest is kept so the browser behaves exactly as Playwright expects.
    private static final List<String> PLAYWRIGHT_DISABLED_FEATURES = java.util.Arrays.asList(
            "AvoidUnnecessaryBeforeUnloadCheckSync", "BoundaryEventDispatchTracksNodeRemoval", "DestroyProfileOnBrowserClose",
            "DialMediaRouteProvider", "GlobalMediaControls", "HttpsUpgrades", "LensOverlay", "MediaRouter", "PaintHolding",
            "ThirdPartyStoragePartitioning", "Translate", "AutoDeElevate", "RenderDocument", "OptimizationHints",
            "msForceBrowserSignIn", "msEdgeUpdateLaunchServicesPreferredVersion");

    private static List<String> withoutHttpsUpgrades()
    {
        List<String> iFeatures = new ArrayList<>(PLAYWRIGHT_DISABLED_FEATURES);
        iFeatures.remove("HttpsUpgrades");
        return iFeatures;
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : attachHttpsUpgradeRoutes
    // Description   : Optional, host-specific safety net: every http:// request to a host in browser.https.upgrade.hosts
    //                 is answered with a 307 redirect to the same address on https://. Use it only if a host still
    //                 times out on http:// with browser.https.upgrades=true. Entries may start with *. for sub-domains.
    //                 Note: while any route is active Playwright turns the browser HTTP cache off for this context.
    // Parameters    : pContext (BrowserContext)
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 16-09-2026
    // ***************************************************************************************************************************************************************************************
    private static void attachHttpsUpgradeRoutes(BrowserContext pContext)
    {
        String iHostList = ConfigManager.getOrDefault("browser.https.upgrade.hosts", "").trim();
        if (iHostList.isEmpty()) { return; }

        List<String> iHosts = new ArrayList<>();
        for (String iHost : iHostList.split(","))
        {
            if (!iHost.isBlank()) { iHosts.add(iHost.trim().toLowerCase(Locale.ROOT)); }
        }

        pContext.route(iUrl -> isUpgradeHost(iUrl, iHosts), iRoute ->
        {
            String iFrom = iRoute.request().url();
            String iTo   = "https" + iFrom.substring(iFrom.indexOf(':'));
            log.info("[BROWSER] http -> https : " + shorten(iFrom, 200));
            iRoute.fulfill(new Route.FulfillOptions()
                    .setStatus(307)
                    .setHeaders(java.util.Collections.singletonMap("Location", iTo)));
        });
        log.info("[PlaywrightFactory] http:// is redirected to https:// for : " + iHosts);
    }

    private static boolean isUpgradeHost(String pUrl, List<String> pHosts)
    {
        if (pUrl == null || !pUrl.regionMatches(true, 0, "http://", 0, 7)) { return false; }
        try
        {
            String iHost = java.net.URI.create(pUrl).getHost();
            if (iHost == null) { return false; }
            iHost = iHost.toLowerCase(Locale.ROOT);
            for (String iRule : pHosts)
            {
                if (iRule.startsWith("*.") ? iHost.endsWith(iRule.substring(1)) : iHost.equals(iRule)) { return true; }
            }
        }
        catch (Exception iIgnored)
        {
            // Not a parseable URL - leave the request alone
        }
        return false;
    }

