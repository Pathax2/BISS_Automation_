# ------------------------------------------------ ETF Authorisation (TC_14_ENTS) ------------------------------------------------

# Allow Entitlement Transfer Facilitators - the <br> splits the label, so both halves are matched separately
iAllowEntitlementBtn                = //button[contains(@class,'nav-button') and contains(normalize-space(.),'Allow Entitlement') and contains(normalize-space(.),'Transfer Facilitators')]

# Add ETF Authorisation - opens the etf-add-dialog
iAddETFAuthorisationBtn             = //button[.//span[contains(@class,'mdc-button__label') and normalize-space()='Add ETF Authorisation']]

# Select one ETF - mat-select, the LIST action opens it and picks the option by its text
iETFAvailableDropdown               = //mat-dialog-container//mat-select[@formcontrolname='etfAvailable']

# Transfer Ents Out / Transfer Ents In - number inputs; scoped to any dialog so the Edit dialog can reuse them
iTxorEntsAllowedField               = //mat-dialog-container//input[@formcontrolname='txorEntsAllowed']
iTxeeEntsAllowedField               = //mat-dialog-container//input[@formcontrolname='txeeEntsAllowed']

# Add Entitlements Transfer Facilitator Authorisation - the submit button of the add dialog (Cancel is type=button)
iAddETFAuthorisationConfirmBtn      = //etf-add-dialog//mat-dialog-actions//button[@type='submit']

# ---- NOT VERIFIED: guesses so requireKeys passes on the dry run. Replace with the real table DOM afterwards ----
iETF00009TableRow                   = //tr[td[contains(normalize-space(.),'ETF00009')]]
iETF00009DeleteBtn                  = //tr[td[contains(normalize-space(.),'ETF00009')]]//button[contains(normalize-space(.),'Delete') or .//mat-icon[normalize-space()='delete']]
iRemoveETABtn                       = //mat-dialog-container//button[contains(normalize-space(.),'Remove')]
iETF00009EditBtn                    = //tr[td[contains(normalize-space(.),'ETF00009')]]//button[contains(normalize-space(.),'Edit') or .//mat-icon[normalize-space()='edit']]
UpdateETABtn                        = //mat-dialog-container//button[contains(normalize-space(.),'Update')]
