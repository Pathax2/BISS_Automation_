    @When("the staff user cancels a Force Majeure request for the same submitted herd across the following years")
    public void theStaffUserCancelsAForceMajeureRequestAcrossTheFollowingYears(DataTable pYears)
    {
        log.info("[STEP] the staff user cancels a Force Majeure request for the same submitted herd across the following years");
        List<String> iYears = pYears.asList();

        if (iCurrentHerd == null && !iYears.isEmpty())
        {
            iCurrentHerd = iNextSubmittedHerd(iYears.get(0));
        }

        for (String iYear : iYears)
        {
            iSearchHomeByHerd(iCurrentHerd, iYear);
            iOpenFirstApplication();
            iAction("CLICK", "XPATH", ObjReader.getLocator("iForceMajeureInput"), null);
            iAction("CLICK", "XPATH", ObjReader.getLocator("iDialogButton").replace("{LABEL}", "Cancel"), null);
        }
    }

