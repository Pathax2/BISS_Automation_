    // One herd returned by an ENTS query
    public static final class Herd
    {
        public final String herdNumber;
        public final String name;
        public final String address;

        Herd(String pHerdNumber, String pName, String pAddress)
        {
            herdNumber = pHerdNumber;
            name       = pName;
            address    = pAddress;
        }

        @Override
        public String toString() { return herdNumber + " (" + name + ")"; }
    }

    // The herds used by one transfer section
    public static final class TransferPair
    {
        public final String agent;            // login that creates the transfer: the agent, or the individual's own login
        public final Herd   transferor;
        public final Herd   transferee;       // null until the create step completes a two-half pair (individual transferor)
        public final String transfereeAgent;  // who accepts: agent of the transferee herd (same as agent unless
        // cross-agent), or the individual's own login (agent-to-individual)

        TransferPair(String pAgent, Herd pTransferor, Herd pTransferee)
        {
            this(pAgent, pTransferor, pTransferee, pAgent);
        }

        TransferPair(String pAgent, Herd pTransferor, Herd pTransferee, String pTransfereeAgent)
        {
            agent           = pAgent;
            transferor      = pTransferor;
            transferee      = pTransferee;
            transfereeAgent = (pTransfereeAgent == null || pTransfereeAgent.isBlank()) ? pAgent : pTransfereeAgent.trim();
        }

        public boolean isCrossAgent()
        {
            return !agent.equalsIgnoreCase(transfereeAgent);
        }
    }

