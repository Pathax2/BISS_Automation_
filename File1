SELECT app_herd_no
FROM (
    SELECT app_herd_no
    FROM (
        SELECT DISTINCT curr.app_herd_no
        FROM vwbs_application curr
        WHERE mde_abbrev              = 'RI'
        AND   curr.app_applicant_type = 'I'
        AND   curr.app_year           = 2026
        AND   REGEXP_LIKE(curr.app_herd_no, '^[A-Z]')
        AND   EXISTS (
                SELECT 1
                FROM tdbs_application_land x
                WHERE x.apl_year        = curr.app_year
                AND   x.apl_app_id      = curr.app_id
                AND   x.apl_deleted_ind = 'N'
              )
        AND   NOT EXISTS (
                SELECT 1
                FROM vwbs_application started
                WHERE started.app_year     = curr.app_year
                AND   started.app_herd_no  = curr.app_herd_no
                AND   started.app_mde_code IN (3, 4, 6, 8)
              )
        AND   EXISTS (
                SELECT 1
                FROM vwbs_application prev, vwbs_application_flag_schemes sch
                WHERE prev.app_id      = sch.app_id
                AND   prev.app_herd_no = curr.app_herd_no
                AND   prev.app_year    = 2025
                AND   cisyf_ind IS NOT NULL
              )
    )
    ORDER BY DBMS_RANDOM.VALUE
)
WHERE ROWNUM <= 50;
