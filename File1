    // Herd typed in the feature file -> herd used instead, when the typed herd is not in the Transfer Out list (06-11-2026).
    // transferOutAllRowsXpath reads it, so activeTransferOutRows, transferOutName and clickTransferOutView follow the
    // replacement without any change. Only filled for test cases listed in ents.transferout.first.row.testcases.
    private static final java.util.Map<String, String> HERD_REPLACED = new java.util.HashMap<>();

    // The herd really used for pHerd (pHerd itself when it was not replaced)
    static String replacedHerd(String pHerd)
    {
        return HERD_REPLACED.getOrDefault(pHerd, pHerd);
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : transferOutAllRowsXpath
    // Description   : XPath of EVERY Transfer Out row of one herd, expired or not: rows whose Herd No. cell is exactly
    //                 the herd and that have a View link.
    //                 One herd can have several rows, one per holder. Seen 22-09-2026 for D3990193: "Thomas Morris"
    //                 (Expired icon shown) and "Jean Doolaghty" (not expired). Both rows hold the same herd number.
    //                 06-11-2026: uses the replacement herd when searchTransferOut replaced pHerd.
    // Parameters    : pHerd (String) - herd number
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026 | Updated: 06-11-2026 (replaced herd)
    // ***************************************************************************************************************************************************************************************
    static String transferOutAllRowsXpath(String pHerd)
    {
        return "//tr[." + VIEW_LINK_XPATH + "]"
                + "[.//td[contains(@class,'mat-column-herdNo')][normalize-space()='" + replacedHerd(pHerd) + "']]";
    }

    // ***************************************************************************************************************************************************************************************
    // Function Name : searchTransferOut
    // Description   : Types the herd in the Transfer Out search box, clicks Search and waits until a row for THAT herd
    //                 is shown (up to ents.search.seconds). Returns false when it never appears.
    //                 Then goes through every row of the herd and logs Name + Expired for each, so the log shows which
    //                 row will be used. Expired rows are not rejected here - see activeTransferOutRows.
    //                 06-11-2026 (TC_11_ENTS, fixed herds gone after the environment refresh): when the herd is not
    //                 found and the test case is listed in ents.transferout.first.row.testcases, the search box is
    //                 emptied, the first NOT-expired herd of the full list is taken (TRN rows skipped) and searched
    //                 instead. The replacement is remembered (HERD_REPLACED), so the View click, the name and later
    //                 searches of the same feature herd use it. Every other test case: unchanged.
    // Parameters    : pHerd (String) - herd number
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026 | Updated: 22-09-2026 (logs every row), 06-11-2026 (first-row fallback)
    // ***************************************************************************************************************************************************************************************
    static boolean searchTransferOut(String pHerd)
    {
        int iSeconds = ConfigManager.getInt("ents.search.seconds", 8);

        iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iTransfersHerdSearchField"), replacedHerd(pHerd));
        iAction("CLICK",   "XPATH", ObjReader.getLocator("iTransfersSearchBtn"), null);

        if (!isVisible(transferOutAllRowsXpath(pHerd), iSeconds))
        {
            if (!firstRowFallbackOn())
            {
                return false;
            }

            // Blank search - every herd of the login
            log.warning("[TRANSFER] " + replacedHerd(pHerd) + " is not in the Transfer Out list of " + EntsTestData.loggedInUser()
                    + " - blank search to take the first herd of the list.");
            xp(ObjReader.getLocator("iTransfersHerdSearchField")).first().fill("");
            iAction("CLICK", "XPATH", ObjReader.getLocator("iTransfersSearchBtn"), null);

            // First NOT-expired row whose herd starts with a letter (TRN rows start with a digit)
            String iUsableRows = "//tr[." + VIEW_LINK_XPATH + "][not(." + EXPIRED_CELL_XPATH + "//mat-icon)]";
            if (!isVisible(iUsableRows, iSeconds))
            {
                log.warning("[TRANSFER] The blank search shows no usable row either (0 of 0, or every row expired).");
                return false;
            }
            String iNewHerd = null;
            for (Locator iRow : xp(iUsableRows).all())
            {
                String iCell = iRow.locator("xpath=.//td[contains(@class,'mat-column-herdNo')]").first().innerText().trim();
                if (iCell.matches("^[A-Z].*"))
                {
                    iNewHerd = iCell;
                    break;
                }
            }
            if (iNewHerd == null)
            {
                log.warning("[TRANSFER] The first page of the list has only TRN rows - no herd to use instead of " + pHerd + ".");
                return false;
            }

            HERD_REPLACED.put(pHerd, iNewHerd);
            log.warning("[TRANSFER] Using " + iNewHerd + " (first herd of the Transfer Out list) instead of " + pHerd + ".");

            // Search again with the new herd, so only its row is on screen
            iAction("TEXTBOX", "XPATH", ObjReader.getLocator("iTransfersHerdSearchField"), iNewHerd);
            iAction("CLICK",   "XPATH", ObjReader.getLocator("iTransfersSearchBtn"), null);
            if (!isVisible(transferOutAllRowsXpath(pHerd), iSeconds))
            {
                return false;
            }
        }

        List<Locator> iRows = xp(transferOutAllRowsXpath(pHerd)).all();
        for (int i = 0; i < iRows.size(); i++)
        {
            Locator iRow     = iRows.get(i);
            boolean iExpired = iRow.locator("xpath=." + EXPIRED_CELL_XPATH + "//mat-icon").count() > 0;
            String  iName    = "";
            try
            {
                iName = iRow.locator("xpath=." + NAME_CELL_XPATH).first().innerText().trim().replaceAll("\\s+", " ");
            }
            catch (Exception iEx)
            {
                iName = "?";
            }
            log.info("[TRANSFER] " + replacedHerd(pHerd) + " row " + (i + 1) + "/" + iRows.size() + ": Name='" + iName + "' | "
                    + (iExpired ? "EXPIRED - skipped" : "not expired"));
        }
        return true;
    }

    // True when the running test case (System property "testcase") is listed in ents.transferout.first.row.testcases
    // (comma separated, default TC_11_ENTS). Keeps the first-row fallback away from every other test case.
    private static boolean firstRowFallbackOn()
    {
        String iTestCase = System.getProperty("testcase", "").trim();
        for (String iId : ConfigManager.getOrDefault("ents.transferout.first.row.testcases", "TC_11_ENTS").split(","))
        {
            if (!iId.trim().isEmpty() && iId.trim().equalsIgnoreCase(iTestCase)) return true;
        }
        return false;
    }
