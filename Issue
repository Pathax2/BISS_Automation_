    // ***************************************************************************************************************************************************************************************
    // Function Name : launchBrowser
    // Description   : Starts Playwright for the requested browser (via PlaywrightFactory) and navigates to the URL.
    //                 Signature unchanged from the Selenium version so Hooks and TestRunner behave the same.
    // Parameters    : pBrowserType (String) - CHROME | CHROMIUM | EDGE | FIREFOX | WEBKIT
    //                 pUrl         (String) - application URL to navigate to
    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 10-03-2026 | Updated: 15-09-2026 (Playwright)
    // ***************************************************************************************************************************************************************************************
    public static void launchBrowser(String pBrowserType, String pUrl)
    {
        try
        {
            if (pBrowserType == null || pBrowserType.trim().isEmpty())
            {
                throw new RuntimeException("Browser type cannot be blank. Supported values: CHROME, CHROMIUM, EDGE, FIREFOX, WEBKIT.");
            }

            if (pUrl == null || pUrl.trim().isEmpty())
            {
                throw new RuntimeException("URL cannot be blank.");
            }

            Page iPage = PlaywrightFactory.start(pBrowserType);

            // Optional replacement for the old per-action document.body.style.zoom='84%' hack.
            // Off by default (100). A fixed 1920x1080 viewport normally makes zoom unnecessary.
            if (iCssZoomPercent > 0 && iCssZoomPercent != 100)
            {
                String iZoom = iCssZoomPercent + "%";
                PlaywrightFactory.getContext().addInitScript("(" + JS_CSS_ZOOM + ")('" + iZoom + "')");
                log.info("[" + getCurrentTimestamp() + "] CSS zoom applied to every page : " + iZoom);
            }

            iPage.navigate(pUrl.trim());

            log.info("[" + getCurrentTimestamp() + "] Browser launched successfully | Browser=" + pBrowserType.toUpperCase(Locale.ROOT)
                    + " | " + PlaywrightFactory.getBrowserVersion() + " | URL=" + pUrl);
        }
        catch (Exception iException)
        {
            PlaywrightFactory.stop(true, "launch_failure");
            throw new RuntimeException("Browser launch failed for browser [" + pBrowserType + "] : " + iException.getMessage(), iException);
        }
    }

