SELECT vr.herd_id, vr.herd_ols_login, vr.cust_type, vr.start_date
FROM   vwco_ents_herd_abls_rpt vr
WHERE  vr.herd_id = 'T1973669'
ORDER  BY vr.start_date DESC;

SELECT t.herd_number, t.payee_name, t.death_indicator, t.start_date
FROM   vwco_ems_client_details t
WHERE  t.herd_number = 'T1973669'
ORDER  BY t.start_date DESC;
