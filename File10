    {
        log.info("[STEP] the staff user applies and removes Force Majeure for the same submitted herd across the following years");
        List<Map<String, String>> iYearRows = pRows.asMaps(String.class, String.class);

        if (iCurrentHerd == null && !iYearRows.isEmpty())
        {
            iCurrentHerd = iNextSubmittedHerd(iYearRows.get(0).get("year"));
