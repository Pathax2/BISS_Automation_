    // Author        : Aniket Pathare | aniket.pathare@goverment.ie
    // Date Created  : 10-03-2026 | Updated: 15-09-2026 (Playwright + trace)
    // ***************************************************************************************************************************************************************************************
    public static String closeBrowser(boolean pTestFailed, String pTestCaseID)
    {
        if (PlaywrightFactory.getPage() == null)
        {
            log.warning("[" + getCurrentTimestamp() + "] closeBrowser called but no active page found on this thread.");
            return "";
        }

        String iTrace = PlaywrightFactory.stop(pTestFailed, pTestCaseID);
        log.info("[" + getCurrentTimestamp() + "] Browser closed successfully.");
        return iTrace;
    }

