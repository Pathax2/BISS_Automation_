    // ***************************************************************************************************************************************************************************************
    // Function Name : clickTransferOutView
    // Description   : Clicks View in the first NOT-expired row of the herd (the list must already show it)
    // Parameters    : pHerd (String) - herd number
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 22-09-2026
    // ***************************************************************************************************************************************************************************************
    static void clickTransferOutView(String pHerd)
    {
        if (activeTransferOutRows(pHerd) == 0)
        {
            throw new IllegalStateException("[TRANSFER] Every Transfer Out row of herd " + pHerd + " is marked expired - nothing to open.");
        }
        iAction("CLICK", "XPATH", "(" + transferOutRowXpath(pHerd) + VIEW_LINK_XPATH + ")[1]", null);
        log.info("[TRANSFER] Opened herd " + pHerd + " ('" + transferOutName(pHerd) + "' row) from Transfer Out.");
    }



