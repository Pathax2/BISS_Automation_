    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 15-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Then("the SIM tick state should be readable on the BISS Application summary")
    public void theSimTickStateShouldBeReadableOnTheBissApplicationSummary()
    {
        log.info("[STEP] the SIM tick state should be readable on the BISS Application summary");
