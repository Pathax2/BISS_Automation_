    // ---------------------------------------------------------------------------------------------------------------------------------
    // Hook          : readPoolSizeTags
    // Description   : Passes the scenario tags (feature tags included) to StaffTestData, so the Selenium size tags
    //                 such as @parcels:10 or @herds:10:submitted still decide how many rows a pool loads.
    //                 Only reads tags - no database access, no browser - so it costs nothing on other scenarios.
    // Author        : Aniket Pathare | aniket.pathare@government.ie
    // Date Created  : 05-10-2026
    // ---------------------------------------------------------------------------------------------------------------------------------
    @Before
    public void readPoolSizeTags(Scenario pScenario)
    {
